<div class="row justify-content-center my-md-3">
  <div class="col-xl-10 col-xxl-9">
    <div class="card auth-card">
      <div class="row g-0">
        <%- include('../partials/auth-side', { img: '/img/vaytiec/v3.jpg', heading: 'Chào mừng bạn quay lại' }) %>

        <div class="col-md-7">
          <div class="auth-form">
            <div class="mb-4">
              <h2 class="font-serif mb-1" style="color:var(--primary)">Đăng nhập</h2>
              <p class="text-muted mb-0">Đăng nhập để đặt thuê, theo dõi đơn và nhận thông báo.</p>
            </div>
            <% if (returnTo && returnTo !== '/') { %><div class="alert alert-light border small py-2"><i class="bi bi-info-circle text-primary"></i> Đăng nhập xong bạn sẽ quay lại trang trước đó.</div><% } %>
            <form method="POST" action="/login">
              <input type="hidden" name="returnTo" value="<%= returnTo %>">
              <div class="mb-3">
                <label class="form-label small text-muted">Tên đăng nhập</label>
                <input name="username" id="u" class="form-control form-control-lg" required autofocus autocomplete="username">
              </div>
              <div class="mb-4">
                <label class="form-label small text-muted">Mật khẩu</label>
                <input type="password" name="password" id="p" class="form-control form-control-lg" required autocomplete="current-password">
              </div>
              <div class="text-end mb-3" style="margin-top:-1rem"><a href="/quen-mat-khau" class="small">Quên mật khẩu?</a></div>
              <button class="btn btn-primary btn-lg w-100">Đăng nhập</button>
            </form>
            <p class="text-center mt-3 mb-0">Chưa có tài khoản? <a href="/register?next=<%= encodeURIComponent(returnTo) %>" class="fw-semibold" style="color:var(--primary)">Đăng ký ngay</a></p>

            <% if (SHOW_DEMO_ACCOUNTS) { %>
            <!-- Tài khoản test: chỉ hiện khi SHOW_DEMO_ACCOUNTS=true -->
            <div class="mt-4 pt-3 border-top">
              <p class="small text-muted mb-2"><i class="bi bi-key"></i> Tài khoản test — bấm để điền nhanh:</p>
              <div class="row g-2">
                <div class="col-sm-4">
                  <button type="button" class="btn btn-light border text-start w-100 h-100 quickfill" data-u="admin" data-p="admin123">
                    <span class="badge bg-danger">Admin</span><code class="d-block small mt-1">admin / admin123</code>
                    <span class="small text-muted d-block">Toàn quyền, thống kê, mã giảm giá</span>
                  </button>
                </div>
                <div class="col-sm-4">
                  <button type="button" class="btn btn-light border text-start w-100 h-100 quickfill" data-u="nhanvien" data-p="123456">
                    <span class="badge bg-primary">Nhân viên</span><code class="d-block small mt-1">nhanvien / 123456</code>
                    <span class="small text-muted d-block">Quản lý SP, nhận cọc, giao – nhận đồ</span>
                  </button>
                </div>
                <div class="col-sm-4">
                  <button type="button" class="btn btn-light border text-start w-100 h-100 quickfill" data-u="khachhang" data-p="123456">
                    <span class="badge bg-success">Khách</span><code class="d-block small mt-1">khachhang / 123456</code>
                    <span class="small text-muted d-block">Đặt thuê, xem đơn của mình</span>
                  </button>
                </div>
              </div>
            </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('.quickfill').forEach(function(b){
    b.addEventListener('click', function(){
      document.getElementById('u').value = b.dataset.u;
      document.getElementById('p').value = b.dataset.p;
    });
  });
</script>
