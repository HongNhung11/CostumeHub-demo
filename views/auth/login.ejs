<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5">
    <div class="card shadow-sm mt-4">
      <div class="card-body p-4 p-md-5">
        <div class="text-center mb-4">
          <h2 class="font-serif mb-1" style="color:var(--primary)">Costume<span style="color:var(--gold)">Hub</span></h2>
          <p class="text-muted small mb-0">Đăng nhập để quản lý & đặt thuê</p>
        </div>
        <% if (returnTo && returnTo !== '/') { %><div class="alert alert-light border small py-2"><i class="bi bi-info-circle text-primary"></i> Đăng nhập xong bạn sẽ quay lại trang trước đó.</div><% } %>
        <form method="POST" action="/login">
          <input type="hidden" name="returnTo" value="<%= returnTo %>">
          <div class="mb-3">
            <label class="form-label small text-muted">Tên đăng nhập</label>
            <input name="username" id="u" class="form-control form-control-lg" required autofocus value="admin">
          </div>
          <div class="mb-3">
            <label class="form-label small text-muted">Mật khẩu</label>
            <input type="password" name="password" id="p" class="form-control form-control-lg" required value="admin123">
          </div>
          <button class="btn btn-primary btn-lg w-100">Đăng nhập</button>
        </form>

        <!-- Tài khoản test -->
        <div class="mt-4">
          <p class="small text-muted mb-2 text-center"><i class="bi bi-key"></i> Tài khoản test — bấm để điền nhanh:</p>
          <div class="d-grid gap-2">
            <button type="button" class="btn btn-light border text-start quickfill" data-u="admin" data-p="admin123">
              <span class="badge bg-danger me-2">Admin</span> <code>admin / admin123</code>
              <span class="small text-muted d-block ms-1">Toàn quyền: quản lý SP, xóa, import, duyệt đơn.</span>
            </button>
            <button type="button" class="btn btn-light border text-start quickfill" data-u="nhanvien" data-p="123456">
              <span class="badge bg-primary me-2">Nhân viên</span> <code>nhanvien / 123456</code>
              <span class="small text-muted d-block ms-1">Thêm/sửa SP, giao–nhận đồ (không xóa/import).</span>
            </button>
            <button type="button" class="btn btn-light border text-start quickfill" data-u="khachhang" data-p="123456">
              <span class="badge bg-success me-2">Khách</span> <code>khachhang / 123456</code>
              <span class="small text-muted d-block ms-1">Chỉ đặt thuê & xem đơn của mình.</span>
            </button>
          </div>
        </div>

        <p class="text-center mt-3 mb-0 small">Chưa có tài khoản? <a href="/register?next=<%= encodeURIComponent(returnTo) %>" style="color:var(--primary)">Đăng ký ngay</a></p>
      </div>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('.quickfill').forEach(function(b){
    b.addEventListener('click', function(){
      document.getElementById('u').value = b.dataset.u;
      document.getElementById('p').value = b.dataset.p;
    });
  });
</script>
