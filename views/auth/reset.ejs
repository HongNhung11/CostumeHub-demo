<div class="row justify-content-center my-md-4">
  <div class="col-md-8 col-lg-5">
    <div class="card p-4">
      <h3 class="font-serif mb-3" style="color:var(--primary)">Đặt mật khẩu mới</h3>
      <form method="POST" action="/dat-lai-mat-khau/<%= token %>">
        <label class="form-label small text-muted" for="newPw">Mật khẩu mới (ít nhất 6 ký tự)</label>
        <input id="newPw" name="password" type="password" class="form-control mb-3" required minlength="6" maxlength="100" autocomplete="new-password" autofocus>
        <label class="form-label small text-muted" for="newPw2">Nhập lại mật khẩu mới</label>
        <input id="newPw2" name="confirm" type="password" class="form-control mb-3" required minlength="6" maxlength="100" autocomplete="new-password">
        <button class="btn btn-primary w-100">Lưu mật khẩu mới</button>
      </form>
    </div>
  </div>
</div>
