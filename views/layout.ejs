<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'CostumeHub' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
  <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/vendor/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <!-- Top utility bar -->
  <div class="topbar py-1">
    <div class="container d-flex justify-content-between align-items-center">
      <span><i class="bi bi-telephone-fill text-warning"></i> Hotline: 0123 456 789 &nbsp;·&nbsp; <i class="bi bi-geo-alt-fill text-warning"></i> Cho thuê trang phục cao cấp</span>
      <span class="d-none d-lg-inline"><i class="bi bi-clock text-warning"></i> 8:00 – 21:00 hằng ngày &nbsp;·&nbsp; <a href="/cach-thue">Cách thức thuê</a> &nbsp;·&nbsp; <a href="/doi-size">Đổi size miễn phí</a></span>
    </div>
  </div>

  <!-- Main navbar -->
  <nav class="navbar navbar-expand-xl ch-nav sticky-top py-2">
    <div class="container">
      <a class="navbar-brand" href="/">Costume<span class="dot">Hub</span></a>
      <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="nav">
        <ul class="navbar-nav mx-auto">
          <li class="nav-item"><a class="nav-link <%= path==='/' ? 'active' : '' %>" href="/"><i class="bi bi-house me-1"></i>Trang chủ</a></li>
          <!-- Danh mục: menu xổ xuống, rê chuột vào nhóm để mở menu con -->
          <%
            // Danh mục con lấy từ utils/categories.js (CAT_GROUPS)
            const enc = encodeURIComponent;
            const groupOf = (g) => (CAT_GROUPS.find(x => x.group === g) || { items: [] }).items.map(i => ({ label: i.label, href: '/products?cat=' + i.key }));
            const catMenu = [
              { label: 'Tất cả', href: '/products?clear=1' },
              { label: 'Trang phục', href: '/products', sub: [
                { label: 'Áo dài', href: '/products?type=' + enc('Áo dài') },
                { label: 'Váy tiệc – Đầm dạ hội', href: '/products?type=' + enc('Váy tiệc') },
              ] },
              { label: 'Combo & thuê nhóm', href: '/combo' },
              { label: 'Phụ kiện', href: '/products?type=' + enc('Phụ kiện'), sub: [
                { label: 'Tất cả phụ kiện', href: '/products?type=' + enc('Phụ kiện') }, ...groupOf('Phụ kiện'),
              ] },
            ];
          %>
          <li class="nav-item cat-menu">
            <a class="nav-link <%= path==='/products' ? 'active' : '' %>" href="/products" aria-haspopup="true"><i class="bi bi-handbag me-1"></i>Sản phẩm</a>
            <div class="cat-panel">
              <% catMenu.forEach(c => { %>
                <div class="cat-row <%= c.sub ? 'has-sub' : '' %>">
                  <a href="<%= c.href %>" class="cat-link"><%= c.label %><% if (c.sub) { %><i class="bi bi-chevron-right"></i><% } %></a>
                  <% if (c.sub) { %>
                    <div class="cat-flyout">
                      <% c.sub.forEach(s => { %><a href="<%= s.href %>" class="cat-link"><%= s.label %></a><% }) %>
                    </div>
                  <% } %>
                </div>
              <% }) %>
            </div>
          </li>
          <% const helpPages = ['/cach-thue', '/hoi-dap', '/doi-size', '/noi-quy']; %>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle <%= helpPages.includes(path) ? 'active' : '' %>" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-question-circle me-1"></i>Hỗ trợ</a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item <%= path==='/cach-thue' ? 'active' : '' %>" href="/cach-thue"><i class="bi bi-signpost-split me-2"></i>Cách thức thuê</a></li>
              <li><a class="dropdown-item <%= path==='/hoi-dap' ? 'active' : '' %>" href="/hoi-dap"><i class="bi bi-question-circle me-2"></i>Câu hỏi thường gặp</a></li>
              <li><a class="dropdown-item <%= path==='/doi-size' ? 'active' : '' %>" href="/doi-size"><i class="bi bi-arrow-left-right me-2"></i>Chính sách đổi size</a></li>
              <li><a class="dropdown-item <%= path==='/noi-quy' ? 'active' : '' %>" href="/noi-quy"><i class="bi bi-journal-text me-2"></i>Nội quy &amp; bảng phí</a></li>
            </ul>
          </li>
          <% const isStaff = currentUser && (currentUser.role === 'admin' || currentUser.role === 'nhanvien'); %>
          <% if (isStaff) { %>
            <%# Admin / nhân viên: "Liên hệ" là danh sách khách gửi form liên hệ cần tư vấn %>
            <li class="nav-item"><a class="nav-link <%= path.startsWith('/admin/contacts') ? 'active' : '' %>" href="/admin/contacts"><i class="bi bi-telephone me-1"></i>Liên hệ<% if (typeof newContacts !== 'undefined' && newContacts) { %> <span class="badge rounded-pill bg-danger"><%= newContacts %></span><% } %></a></li>
          <% } else { %>
            <li class="nav-item"><a class="nav-link <%= path==='/contact' ? 'active' : '' %>" href="/contact"><i class="bi bi-telephone me-1"></i>Liên hệ</a></li>
          <% } %>
          <% if (currentUser) { %>
            <% if (currentUser.role === 'admin' || currentUser.role === 'nhanvien') { %>
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle <%= path.startsWith('/rentals') ? 'active' : '' %>" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-receipt"></i> Đơn thuê</a>
                <ul class="dropdown-menu">
                  <li><a class="dropdown-item <%= path === '/rentals/today' ? 'active' : '' %>" href="/rentals/today"><i class="bi bi-list-check me-2"></i>Việc hôm nay</a></li>
                  <li><a class="dropdown-item <%= path === '/rentals' ? 'active' : '' %>" href="/rentals"><i class="bi bi-receipt me-2"></i>Tất cả đơn thuê</a></li>
                  <li><a class="dropdown-item <%= path === '/rentals/calendar' ? 'active' : '' %>" href="/rentals/calendar"><i class="bi bi-calendar3 me-2"></i>Lịch tổng</a></li>
                  <li><a class="dropdown-item <%= path === '/admin/money' ? 'active' : '' %>" href="/admin/money"><i class="bi bi-journal-text me-2"></i>Sổ hoàn cọc</a></li>
                </ul>
              </li>
            <% } else { %>
              <li class="nav-item"><a class="nav-link <%= path.startsWith('/rentals') ? 'active' : '' %>" href="/rentals"><i class="bi bi-receipt"></i> Đơn thuê</a></li>
            <% } %>
          <% } %>
          <% if (isStaff && currentUser.role !== 'admin') { %>
            <%# Nhân viên chỉ quản lý sản phẩm -> link thẳng, không cần menu xổ %>
            <li class="nav-item"><a class="nav-link <%= path.startsWith('/products/manage') ? 'active' : '' %>" href="/products/manage"><i class="bi bi-box-seam"></i> Quản lý sản phẩm</a></li>
          <% } %>
          <% if (isStaff && currentUser.role === 'admin') { %>
            <% const isAdmin = true; %>
            <% const mgActive = path.startsWith('/products/manage') || path.startsWith('/products/new') || path.startsWith('/admin'); %>
            <!-- Gom các trang quản trị vào 1 menu để thanh điều hướng không tràn ngang -->
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle <%= mgActive ? 'active' : '' %>" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-gear"></i> Quản lý</a>
              <ul class="dropdown-menu">
                <li><a class="dropdown-item <%= path.startsWith('/products/manage') ? 'active' : '' %>" href="/products/manage"><i class="bi bi-box-seam me-2"></i>Quản lý sản phẩm</a></li>
                <% if (isAdmin) { %>
                  <li><a class="dropdown-item <%= path.startsWith('/admin/stats') ? 'active' : '' %>" href="/admin/stats"><i class="bi bi-bar-chart-line me-2"></i>Thống kê</a></li>
                  <li><a class="dropdown-item <%= path.startsWith('/admin/coupons') ? 'active' : '' %>" href="/admin/coupons"><i class="bi bi-ticket-perforated me-2"></i>Mã giảm giá</a></li>
                  <li><a class="dropdown-item <%= path.startsWith('/admin/bundles') ? 'active' : '' %>" href="/admin/bundles"><i class="bi bi-gift me-2"></i>Combo &amp; thuê nhóm</a></li>
                  <li><a class="dropdown-item <%= path.startsWith('/admin/users') ? 'active' : '' %>" href="/admin/users"><i class="bi bi-people me-2"></i>Tài khoản</a></li>
                <% } %>
              </ul>
            </li>
          <% } %>
        </ul>
        <div class="d-flex gap-2 align-items-center">
          <% if (currentUser) { %>
            <a href="/notifications" class="btn btn-light btn-sm position-relative <%= path.startsWith('/notifications') ? 'active' : '' %>" title="Thông báo<%= unreadCount ? ` (${unreadCount} chưa đọc)` : '' %>">
              <i class="bi <%= unreadCount ? 'bi-bell-fill' : 'bi-bell' %>"></i><span class="d-lg-none"> Thông báo</span>
              <% if (unreadCount) { %><span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"><%= unreadCount > 9 ? '9+' : unreadCount %></span><% } %>
            </a>
            <a href="/favorites" class="btn btn-light btn-sm <%= path.startsWith('/favorites') ? 'active' : '' %>" title="Yêu thích"><i class="bi bi-heart"></i><span class="d-lg-none"> Yêu thích</span></a>
          <% } %>
          <a href="/cart" class="btn btn-light btn-sm position-relative <%= path.startsWith('/cart') ? 'active' : '' %>" title="Giỏ thuê">
            <i class="bi bi-bag"></i><span class="nav-btn-text"> Giỏ thuê</span>
            <% if (cartCount) { %><span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"><%= cartCount %></span><% } %>
          </a>
          <% if (currentUser && (currentUser.role === 'admin' || currentUser.role === 'nhanvien')) { %>
            <a href="/products/new" class="btn btn-primary btn-sm" title="Thêm sản phẩm"><i class="bi bi-plus-lg"></i><span class="nav-btn-text"> Thêm</span></a>
          <% } else if (!currentUser) { %>
            <a href="/login" class="btn btn-outline-primary btn-sm"><i class="bi bi-person"></i> Đăng nhập</a>
            <a href="/register" class="btn btn-primary btn-sm">Đăng ký</a>
          <% } %>
          <% if (currentUser) { %>
            <!-- Tài khoản: tên + menu (thay cho dòng tên / đăng xuất ở thanh trên cùng) -->
            <div class="dropdown">
              <button class="btn btn-light btn-sm dropdown-toggle <%= path.startsWith('/account') ? 'active' : '' %>" data-bs-toggle="dropdown" aria-expanded="false" title="<%= currentUser.fullName || currentUser.username %>">
                <i class="bi bi-person-circle"></i> <span class="acc-name nav-btn-text"><%= currentUser.fullName || currentUser.username %></span>
              </button>
              <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" href="/account"><i class="bi bi-person me-2"></i>Tài khoản của tôi</a></li>
                <li><a class="dropdown-item" href="/rentals"><i class="bi bi-receipt me-2"></i>Đơn thuê</a></li>
                <li><a class="dropdown-item" href="/notifications"><i class="bi bi-bell me-2"></i>Thông báo<% if (unreadCount) { %> <span class="badge bg-danger"><%= unreadCount %></span><% } %></a></li>
                <li><a class="dropdown-item" href="/favorites"><i class="bi bi-heart me-2"></i>Yêu thích</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item text-danger" href="/logout"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
              </ul>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </nav>

  <main class="container my-4">
    <% if (success && success.length) { %><div class="alert alert-success alert-dismissible shadow-sm"><%= success %><button class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
    <% if (error && error.length) { %><div class="alert alert-danger alert-dismissible shadow-sm"><%= error %><button class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
    <%- body %>
  </main>

  <footer class="ch-footer pt-5 pb-4 mt-5">
    <div class="container">
      <div class="row g-4">
        <div class="col-md-4">
          <h4 class="font-serif text-white mb-2">Costume<span style="color:var(--gold)">Hub</span></h4>
          <p class="small mb-2">Hệ thống quản lý & cho thuê trang phục nữ cao cấp — áo dài, váy tiệc – đầm dạ hội và phụ kiện. Tích hợp AI hỗ trợ xác minh & tìm kiếm thông minh.</p>
          <div class="fs-5"><i class="bi bi-facebook me-2"></i><i class="bi bi-instagram me-2"></i><i class="bi bi-tiktok me-2"></i></div>
        </div>
        <div class="col-6 col-md-2">
          <h6 class="mb-3">Hỗ trợ khách hàng</h6>
          <ul class="list-unstyled small">
            <li class="mb-1"><a href="/cach-thue">Cách thức thuê</a></li>
            <li class="mb-1"><a href="/hoi-dap">Câu hỏi thường gặp</a></li>
            <li class="mb-1"><a href="/doi-size">Chính sách đổi size</a></li>
            <li class="mb-1"><a href="/noi-quy">Nội quy &amp; bảng phí</a></li>
          </ul>
        </div>
        <div class="col-6 col-md-2">
          <h6 class="mb-3">Danh mục</h6>
          <ul class="list-unstyled small">
            <li class="mb-1"><a href="/products?type=Áo dài">Áo dài</a></li>
            <li class="mb-1"><a href="/products?type=Váy tiệc">Váy tiệc – Dạ hội</a></li>
            <li class="mb-1"><a href="/products?type=Phụ kiện">Phụ kiện</a></li>
          </ul>
        </div>
        <div class="col-md-4">
          <h6 class="mb-3">Liên hệ</h6>
          <p class="small mb-1"><i class="bi bi-geo-alt me-2"></i>Cửa hàng CostumeHub, Hà Nội</p>
          <p class="small mb-1"><i class="bi bi-telephone me-2"></i>0123 456 789</p>
          <p class="small mb-0"><i class="bi bi-clock me-2"></i>8:00 – 21:00 hằng ngày</p>
        </div>
      </div>
      <hr class="border-secondary my-4">
      <p class="text-center small mb-0" style="color:#9d9183">© 2026 CostumeHub — Đồ án Ngôn ngữ kịch bản · Node.js + Express + Sequelize + EJS</p>
    </div>
  </footer>

  <!-- Nút lên đầu trang: hiện khi cuộn xuống, vòng viền chạy theo tiến độ cuộn -->
  <button type="button" id="toTop" class="to-top" aria-label="Lên đầu trang" title="Lên đầu trang">
    <svg viewBox="0 0 48 48" aria-hidden="true"><circle class="tt-track" cx="24" cy="24" r="22"/><circle class="tt-ring" cx="24" cy="24" r="22"/></svg>
    <i class="bi bi-arrow-up"></i>
  </button>

  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js"></script>
  <script>
  // Menu "Danh mục" trên màn hình hẹp (menu ☰): bấm để mở / đóng, nhóm có mục con cũng bấm để xổ
  (function () {
    const narrow = () => window.matchMedia('(max-width: 1199px)').matches;
    document.querySelectorAll('.cat-menu > .nav-link').forEach(a => a.addEventListener('click', (e) => {
      if (!narrow()) return;                       // màn hình rộng: bấm vào là sang trang sản phẩm như cũ
      e.preventDefault();
      a.parentNode.classList.toggle('open');
    }));
    // Rê chuột vào "Danh mục" thì đóng các menu xổ khác (Hỗ trợ, Quản lý...) để không bị chồng lên nhau
    document.querySelectorAll('.cat-menu').forEach(m => m.addEventListener('mouseenter', () => {
      if (narrow() || !window.bootstrap) return;
      document.querySelectorAll('.ch-nav [data-bs-toggle="dropdown"].show').forEach(t => bootstrap.Dropdown.getOrCreateInstance(t).hide());
    }));
    document.querySelectorAll('.cat-row.has-sub > .cat-link').forEach(a => a.addEventListener('click', (e) => {
      if (!narrow()) return;
      e.preventDefault();
      a.parentNode.classList.toggle('open');
    }));

    // Màn hình rộng: các menu xổ Bootstrap (Hỗ trợ, Quản lý, Tài khoản) mở khi rê chuột, giống "Danh mục".
    // Màn hình hẹp (menu ☰) vẫn bấm để mở như cũ.
    if (window.bootstrap) {
      document.querySelectorAll('.ch-nav .dropdown').forEach(dd => {
        const toggle = dd.querySelector('[data-bs-toggle="dropdown"]');
        if (!toggle) return;
        const inst = bootstrap.Dropdown.getOrCreateInstance(toggle);
        let timer;
        dd.addEventListener('mouseenter', () => {
          if (narrow()) return;
          clearTimeout(timer);
          // đóng menu khác đang mở rồi mở menu này
          document.querySelectorAll('.ch-nav [data-bs-toggle="dropdown"].show').forEach(t => { if (t !== toggle) bootstrap.Dropdown.getOrCreateInstance(t).hide(); });
          inst.show();
          toggle.blur();                                // Bootstrap tự focus nút khi mở -> bỏ, kẻo nút cứ sáng mãi
        });
        dd.addEventListener('mouseleave', () => {
          if (narrow()) return;
          timer = setTimeout(() => { inst.hide(); toggle.blur(); }, 180);   // trễ chút để rê chuột xuống menu không bị tắt
        });
        // Đang mở do rê chuột thì bấm vào không làm nó đóng lại
        toggle.addEventListener('click', (e) => {
          if (narrow()) return;
          e.preventDefault(); e.stopPropagation();
          inst.show();
        });
      });
    }
  })();
  </script>
</body>
</html>
