<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'CostumeHub' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <!-- Top utility bar -->
  <div class="topbar py-1">
    <div class="container d-flex justify-content-between align-items-center">
      <span><i class="bi bi-telephone-fill text-warning"></i> Hotline: 0123 456 789 &nbsp;·&nbsp; <i class="bi bi-geo-alt-fill text-warning"></i> Cho thuê trang phục cao cấp</span>
      <span class="d-none d-md-inline">
        <% if (currentUser) { %>
          <i class="bi bi-person-check"></i> <%= currentUser.fullName || currentUser.username %> ·
          <a href="/logout">Đăng xuất</a>
        <% } else { %>
          <a href="/login">Đăng nhập</a> &nbsp;|&nbsp; <a href="/register">Đăng ký</a>
        <% } %>
      </span>
    </div>
  </div>

  <!-- Main navbar -->
  <nav class="navbar navbar-expand-lg ch-nav sticky-top py-2">
    <div class="container">
      <a class="navbar-brand" href="/">Costume<span class="dot">Hub</span></a>
      <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="nav">
        <ul class="navbar-nav mx-auto">
          <li class="nav-item"><a class="nav-link <%= path==='/' ? 'active' : '' %>" href="/">Trang chủ</a></li>
          <li class="nav-item"><a class="nav-link <%= path==='/products' ? 'active' : '' %>" href="/products">Sản phẩm</a></li>
          <li class="nav-item"><a class="nav-link" href="/#quy-dinh">Quy định</a></li>
          <li class="nav-item"><a class="nav-link <%= path==='/contact' ? 'active' : '' %>" href="/contact">Liên hệ</a></li>
          <% if (currentUser) { %>
            <li class="nav-item"><a class="nav-link <%= path.startsWith('/rentals') ? 'active' : '' %>" href="/rentals"><i class="bi bi-receipt"></i> Đơn thuê</a></li>
          <% } %>
          <% if (currentUser && (currentUser.role === 'admin' || currentUser.role === 'nhanvien')) { %>
            <li class="nav-item"><a class="nav-link <%= path.startsWith('/products/manage') ? 'active' : '' %>" href="/products/manage"><i class="bi bi-gear"></i> Quản lý</a></li>
          <% } %>
          <% if (currentUser && currentUser.role === 'admin') { %>
            <li class="nav-item"><a class="nav-link <%= path.startsWith('/admin') ? 'active' : '' %>" href="/admin/users"><i class="bi bi-people"></i> Tài khoản</a></li>
          <% } %>
        </ul>
        <div class="d-flex gap-2 align-items-center">
          <a href="/cart" class="btn btn-light btn-sm position-relative <%= path.startsWith('/cart') ? 'active' : '' %>" title="Giỏ thuê">
            <i class="bi bi-bag"></i> Giỏ thuê
            <% if (cartCount) { %><span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"><%= cartCount %></span><% } %>
          </a>
          <% if (currentUser && (currentUser.role === 'admin' || currentUser.role === 'nhanvien')) { %>
            <a href="/products/new" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Thêm</a>
          <% } else if (!currentUser) { %>
            <a href="/login" class="btn btn-outline-primary btn-sm"><i class="bi bi-person"></i> Đăng nhập</a>
          <% } %>
        </div>
      </div>
    </div>
  </nav>

  <main class="container my-4">
    <% if (success && success.length) { %><div class="alert alert-success alert-dismissible shadow-sm"><%= success %><button class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
    <% if (error && error.length) { %><div class="alert alert-danger alert-dismissible shadow-sm"><%= error %><button class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
    <%- body %>
  </main>

  <footer class="ch-footer pt-5 pb-4 mt-5">
    <div class="container">
      <div class="row g-4">
        <div class="col-md-4">
          <h4 class="font-serif text-white mb-2">Costume<span style="color:var(--gold)">Hub</span></h4>
          <p class="small mb-2">Hệ thống quản lý & cho thuê trang phục nữ cao cấp — áo dài, váy tiệc – đầm dạ hội và phụ kiện. Tích hợp AI hỗ trợ xác minh & tìm kiếm thông minh.</p>
          <div class="fs-5"><i class="bi bi-facebook me-2"></i><i class="bi bi-instagram me-2"></i><i class="bi bi-tiktok me-2"></i></div>
        </div>
        <div class="col-md-3">
          <h6 class="mb-3">Danh mục</h6>
          <ul class="list-unstyled small">
            <li class="mb-1"><a href="/products?type=Áo dài">Áo dài</a></li>
            <li class="mb-1"><a href="/products?type=Váy tiệc">Váy tiệc – Dạ hội</a></li>
            <li class="mb-1"><a href="/products?type=Phụ kiện">Phụ kiện</a></li>
          </ul>
        </div>
        <div class="col-md-5">
          <h6 class="mb-3">Liên hệ</h6>
          <p class="small mb-1"><i class="bi bi-geo-alt me-2"></i>Cửa hàng CostumeHub</p>
          <p class="small mb-1"><i class="bi bi-telephone me-2"></i>0123 456 789</p>
          <p class="small mb-0"><i class="bi bi-clock me-2"></i>8:00 – 21:00 hằng ngày</p>
        </div>
      </div>
      <hr class="border-secondary my-4">
      <p class="text-center small mb-0" style="color:#9d9183">© 2026 CostumeHub — Đồ án Ngôn ngữ kịch bản · Node.js + Express + Sequelize + EJS</p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js"></script>
</body>
</html>
