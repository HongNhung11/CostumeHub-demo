<%
  // BƯỚC 1: GIỎ THUÊ — xem lại món, size, số lượng. Ngày thuê, cách nhận, thanh toán ở bước 2 (/cart/checkout)
  const vnd = n => Number(n || 0).toLocaleString('vi-VN') + ' đ';
  let pricePerDay = 0, depositAll = 0, qtyAll = 0;
  lines.forEach(l => { pricePerDay += priceOf(l.product) * l.qty; depositAll += Number(l.product.DepositValue) * l.qty; qtyAll += l.qty; });
  const next = currentUser ? '/cart/checkout' : '/login?next=/cart/checkout';
%>
<%- include('../partials/checkout-steps', { step: 1 }) %>

<% if (!lines.length) { %>
  <div class="card p-5 text-center text-muted cart-empty">
    <i class="bi bi-bag"></i>
    <h5 class="font-serif mt-2">Giỏ thuê đang trống</h5>
    <p class="mb-3">Chọn trang phục, size, màu rồi bấm <strong>Thêm vào giỏ</strong>.</p>
    <div><a href="/products" class="btn btn-primary px-4"><i class="bi bi-arrow-left"></i> Xem trang phục</a></div>
  </div>
<% } else { %>
<div class="row g-4">
  <!-- Danh sách món -->
  <div class="col-lg-8">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <h5 class="font-serif mb-0">Giỏ thuê <span class="text-muted fs-6">(<%= qtyAll %> món)</span></h5>
      <a href="/products" class="small"><i class="bi bi-plus-lg"></i> Thêm món khác</a>
    </div>
    <div class="d-flex flex-column gap-3">
      <% lines.forEach(l => { const p = l.product; const sale = saleOf(p) !== null; %>
        <div class="cart-item">
          <a href="/products/<%= p.ProductID %>" class="ci-img"><% if (p.PathImage) { %><img src="<%= p.PathImage %>" alt="<%= p.ProductName %>" onerror="this.style.display='none'"><% } %></a>
          <div class="ci-main">
            <div class="d-flex justify-content-between gap-2">
              <div>
                <a href="/products/<%= p.ProductID %>" class="ci-name"><%= p.ProductName %></a>
                <div class="ci-chips"><span>Size <%= l.size %></span><span>Màu <%= l.color %></span><span class="text-muted"><%= p.ProductType %></span></div>
              </div>
              <div class="ci-price">
                <b><%= vnd(priceOf(p) * l.qty) %></b><small>/ ngày</small>
                <% if (sale) { %><div><s><%= vnd(Number(p.Price) * l.qty) %></s> <span class="text-danger">-<%= salePercent(p) %>%</span></div><% } %>
              </div>
            </div>
            <div class="ci-foot">
              <form method="POST" action="/cart/<%= l.key %>/update" class="cart-qty-form">
                <div class="qty-box qty-sm">
                  <button type="button" data-d="-1" aria-label="Giảm">−</button>
                  <input type="number" name="qty" value="<%= l.qty %>" min="1" max="<%= l.stock %>" data-last="<%= l.qty %>" aria-label="Số lượng">
                  <button type="button" data-d="1" aria-label="Tăng">+</button>
                </div>
              </form>
              <span class="small text-muted">Cọc <%= vnd(Number(p.DepositValue) * l.qty) %></span>
              <form method="POST" action="/cart/<%= l.key %>/remove" class="ms-auto" onsubmit="return confirm('Bỏ món này khỏi giỏ?')">
                <button class="ci-remove"><i class="bi bi-trash3"></i> Xóa</button>
              </form>
            </div>
            <div class="small text-danger qty-err"></div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- Tóm tắt -->
  <div class="col-lg-4">
    <div class="card p-4 co-summary">
      <h5 class="font-serif mb-3">Tóm tắt giỏ thuê</h5>
      <div class="cs-row"><span>Giá thuê / ngày</span><b><%= vnd(pricePerDay) %></b></div>
      <div class="cs-row"><span>Tiền cọc <small class="text-muted">(hoàn lại)</small></span><b><%= vnd(depositAll) %></b></div>
      <div class="cs-note"><i class="bi bi-info-circle"></i> Số ngày thuê, cách nhận đồ và mã giảm giá chọn ở bước tiếp theo.</div>
      <a href="<%= next %>" class="btn btn-dark btn-lg w-100 co-cta"><i class="bi bi-lock-fill"></i> <%= currentUser ? 'Tiến hành đặt thuê' : 'Đăng nhập để đặt thuê' %></a>
      <% if (!currentUser) { %><div class="small text-muted text-center mt-2">Chưa có tài khoản? <a href="/register?next=/cart/checkout">Đăng ký miễn phí</a> — giỏ thuê vẫn được giữ.</div><% } %>
      <a href="/products" class="d-block text-center small mt-3"><i class="bi bi-arrow-left"></i> Tiếp tục chọn đồ</a>
      <hr>
      <div class="cs-trust">
        <div><i class="bi bi-stars"></i> Giặt hấp miễn phí trước khi giao</div>
        <div><i class="bi bi-arrow-left-right"></i> Đổi size miễn phí (tự lấy / nội thành)</div>
        <div><i class="bi bi-shield-check"></i> Hoàn cọc khi trả đồ nguyên vẹn</div>
      </div>
    </div>
  </div>
</div>

<script>
// Đổi số lượng: lưu vào giỏ rồi tải lại để cập nhật tiền (bước này chưa có gì phải điền nên không mất dữ liệu)
document.querySelectorAll('.cart-qty-form').forEach(f => {
  const inp = f.querySelector('input[name="qty"]'), err = f.closest('.ci-main').querySelector('.qty-err');
  let timer;
  const save = async () => {
    const max = +inp.max || 99, q = Math.min(max, Math.max(1, parseInt(inp.value) || 1));
    inp.value = q;
    if (String(q) === inp.dataset.last) return;
    try {
      const r = await (await fetch(f.action, { method: 'POST', headers: { 'X-Requested-With': 'fetch', 'Content-Type': 'application/x-www-form-urlencoded' }, body: 'qty=' + q })).json();
      if (r.ok) location.reload(); else { inp.value = inp.dataset.last; err.textContent = r.error; }
    } catch (_) { inp.value = inp.dataset.last; err.textContent = 'Không lưu được, thử lại.'; }
  };
  f.querySelectorAll('button[data-d]').forEach(b => b.addEventListener('click', () => {
    inp.value = Math.min(+inp.max || 99, Math.max(1, (parseInt(inp.value) || 1) + +b.dataset.d));
    clearTimeout(timer); timer = setTimeout(save, 400);
  }));
  inp.addEventListener('change', save);
  f.addEventListener('submit', ev => { ev.preventDefault(); save(); });
});
</script>
<% } %>
