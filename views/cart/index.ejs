<%
  const pad = n => String(n).padStart(2,'0');
  const d2s = d => `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`;
  const today = new Date();
  const tmr = new Date(Date.now()+86400000);
  const maxEnd = new Date(Date.now()+(60+MAX_RENT_DAYS)*86400000);
  const vnd = n => Number(n||0).toLocaleString('vi-VN') + ' đ';
  const o = (k, d = '') => (old && old[k] !== undefined ? old[k] : d);
  const giao = o('DeliveryMethod') === 'Giao tận nơi';
  let pricePerDay = 0, depositAll = 0, qtyAll = 0;
  lines.forEach(l => { pricePerDay += Number(l.product.Price) * l.qty; depositAll += Number(l.product.DepositValue) * l.qty; qtyAll += l.qty; });
%>
<nav class="small text-muted mb-3"><a href="/products" class="text-muted">Sản phẩm</a> / <span>Giỏ thuê</span></nav>

<h3 class="font-serif mb-3"><i class="bi bi-bag-check" style="color:var(--gold)"></i> Giỏ thuê & Đặt thuê</h3>

<% if (!lines.length) { %>
  <div class="card p-5 text-center text-muted">
    <i class="bi bi-bag" style="font-size:2.5rem"></i>
    <p class="mt-2 mb-3">Giỏ thuê đang trống. Chọn trang phục, size, màu rồi bấm <strong>Thêm vào giỏ</strong>.</p>
    <div><a href="/products" class="btn btn-primary"><i class="bi bi-arrow-left"></i> Xem trang phục</a></div>
  </div>
<% } else { %>

<!-- Danh sách món trong giỏ (form riêng cho sửa số lượng / bỏ món) -->
<div class="card mb-4">
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead><tr><th>Trang phục</th><th>Size / Màu</th><th class="text-end">Giá/ngày</th><th style="width:150px">Số lượng</th><th class="text-end">Cọc</th><th></th></tr></thead>
      <tbody>
      <% lines.forEach(l => { const p = l.product; %>
        <tr data-pid="<%= p.ProductID %>">
          <td>
            <div class="d-flex align-items-center gap-2">
              <% if (p.PathImage) { %><img src="<%= p.PathImage %>" style="width:44px;height:56px;object-fit:cover" class="rounded" onerror="this.style.display='none'"><% } %>
              <div><a href="/products/<%= p.ProductID %>" class="text-dark fw-semibold"><%= p.ProductName %></a>
                <div class="small text-muted"><%= p.ProductType %></div>
                <div class="small avail-msg"></div></div>
            </div>
          </td>
          <td class="small"><%= l.size || '—' %> · <%= l.color || '—' %></td>
          <td class="text-end"><%= vnd(p.Price) %></td>
          <td>
            <form method="POST" action="/cart/<%= l.key %>/update" class="d-flex gap-1">
              <input type="number" name="qty" value="<%= l.qty %>" min="1" max="<%= p.Quantity %>" class="form-control form-control-sm" style="width:70px">
              <button class="btn btn-sm btn-light" title="Cập nhật"><i class="bi bi-arrow-repeat"></i></button>
            </form>
          </td>
          <td class="text-end"><%= vnd(Number(p.DepositValue) * l.qty) %></td>
          <td class="text-end">
            <form method="POST" action="/cart/<%= l.key %>/remove" onsubmit="return confirm('Bỏ món này khỏi giỏ?')">
              <button class="btn btn-sm btn-outline-danger" title="Bỏ khỏi giỏ"><i class="bi bi-trash"></i></button>
            </form>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <div class="p-2 px-3 small d-flex justify-content-between border-top">
    <a href="/products"><i class="bi bi-plus"></i> Thêm món khác</a>
    <span class="text-muted"><%= qtyAll %> món</span>
  </div>
</div>

<form method="POST" action="/rentals" enctype="multipart/form-data" id="bookForm" novalidate>
  <input type="hidden" id="pricePerDay" value="<%= pricePerDay %>">
  <input type="hidden" id="depositAll" value="<%= depositAll %>">
  <div class="row g-4">

    <!-- Cột trái: thông tin đặt thuê -->
    <div class="col-lg-7">
      <div class="card p-3 mb-3">
        <h6 class="font-serif mb-3"><i class="bi bi-calendar-range"></i> Thời gian thuê (chung cho cả đơn)</h6>
        <div class="row g-2">
          <div class="col-6">
            <label class="form-label small text-muted">Ngày nhận <span class="text-danger">*</span></label>
            <input type="date" name="StartDate" id="StartDate" class="form-control" value="<%= o('StartDate', rentDates ? rentDates.start : d2s(today)) %>" min="<%= d2s(today) %>" max="<%= d2s(maxEnd) %>" required>
          </div>
          <div class="col-6">
            <label class="form-label small text-muted">Ngày trả <span class="text-danger">*</span></label>
            <input type="date" name="EndDate" id="EndDate" class="form-control" value="<%= o('EndDate', rentDates ? rentDates.end : d2s(tmr)) %>" min="<%= d2s(tmr) %>" max="<%= d2s(maxEnd) %>" required>
            <div class="invalid-feedback">Ngày trả phải sau ngày nhận (tối đa <%= MAX_RENT_DAYS %> ngày).</div>
          </div>
        </div>
        <div id="availBox" class="small mt-2"></div>
      </div>

      <div class="card p-3 mb-3">
        <h6 class="font-serif mb-3"><i class="bi bi-person"></i> Thông tin khách hàng</h6>
        <div class="row g-2">
          <div class="col-md-6">
            <label class="form-label small text-muted">Họ tên <span class="text-danger">*</span></label>
            <input name="CustomerName" class="form-control" required minlength="2" maxlength="100" value="<%= o('CustomerName', currentUser.fullName || '') %>">
            <div class="invalid-feedback">Vui lòng nhập họ tên.</div>
          </div>
          <div class="col-md-6">
            <label class="form-label small text-muted">Số điện thoại <span class="text-danger">*</span></label>
            <input type="tel" name="CustomerPhone" id="CustomerPhone" class="form-control" required inputmode="tel"
                   placeholder="VD: 0912345678" maxlength="15" value="<%= o('CustomerPhone') %>">
            <div class="invalid-feedback">Gồm 10 số, bắt đầu bằng 03, 05, 07, 08 hoặc 09.</div>
          </div>
          <div class="col-md-6">
            <label class="form-label small text-muted">Số CCCD <span class="text-danger">*</span></label>
            <input name="CustomerIDCard" id="CustomerIDCard" class="form-control" required inputmode="numeric"
                   placeholder="12 chữ số trên thẻ CCCD" maxlength="12" value="<%= o('CustomerIDCard') %>">
            <div class="invalid-feedback">CCCD gồm đúng 12 chữ số (3 số đầu là mã tỉnh 001–096).</div>
          </div>
          <div class="col-md-6">
            <label class="form-label small text-muted">Ảnh chụp CCCD</label>
            <input type="file" name="IDCardImage" accept="image/*" class="form-control">
            <small class="text-muted">Dùng để xác minh danh tính khi thuê.</small>
          </div>
        </div>
      </div>

      <div class="card p-3 mb-3">
        <h6 class="font-serif mb-3"><i class="bi bi-truck"></i> Hình thức nhận đồ</h6>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="DeliveryMethod" value="Tự đến lấy" id="pickup" <%= giao ? '' : 'checked' %>>
          <label class="form-check-label" for="pickup">Tự đến lấy tại cửa hàng <span class="text-muted small">(miễn phí)</span></label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="DeliveryMethod" value="Giao tận nơi" id="delivery" <%= giao ? 'checked' : '' %>>
          <label class="form-check-label" for="delivery">Giao tận nơi</label>
        </div>
        <div class="mt-2" id="addrBox" style="display:<%= giao ? 'block' : 'none' %>">
          <label class="form-label small text-muted">Địa chỉ nhận hàng <span class="text-danger">*</span></label>
          <input name="DeliveryAddress" id="DeliveryAddress" class="form-control" minlength="10" maxlength="255" <%= giao ? 'required' : '' %>
                 value="<%= o('DeliveryAddress') %>" placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/TP">
          <div class="invalid-feedback">Nhập địa chỉ đầy đủ (ít nhất 10 ký tự).</div>
        </div>
      </div>

      <div class="card p-3">
        <h6 class="font-serif mb-3"><i class="bi bi-credit-card"></i> Hình thức thanh toán cọc</h6>
        <select name="method" class="form-select">
          <% ['Tiền mặt', 'Chuyển khoản', 'Ví điện tử'].forEach(m => { %><option <%= o('method') === m ? 'selected' : '' %>><%= m %></option><% }) %>
        </select>
      </div>
    </div>

    <!-- Cột phải: tóm tắt đơn -->
    <div class="col-lg-5">
      <div class="card p-3" style="position:sticky;top:90px">
        <h6 class="font-serif mb-3">Tóm tắt đơn thuê</h6>
        <div class="small mb-2 pb-2 border-bottom">
          <% lines.forEach(l => { %>
            <div class="d-flex justify-content-between py-1">
              <span><%= l.product.ProductName %> <span class="text-muted">(<%= [l.size, l.color].filter(Boolean).join(' · ') %>) × <%= l.qty %></span></span>
              <span class="text-nowrap ms-2"><%= vnd(Number(l.product.Price) * l.qty) %>/ngày</span>
            </div>
          <% }) %>
        </div>
        <div class="d-flex justify-content-between small py-1"><span>Số ngày thuê</span><span id="sumDays">1</span></div>
        <div class="d-flex justify-content-between small py-1"><span>Tiền thuê</span><span id="sumRent">0 đ</span></div>
        <div class="d-flex justify-content-between small py-1"><span>Tiền cọc (hoàn lại)</span><span id="sumDeposit">0 đ</span></div>
        <hr class="my-2">
        <div class="d-flex justify-content-between fw-bold mb-3"><span>Tổng tạm tính</span><span class="price-tag" id="sumTotal">0 đ</span></div>
        <div class="form-check mb-3 small">
          <input class="form-check-input" type="checkbox" name="agree" value="1" id="agree" required <%= o('agree') === '1' ? 'checked' : '' %>>
          <label class="form-check-label" for="agree">
            Tôi đã đọc và đồng ý <a href="/noi-quy" target="_blank" rel="noopener">nội quy thuê đồ &amp; bảng trừ phí</a>
            (trả trễ, vệ sinh, hư hỏng, mất đồ, hủy đơn).
          </label>
          <div class="invalid-feedback">Vui lòng đọc và đồng ý nội quy trước khi đặt.</div>
        </div>
        <button class="btn btn-gold btn-lg w-100" id="btnBook"><i class="bi bi-check2-circle"></i> Xác nhận đặt & cọc</button>
        <p class="small text-muted text-center mt-2 mb-0">Đặt thuê là xác nhận cọc luôn để giữ chỗ.</p>
      </div>
    </div>
  </div>
</form>

<script>
(function(){
  const s=document.getElementById('StartDate'), e=document.getElementById('EndDate'),
        price=+document.getElementById('pricePerDay').value, dep=+document.getElementById('depositAll').value,
        MAXD=<%= MAX_RENT_DAYS %>;
  const vnd=n=>n.toLocaleString('vi-VN')+' đ';
  const days=()=>{ const d=Math.round((new Date(e.value)-new Date(s.value))/86400000); return d>=1?d:0; };
  function calc(){
    const d=days();
    document.getElementById('sumDays').textContent=d;
    document.getElementById('sumRent').textContent=vnd(price*d);
    document.getElementById('sumDeposit').textContent=vnd(dep);
    document.getElementById('sumTotal').textContent=vnd(price*d+dep);
  }

  // Kiểm tra còn trống theo ngày (chống trùng lịch)
  const box=document.getElementById('availBox');
  let availOk=true;
  async function checkAvail(){
    document.querySelectorAll('.avail-msg').forEach(m=>m.textContent='');
    if(!s.value||!e.value) return;
    try{
      const r=await (await fetch(`/cart/availability?start=${s.value}&end=${e.value}`)).json();
      availOk=r.ok;
      if(r.error){ box.innerHTML=`<span class="text-danger"><i class="bi bi-exclamation-circle"></i> ${r.error}</span>`; availOk=false; return; }
      for(const [pid,info] of Object.entries(r.products)){
        document.querySelectorAll(`tr[data-pid="${pid}"] .avail-msg`).forEach(m=>{
          m.className='small avail-msg '+(info.need<=info.available?'text-success':'text-danger');
          m.textContent= info.available===0 ? 'Đã kín lịch trong những ngày này'
            : info.need<=info.available ? `Còn ${info.available} bộ trống` : `Chỉ còn ${info.available} bộ trống (bạn chọn ${info.need})`;
        });
      }
      box.innerHTML = r.ok ? '<span class="text-success"><i class="bi bi-check-circle"></i> Tất cả các món còn trống trong khoảng ngày này.</span>'
        : '<span class="text-danger"><i class="bi bi-exclamation-circle"></i> Có món không đủ bộ trống — vui lòng đổi ngày hoặc giảm số lượng.</span>';
    }catch(_){ availOk=true; box.textContent=''; }
  }
  [s,e].forEach(el=>el.addEventListener('change',()=>{ calc(); checkDates(); checkAvail(); }));
  calc(); checkAvail();

  // Hiện/ẩn ô địa chỉ theo hình thức nhận
  const addrBox=document.getElementById('addrBox'), addr=document.getElementById('DeliveryAddress');
  document.querySelectorAll('input[name="DeliveryMethod"]').forEach(r=>{
    r.addEventListener('change',()=>{
      const giao=document.getElementById('delivery').checked;
      addrBox.style.display=giao?'block':'none';
      addr.required=giao;
    });
  });

  // Quy định SĐT và CCCD (máy chủ cũng kiểm tra lại)
  const phone=document.getElementById('CustomerPhone'), cccd=document.getElementById('CustomerIDCard');
  const normPhone=v=>{ v=v.replace(/[\s.\-()]/g,''); if(v.startsWith('+84')) v='0'+v.slice(3); else if(/^84\d{9}$/.test(v)) v='0'+v.slice(2); return v; };
  const checkPhone=()=>phone.setCustomValidity(/^0(3|5|7|8|9)\d{8}$/.test(normPhone(phone.value))?'':'invalid');
  const checkCCCD=()=>{ const v=cccd.value, p=parseInt(v.slice(0,3),10);
    cccd.setCustomValidity(/^\d{12}$/.test(v)&&p>=1&&p<=96?'':'invalid'); };
  function checkDates(){ const d=Math.round((new Date(e.value)-new Date(s.value))/86400000);
    e.setCustomValidity(d>=1&&d<=MAXD?'':'invalid'); }
  cccd.addEventListener('input',()=>{ cccd.value=cccd.value.replace(/\D/g,'').slice(0,12); checkCCCD(); });
  phone.addEventListener('input',checkPhone);

  const form=document.getElementById('bookForm');
  form.addEventListener('submit',ev=>{
    checkPhone(); checkCCCD(); checkDates();
    if(!form.checkValidity() || !availOk){
      ev.preventDefault();
      form.classList.add('was-validated');
      const first=form.querySelector(':invalid');
      if(first) first.focus(); else box.scrollIntoView({block:'center'});
    }
  });
})();
</script>
<% } %>
