<%
  const canRent = product.Status === 'Còn trống' && product.Quantity > 0;
  // stock: [{ Size, Color, Quantity (shop có), free (còn trống theo ngày đã chọn | null), inCart }]
  const sizeTotal = s => stock.filter(v => v.Size === s).reduce((n, v) => n + v.Quantity, 0);
  const sizeFree = s => stock.filter(v => v.Size === s).reduce((n, v) => n + (v.free ?? v.Quantity), 0);
  const colorTotal = c => stock.filter(v => v.Color === c).reduce((n, v) => n + v.Quantity, 0);
  const onlySize = sizes.length === 1 ? sizes[0] : null, onlyColor = colors.length === 1 ? colors[0] : null;
  const pad2 = n => String(n).padStart(2, '0');
  const ymd = d => `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}`;
  const vnd = n => Number(n || 0).toLocaleString('vi-VN') + '₫';
  const typeLink = '/products?type=' + encodeURIComponent(product.ProductType || '');
%>
<div class="pd-wrap">
<nav class="pd-breadcrumb mb-4"><a href="/">Trang chủ</a> <i class="bi bi-chevron-right"></i> <a href="/products">Sản phẩm</a> <i class="bi bi-chevron-right"></i> <a href="<%= typeLink %>"><%= product.ProductType %></a> <i class="bi bi-chevron-right"></i> <strong><%= product.ProductName %></strong></nav>

<div class="row g-4 g-xl-5">
  <!-- ===== ẢNH: thumbnail dọc bên trái + ảnh lớn ===== -->
  <div class="col-lg-6">
    <div class="pd-gallery">
      <% if (images.length > 1) { %>
        <div class="pd-thumbs">
          <% images.forEach((src, i) => { %>
            <button type="button" class="gal-thumb <%= i === 0 ? 'active' : '' %>" data-i="<%= i %>"><img src="<%= src %>" alt="Ảnh <%= i + 1 %>" onerror="this.style.opacity=.3"></button>
          <% }) %>
        </div>
      <% } %>
      <div class="pd-main">
        <% if (images.length) { %>
          <img src="<%= images[0] %>" alt="<%= product.ProductName %>" id="mainImg" onerror="this.style.display='none'">
          <% if (images.length > 1) { %>
            <button type="button" class="gal-nav gal-prev" data-step="-1" aria-label="Ảnh trước"><i class="bi bi-chevron-left"></i></button>
            <button type="button" class="gal-nav gal-next" data-step="1" aria-label="Ảnh sau"><i class="bi bi-chevron-right"></i></button>
            <span class="gal-count badge bg-dark bg-opacity-75" id="galCount">1/<%= images.length %></span>
          <% } %>
        <% } else { %>
          <div class="d-flex align-items-center justify-content-center h-100"><i class="bi bi-image text-muted" style="font-size:3rem"></i></div>
        <% } %>
      </div>
    </div>
    <% if (images.length > 1) { %>
      <script>
      (function () {
        const imgs = <%- JSON.stringify(images).replace(/</g, '\\u003c') %>;
        const main = document.getElementById('mainImg'), cnt = document.getElementById('galCount');
        const thumbs = [...document.querySelectorAll('.pd-thumbs .gal-thumb')];
        let cur = 0;
        const go = (i) => { cur = (i + imgs.length) % imgs.length; main.src = imgs[cur]; main.style.display = '';
          cnt.textContent = `${cur + 1}/${imgs.length}`; thumbs.forEach((t, k) => t.classList.toggle('active', k === cur)); };
        thumbs.forEach(t => t.addEventListener('click', () => go(+t.dataset.i)));
        document.querySelectorAll('.pd-main .gal-nav').forEach(b => b.addEventListener('click', () => go(cur + +b.dataset.step)));
      })();
      </script>
    <% } %>
  </div>

  <!-- ===== THÔNG TIN + ĐẶT THUÊ ===== -->
  <div class="col-lg-6">
    <div class="pd-info">
      <a href="<%= typeLink %>" class="pd-type-chip"><%= product.ProductType %></a>
      <h1 class="pd-title"><%= product.ProductName %></h1>

      <!-- Giá + đánh giá cùng 1 hàng -->
      <div class="pd-price-line">
        <div class="pd-price-main"><%= vnd(priceOf(product)) %><span>/ ngày</span>
          <% if (saleOf(product) !== null) { %><s class="pd-old-price"><%= vnd(product.Price) %></s><span class="pd-sale-chip">-<%= salePercent(product) %>%</span><% } %></div>
        <a href="#reviews" class="pd-stars"><%- include('../partials/stars', { value: summary.count ? summary.avg : 0 }) %>
          <span><%= summary.count ? summary.avg + '/5 (' + summary.count + ' đánh giá)' : 'Chưa có đánh giá' %></span></a>
      </div>
      <% if (saleOf(product) !== null) { %>
        <div class="pd-sale-note"><i class="bi bi-lightning-charge-fill"></i> Đang khuyến mãi<%= product.SaleEnd ? ' đến hết ngày ' + viDate(String(product.SaleEnd).slice(0, 10)) : '' %></div>
      <% } %>
      <div class="pd-facts">
        <div class="pd-fact">
          <i class="bi bi-shield-check"></i>
          <div><span>Tiền cọc</span><strong><%= vnd(product.DepositValue) %></strong><small>Hoàn lại khi trả đồ</small></div>
        </div>
        <div class="pd-fact">
          <i class="bi bi-clock-history"></i>
          <div><span>Phí trả trễ</span><strong><%= vnd(product.LateFeePerDay) %></strong><small>Mỗi ngày trễ</small></div>
        </div>
        <% if (Number(product.ProductValue) > 0) { %>
        <div class="pd-fact">
          <i class="bi bi-gem"></i>
          <div><span>Giá trị sản phẩm</span><strong><%= vnd(product.ProductValue) %></strong><small>Đền khi mất / hư nặng</small></div>
        </div>
        <% } %>
      </div>
      <hr class="pd-hr">

      <% if (!canRent) { %>
        <div class="alert alert-warning">Sản phẩm hiện <strong><%= product.Status %></strong>, chưa thể đặt thuê. Vui lòng chọn mẫu khác.</div>
      <% } else { %>
        <!-- Chọn màu / size / số lượng rồi thêm vào giỏ thuê -->
        <form method="POST" action="/cart/add" id="addCartForm" novalidate>
          <input type="hidden" name="ProductID" value="<%= product.ProductID %>">

          <div class="pd-group">
            <div class="pd-group-label">Màu sắc: <strong id="colorName"><%= onlyColor || '' %></strong></div>
            <div class="d-flex flex-wrap gap-2 opt-group" data-opt="Color">
              <% colors.forEach((c, i) => { const off = !colorTotal(c); %>
                <input type="radio" class="btn-check" name="Color" id="color<%= i %>" value="<%= c %>" <%= off ? 'disabled' : '' %> <%= (onlyColor && !off) ? 'checked' : '' %>>
                <label class="pd-opt color-pill <%= off ? 'opt-off' : '' %>" for="color<%= i %>"><span class="color-dot" style="background:<%= colorHex(c) %>"></span><%= c %></label>
              <% }) %>
            </div>
            <div class="small text-danger mt-1 opt-msg" hidden>Vui lòng chọn màu sắc.</div>
          </div>

          <div class="pd-group">
            <div class="pd-group-label d-flex justify-content-between align-items-center">
              <span>Size: <strong id="sizeName"><%= onlySize || '' %></strong></span>
              <% if (chart.length) { %><a href="#" class="pd-guide-link" data-bs-toggle="modal" data-bs-target="#sizeChartModal"><i class="bi bi-rulers"></i> Bảng hướng dẫn chọn size</a><% } %>
            </div>
            <div class="d-flex flex-wrap gap-2 opt-group" data-opt="Size">
              <% sizes.forEach((sz, i) => { const total = sizeTotal(sz), free = sizeFree(sz); const off = !total || free <= 0; %>
                <input type="radio" class="btn-check" name="Size" id="size<%= i %>" value="<%= sz %>" <%= off ? 'disabled' : '' %> <%= (onlySize && !off) ? 'checked' : '' %>>
                <label class="pd-opt <%= off ? 'opt-off' : '' %>" for="size<%= i %>" title="<%= !total ? 'Shop không có size này' : off ? 'Đã có khách thuê trong ngày bạn chọn' : '' %>">
                  <%= sz %><% if (dates && total && free <= 0) { %> <small>· hết lịch</small><% } %>
                </label>
              <% }) %>
            </div>
            <div class="small text-danger mt-1 opt-msg" hidden>Vui lòng chọn size.</div>
          </div>

          <div class="pd-stock"><span class="dot"></span> <span id="comboInfo">Còn hàng — chọn ngày bên dưới để xem lịch trống</span></div>

          <div class="pd-buy-row">
            <div class="qty-box">
              <button type="button" data-d="-1" aria-label="Giảm">−</button>
              <input type="number" name="Quantity" id="qtyInput" value="1" min="1" step="1" required>
              <button type="button" data-d="1" aria-label="Tăng">+</button>
            </div>
            <button class="btn pd-btn pd-btn-add need-combo flex-grow-1"><i class="bi bi-bag-plus"></i> Thêm vào giỏ</button>
            <button class="btn pd-btn pd-btn-buy need-combo flex-grow-1" name="buyNow" value="1">Thuê ngay</button>
          </div>

          <!-- Mã giảm giá: chọn ở đây thì giỏ thuê tự điền sẵn -->
          <% if (promos.length) { %>
            <div class="pd-coupon-row">
              <i class="bi bi-ticket-perforated"></i>
              <select name="CouponCode" class="form-select form-select-sm">
                <option value="">Chọn mã giảm giá (không bắt buộc)</option>
                <% promos.forEach(c => { %><option value="<%= c.code %>" <%= savedCoupon === c.code ? 'selected' : '' %>><%= c.code %> · <%= c.text %></option><% }) %>
              </select>
            </div>
          <% } %>
          <% if (inCart) { %><div class="small text-muted mt-2"><i class="bi bi-bag-check"></i> Giỏ của bạn đã có <%= inCart %> <%= product.Unit %> mẫu này · <a href="/cart">Xem giỏ</a></div><% } %>
          <% if (!currentUser) { %><div class="small text-muted mt-2">Bạn có thể thêm vào giỏ trước, đăng nhập khi đặt thuê.</div><% } %>
        </form>

        <!-- Kiểm tra lịch trống

        <!-- Kiểm tra lịch trống: chỉ báo đã kín / còn trống khi khách chọn ngày -->
        <form method="GET" action="/products/<%= product.ProductID %>" class="pd-dates mt-3">
          <div class="pd-opt-label"><i class="bi bi-calendar-range" style="color:var(--gold)"></i> Kiểm tra lịch trống</div>
          <div class="d-flex flex-wrap align-items-end gap-2">
            <div>
              <label class="form-label text-muted mb-0" for="cStart">Ngày nhận</label>
              <input type="date" name="start" id="cStart" class="form-control" min="<%= ymd(new Date()) %>" value="<%= dates ? dates.start : '' %>" required>
            </div>
            <div>
              <label class="form-label text-muted mb-0" for="cEnd">Ngày trả</label>
              <input type="date" name="end" id="cEnd" class="form-control" min="<%= ymd(new Date(Date.now() + 864e5)) %>" value="<%= dates ? dates.end : '' %>" required>
            </div>
            <button class="btn btn-outline-primary">Kiểm tra</button>
          </div>
          <% if (dates && avail) { %>
            <% if (avail.free > 0) { %>
              <div class="mt-2 text-success"><i class="bi bi-check-circle-fill"></i>
                Từ <%= viDate(dates.start) %> đến <%= viDate(dates.end) %>: <%= sizes.length > 1 ? 'còn size ' + avail.freeSizes.join(', ') : 'mẫu này còn trống' %>.
                <% const full = sizes.filter(s => !avail.freeSizes.includes(s)); if (full.length && sizes.length > 1) { %><span class="text-muted">Size <%= full.join(', ') %> đã có khách thuê.</span><% } %>
              </div>
            <% } else { %>
              <div class="mt-2 text-danger"><i class="bi bi-x-circle-fill"></i> Mẫu này <strong>đã có khách thuê</strong> từ <%= viDate(dates.start) %> đến <%= viDate(dates.end) %>. Vui lòng chọn ngày khác.</div>
            <% } %>
          <% } else { %>
            <div class="mt-2 text-muted small">Chọn ngày nhận – ngày trả để biết size nào còn trống.</div>
          <% } %>
        </form>
      <% } %>

      <!-- Chia sẻ + yêu thích -->
      <div class="pd-share">
        <form method="POST" action="/favorites/<%= product.ProductID %>" class="d-inline">
          <input type="hidden" name="back" value="/products/<%= product.ProductID %>">
          <button class="btn btn-sm <%= isFav ? 'btn-danger' : 'btn-outline-danger' %>"><i class="bi <%= isFav ? 'bi-heart-fill' : 'bi-heart' %>"></i> <%= isFav ? 'Đã yêu thích' : 'Yêu thích' %></button>
        </form>
        <span class="text-muted ms-2">Chia sẻ:</span>
        <a href="#" id="shareFb" class="pd-share-btn" title="Chia sẻ Facebook"><i class="bi bi-facebook"></i></a>
        <button type="button" id="copyUrl" class="pd-share-btn" title="Sao chép đường dẫn"><i class="bi bi-link-45deg"></i></button>
        <% if (staff) { %><a href="/products/<%= product.ProductID %>/edit" class="btn btn-sm btn-outline-primary ms-auto"><i class="bi bi-pencil"></i> Sửa</a><% } %>
      </div>

      <!-- Chính sách thuê -->
      <div class="pd-box">
        <div class="pd-box-title"><i class="bi bi-shield-check"></i> Chính sách thuê</div>
        <div class="row g-2 pd-policy">
          <div class="col-sm-6"><i class="bi bi-stars"></i> Giặt hấp miễn phí sau mỗi lượt thuê</div>
          <div class="col-sm-6"><i class="bi bi-arrow-left-right"></i> <a href="/doi-size">Đổi size miễn phí</a> khi không vừa</div>
          <div class="col-sm-6"><i class="bi bi-cash-coin"></i> Hoàn cọc khi trả đồ đúng hạn, nguyên vẹn</div>
          <div class="col-sm-6"><i class="bi bi-truck"></i> Nhận tại cửa hàng hoặc giao tận nơi</div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ===== MÔ TẢ SẢN PHẨM (trái) + THÔNG TIN CHI TIẾT (phải) ===== -->
<section class="pd-lower mt-5">
  <div class="row g-4">
    <div class="col-lg-8">
      <div class="pd-card">
        <h4 class="pd-card-title">Mô tả sản phẩm</h4>
        <p class="pd-desc"><%= product.Description %></p>
        <% if (product.CareGuide) { %><p><strong>Quy cách vệ sinh:</strong> <%= product.CareGuide %></p><% } %>
        <p><strong>Thông tin size:</strong> <%= sizes.join(', ') %>.<% if (chart.length) { %> <a href="#" data-bs-toggle="modal" data-bs-target="#sizeChartModal">Xem bảng số đo (cm)</a><% } %></p>
        <% if (chart.length) { %>
          <p class="mb-1"><strong>Cách đo:</strong></p>
          <ul>
            <li>Ngực: đo quanh phần lớn nhất của vòng ngực.</li>
            <li>Eo: đo trên rốn 2–3 cm, điểm nhỏ nhất của bụng.</li>
            <li>Mông: đứng khép chân, đo vòng qua điểm to nhất của mông.</li>
          </ul>
        <% } %>
        <p class="mb-1"><strong>Cam kết:</strong></p>
        <ul class="mb-0">
          <li>Sản phẩm được giặt hấp, kiểm tra kỹ trước mỗi lượt thuê.</li>
          <li>Hỗ trợ <a href="/doi-size">đổi size miễn phí</a> nếu quý khách mặc không vừa.</li>
          <li>Hoàn cọc ngay khi trả đồ đúng hạn, nguyên vẹn — <a href="/noi-quy">xem nội quy &amp; bảng phí</a>.</li>
        </ul>
        <p class="mt-3 mb-0 fst-italic fw-semibold" style="color:var(--primary)">COSTUMEHUB — Mặc đẹp mỗi dịp, không cần mua.</p>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="pd-card">
        <h4 class="pd-card-title">Thông tin chi tiết</h4>
        <div class="pd-spec-list">
          <div><span>Mã sản phẩm</span><span>#<%= product.ProductID %></span></div>
          <div><span>Loại</span><span><%= product.ProductType %></span></div>
          <% DETAIL_FIELDS.filter(f => f.key !== 'CareGuide' && product[f.key]).forEach(f => { %><div><span><%= f.label %></span><span><%= product[f.key] %></span></div><% }) %>
          <div><span>Màu sắc</span><span><%= colors.join(', ') %></span></div>
          <div><span>Size</span><span><% sizes.forEach((s, i) => { %><%= i ? ', ' : '' %><%= s %><% if (staff) { %> (<%= sizeTotal(s) %>)<% } %><% }) %></span></div>
          <div><span>Đơn vị thuê</span><span><%= product.Unit %></span></div>
          <% if (staff) { %><div><span>Số bộ cửa hàng có <span class="badge bg-light text-muted border">NV</span></span><span><%= product.Quantity %> <%= product.Unit %></span></div><% } %>
        </div>
      </div>
      <div class="pd-card mt-4">
        <h4 class="pd-card-title">Hướng dẫn thuê</h4>
        <ol class="pd-guide mb-2">
          <li>Chọn kích thước, màu sắc, kiểm tra lịch trống.</li>
          <li>Thêm vào giỏ / Thuê ngay, nhập thông tin.</li>
          <li>Cọc trong 24 giờ để giữ chỗ.</li>
          <li>Nhận đồ, thử ngay — không vừa được đổi size.</li>
          <li>Trả đúng hạn, nhận lại tiền cọc.</li>
        </ol>
        <a href="/cach-thue">Xem chi tiết <i class="bi bi-arrow-right"></i></a>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/reviews') %>

<%- include('../partials/product-faq') %>


<!-- ===== SẢN PHẨM TƯƠNG TỰ ===== -->
<% if (related.length) { %>
<section class="mt-5">
  <div class="pd-section-head"><h3>Sản phẩm tương tự</h3><a href="<%= typeLink %>">Xem tất cả <i class="bi bi-arrow-right"></i></a></div>
  <div class="row g-3 prod-grid">
    <% related.forEach(p => { %>
      <div class="col-6 col-md-4 col-xl-3 col-xxl-20"><%- include('../partials/product-card', { p, rt: cardRatings[p.ProductID], fav: favs.has(p.ProductID), hot: hot.has(p.ProductID), back: '/products/' + product.ProductID }) %></div>
    <% }) %>
  </div>
</section>
<% } %>


<!-- ===== SẢN PHẨM ĐÃ XEM ===== -->
<% if (viewed.length) { %>
<section class="mt-5">
  <div class="pd-section-head"><h3>Sản phẩm đã xem</h3></div>
  <div class="row g-3 prod-grid">
    <% viewed.forEach(p => { %>
      <div class="col-6 col-md-4 col-xl-3 col-xxl-20"><%- include('../partials/product-card', { p, rt: cardRatings[p.ProductID], fav: favs.has(p.ProductID), hot: hot.has(p.ProductID), back: '/products/' + product.ProductID }) %></div>
    <% }) %>
  </div>
</section>
<% } %>

<% if (chart.length) { %>
<!-- BẢNG SỐ ĐO: cửa sổ nhỏ, mở từ link "Bảng số đo" cạnh dòng Kích thước -->
<div class="modal fade" id="sizeChartModal" tabindex="-1" aria-label="Bảng số đo">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title"><i class="bi bi-rulers" style="color:var(--gold)"></i> Bảng số đo — <%= product.ProductName %></h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
    <div class="modal-body">
        <div class="row g-4">
          <div class="col-lg-7">
            <div class="table-responsive">
              <table class="table table-bordered text-center size-chart mb-2">
                <thead class="table-light"><tr><th>Size</th><% CHART_FIELDS.forEach(f => { %><th><%= f.label %> (cm)</th><% }) %></tr></thead>
                <tbody>
                  <% chart.forEach(r => { %><tr><th><%= r.size %></th><% CHART_FIELDS.forEach(f => { %><td><%= r[f.key] || '—' %></td><% }) %></tr><% }) %>
                </tbody>
              </table>
            </div>
            <% if (summary.count && (summary.fit['Hơi chật'] || summary.fit['Hơi rộng'] || summary.fit['Vừa'])) { %>
              <div class="text-muted">Khách đã thuê nhận xét: <%= summary.fit['Vừa'] %> vừa · <%= summary.fit['Hơi chật'] %> hơi chật · <%= summary.fit['Hơi rộng'] %> hơi rộng.</div>
            <% } %>
            <div class="text-muted">Số đo giữa 2 size: chọn size lớn hơn. Không vừa? Xem <a href="/doi-size">chính sách đổi size</a>.</div>
          </div>
          <div class="col-lg-5"><%- include('../partials/measure-guide') %></div>
        </div>
    </div>
  </div></div>
</div>
<% } %>



<script>
(function () {
  // Chia sẻ
  const url = location.origin + '/products/<%= product.ProductID %>';
  const fb = document.getElementById('shareFb');
  if (fb) fb.href = 'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(url), fb.target = '_blank', fb.rel = 'noopener';
  const cp = document.getElementById('copyUrl');
  if (cp) cp.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(url); cp.innerHTML = '<i class="bi bi-check2"></i>'; setTimeout(() => { cp.innerHTML = '<i class="bi bi-link-45deg"></i>'; }, 1500); } catch (_) { prompt('Sao chép đường dẫn:', url); }
  });
})();
</script>

<% if (canRent) { %>
<script>
(function () {
  // Ngày trả luôn sau ngày nhận, tối đa <%= MAX_RENT_DAYS %> ngày
  const s = document.getElementById('cStart'), e = document.getElementById('cEnd');
  const add = (v, n) => { const d = new Date(v); d.setDate(d.getDate() + n); return d.toISOString().slice(0, 10); };
  s.addEventListener('change', () => {
    if (!s.value) return;
    e.min = add(s.value, 1); e.max = add(s.value, <%= MAX_RENT_DAYS %>);
    if (!e.value || e.value <= s.value || e.value > e.max) e.value = add(s.value, 1);
  });

  // Tồn kho theo size × màu: chọn size -> chỉ bật màu còn bộ của size đó (và ngược lại)
  const STOCK = <%- JSON.stringify(stock).replace(/</g, '\\u003c') %>;
  const unit = <%- JSON.stringify(product.Unit).replace(/</g, '\\u003c') %>, hasDates = <%= dates ? 'true' : 'false' %>, STAFF = <%= staff ? 'true' : 'false' %>;
  const PRICE = '<%= vnd(priceOf(product)) %>';
  const form = document.getElementById('addCartForm');
  const qty = document.getElementById('qtyInput'), info = document.getElementById('comboInfo');
  const picked = (name) => { const r = form.querySelector(`input[name="${name}"]:checked`); return r ? r.value : null; };
  const canUse = (v) => v.Quantity > 0 && (v.free === null || v.free > 0);
  function refresh() {
    const size = picked('Size'), color = picked('Color');
    form.querySelectorAll('input[name="Color"]').forEach(r => {
      const ok = STOCK.some(v => v.Color === r.value && canUse(v) && (!size || v.Size === size));
      r.disabled = !ok; r.nextElementSibling.classList.toggle('opt-off', !ok);
      if (!ok && r.checked) r.checked = false;
    });
    form.querySelectorAll('input[name="Size"]').forEach(r => {
      const ok = STOCK.some(v => v.Size === r.value && canUse(v) && (!color || v.Color === color));
      r.disabled = !ok; r.nextElementSibling.classList.toggle('opt-off', !ok);
    });
    const col = picked('Color');
    document.getElementById('sizeName').textContent = size || '';
    document.getElementById('colorName').textContent = col || '';
    const c = size && col ? STOCK.find(v => v.Size === size && v.Color === col) : null;
    if (c) {
      const max = Math.max(0, Math.min(c.Quantity - c.inCart, c.free === null ? Infinity : c.free - c.inCart));
      qty.max = max || 1;
      if (+qty.value > max) qty.value = Math.max(1, max);
      // Khách không thấy số bộ cửa hàng có; nhân viên thì thấy
      <% if (staff) { %>
      info.textContent = `Size ${c.Size} – ${c.Color}: shop có ${c.Quantity} ${unit}` + (hasDates ? `, còn ${c.free} ${unit} trống trong ngày bạn chọn` : '') + (c.inCart ? ` (giỏ đã có ${c.inCart})` : '') + '.';
      <% } else { %>
      info.textContent = (hasDates ? 'Còn trống trong ngày bạn chọn' : 'Còn hàng') + (c.inCart ? ` · giỏ đã có ${c.inCart} ${unit}` : '');
      <% } %>
      form.querySelectorAll('.need-combo').forEach(b => { b.disabled = max <= 0; });
      if (max <= 0) info.textContent += ' Bạn đã chọn hết số bộ có thể thuê của size này.';
    } else {
      info.textContent = hasDates ? 'Còn hàng trong ngày bạn chọn — chọn màu và size' : 'Còn hàng — chọn ngày bên dưới để xem lịch trống';
      form.querySelectorAll('.need-combo').forEach(b => { b.disabled = false; });
    }
    form.querySelectorAll('.opt-group').forEach(g => { if (g.querySelector('input:checked')) g.nextElementSibling.hidden = true; });
  }
  form.addEventListener('change', refresh);
  // Nút − / + số lượng
  form.querySelectorAll('.qty-box button').forEach(b => b.addEventListener('click', () => {
    const max = +qty.max || 99;
    qty.value = Math.min(max, Math.max(1, (+qty.value || 1) + +b.dataset.d));
  }));
  form.addEventListener('submit', function (ev) {
    let ok = true;
    this.querySelectorAll('.opt-group').forEach(g => {
      const has = !!g.querySelector('input:checked');
      g.nextElementSibling.hidden = has;
      if (!has) ok = false;
    });
    if (!ok) ev.preventDefault();
  });
  refresh();
})();
</script>
<% } %>
</div><!-- /.pd-wrap -->
