<%
  // Trạng thái lọc hiện tại -> tạo link giữ nguyên các bộ lọc khác (đổi 1 bộ lọc / sang trang)
  const state = { type, cat, q, size, color, price, sort, free: onlyFree ? '1' : '', sale: onSale ? '1' : '' };
  const u = (over = {}) => {
    const s = { ...state, ...over };
    const qs = Object.entries(s).filter(([, v]) => v !== '' && v != null).map(([k, v]) => `${k}=${encodeURIComponent(v)}`).join('&');
    return '/products' + (qs ? '?' + qs : '');
  };
  const pad2 = n => String(n).padStart(2, '0');
  const ymd = d => `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}`;
  const todayYmd = ymd(new Date()), tmrYmd = ymd(new Date(Date.now() + 864e5));
  const subOf = (g) => (CAT_GROUPS.find(x => x.group === g) || { items: [] }).items;
  const title = catLabel || type || 'Tất cả sản phẩm';
  const hidden = (skip = []) => Object.entries(state).filter(([k, v]) => v && !skip.includes(k));
  const anyFilter = type || cat || q || size || color || price || dates || onlyFree || onSale;
%>
<nav class="small text-muted mb-3"><a href="/" class="text-muted">Trang chủ</a> / <a href="/products?clear=1" class="text-muted">Sản phẩm</a><% if (type || cat) { %> / <span><%= title %></span><% } %></nav>

<div class="row g-4">
  <!-- ===== CỘT LỌC BÊN TRÁI ===== -->
  <aside class="col-lg-3 col-xxl-2 shop-aside">
    <button class="btn btn-light border w-100 d-lg-none mb-2" type="button" data-bs-toggle="collapse" data-bs-target="#filters"><i class="bi bi-funnel"></i> Bộ lọc</button>
    <div class="collapse d-lg-block shop-filters" id="filters">
      <!-- Danh mục -->
      <div class="filter-box">
        <div class="filter-title">Danh mục</div>
        <a href="<%= u({ type: '', cat: '' }) %>" class="filter-link <%= !type && !cat ? 'on' : '' %>">Tất cả</a>
        <% COSTUME_TYPES.forEach(t => { %>
          <a href="<%= u({ type: t, cat: '' }) %>" class="filter-link <%= type === t && !cat ? 'on' : '' %>"><%= t %></a>
        <% }) %>
        <% const pkOpen = type === 'Phụ kiện' || !!cat; %>
        <!-- Phụ kiện: thu gọn, bấm mới xổ các mục con (đang xem phụ kiện thì mở sẵn) -->
        <a href="#pkSub" class="filter-link <%= type === 'Phụ kiện' && !cat ? 'on' : '' %> <%= pkOpen ? '' : 'collapsed' %>" data-bs-toggle="collapse" role="button" aria-expanded="<%= pkOpen %>">Phụ kiện <i class="bi bi-chevron-down filter-caret"></i></a>
        <div class="filter-sub collapse <%= pkOpen ? 'show' : '' %>" id="pkSub">
          <a href="<%= u({ type: 'Phụ kiện', cat: '' }) %>" class="filter-link <%= type === 'Phụ kiện' && !cat ? 'on' : '' %>">Tất cả phụ kiện</a>
          <% subOf('Phụ kiện').forEach(c => { %>
            <a href="<%= u({ type: '', cat: c.key }) %>" class="filter-link <%= cat === c.key ? 'on' : '' %>"><%= c.label %></a>
          <% }) %>
        </div>
      </div>

      <!-- Ngày thuê: chỉ khi chọn ngày mới báo còn trống / đã kín -->
      <form method="GET" action="/products" class="filter-box">
        <% hidden(['free']).forEach(([k, v]) => { %><input type="hidden" name="<%= k %>" value="<%= v %>"><% }) %>
        <div class="filter-title"><i class="bi bi-calendar-range" style="color:var(--gold)"></i> Ngày thuê</div>
        <div class="row g-2">
          <div class="col-6 col-lg-12">
            <label class="form-label small text-muted mb-0" for="fStart">Ngày nhận</label>
            <input type="date" name="start" id="fStart" class="form-control form-control-sm" min="<%= todayYmd %>" value="<%= dates ? dates.start : '' %>" required>
          </div>
          <div class="col-6 col-lg-12">
            <label class="form-label small text-muted mb-0" for="fEnd">Ngày trả</label>
            <input type="date" name="end" id="fEnd" class="form-control form-control-sm" min="<%= tmrYmd %>" value="<%= dates ? dates.end : '' %>" required>
          </div>
        </div>
        <div class="form-check mt-2">
          <input class="form-check-input" type="checkbox" name="free" value="1" id="fFree" <%= onlyFree ? 'checked' : '' %>>
          <label class="form-check-label small" for="fFree">Chỉ hiện mẫu còn trống</label>
        </div>
        <button class="btn btn-primary btn-sm w-100 mt-2">Xem lịch trống</button>
        <% if (dates) { %>
          <div class="small mt-2 text-success-emphasis"><i class="bi bi-check-circle-fill text-success"></i> <%= viDate(dates.start) %> → <%= viDate(dates.end) %> (<%= rentDays %> ngày). Tự điền khi đặt thuê.</div>
          <a href="/products?clear=1<%= u({}).replace('/products', '').replace('?', '&') %>" class="small"><i class="bi bi-x"></i> Bỏ chọn ngày</a>
        <% } else { %>
          <div class="small text-muted mt-2">Chọn ngày để biết mẫu nào đã có người thuê.</div>
        <% } %>
      </form>

      <!-- Kích thước + Màu sắc: chỉ hiện tiêu đề, bấm mới xổ danh sách (đang lọc thì mở sẵn) -->
      <% if (sizeOptions.length) { %>
      <div class="filter-box">
        <a href="#sizeBox" class="filter-title filter-toggle <%= size ? '' : 'collapsed' %>" data-bs-toggle="collapse" role="button" aria-expanded="<%= !!size %>">
          <span>Kích thước<% if (size) { %>: <span style="color:var(--primary)"><%= size %></span><% } %></span> <i class="bi bi-chevron-down filter-caret"></i></a>
        <div class="collapse <%= size ? 'show' : '' %>" id="sizeBox">
          <div class="d-flex flex-wrap gap-1 pt-2">
            <% sizeOptions.forEach(s => { %>
              <a href="<%= u({ size: size === s ? '' : s }) %>" class="filter-chip <%= size === s ? 'on' : '' %>"><%= s %></a>
            <% }) %>
          </div>
          <% if (dates && !size) { %><div class="small text-muted mt-2">Chọn size để xem chính xác size đó còn trống không.</div><% } %>
        </div>
      </div>
      <% } %>

      <% if (colorOptions.length) { %>
      <div class="filter-box">
        <a href="#colorBox" class="filter-title filter-toggle <%= color ? '' : 'collapsed' %>" data-bs-toggle="collapse" role="button" aria-expanded="<%= !!color %>">
          <span>Màu sắc<% if (color) { %>: <span style="color:var(--primary)"><%= color %></span><% } %></span> <i class="bi bi-chevron-down filter-caret"></i></a>
        <div class="collapse <%= color ? 'show' : '' %>" id="colorBox">
          <div class="d-flex flex-wrap gap-1 pt-2">
            <% colorOptions.forEach(c => { %>
              <a href="<%= u({ color: color === c ? '' : c }) %>" class="filter-chip color-pill <%= color === c ? 'on' : '' %>"><span class="color-dot" style="background:<%= colorHex(c) %>"></span><%= c %></a>
            <% }) %>
          </div>
        </div>
      </div>
      <% } %>

      <!-- Khuyến mãi -->
      <div class="filter-box">
        <a href="<%= u({ sale: onSale ? '' : '1' }) %>" class="filter-link <%= onSale ? 'on' : '' %>"><span><i class="bi <%= onSale ? 'bi-check-square-fill' : 'bi-tag' %> me-2"></i>Đang giảm giá</span></a>
      </div>

      <!-- Giá thuê -->
      <div class="filter-box">
        <div class="filter-title">Giá thuê / ngày</div>
        <% PRICE_RANGES.forEach(r => { %>
          <a href="<%= u({ price: price === r.key ? '' : r.key }) %>" class="filter-link <%= price === r.key ? 'on' : '' %>"><i class="bi <%= price === r.key ? 'bi-check-square-fill' : 'bi-square' %> me-2"></i><%= r.label %></a>
        <% }) %>
      </div>

      <% if (anyFilter) { %><a href="/products?clear=1" class="btn btn-outline-primary w-100"><i class="bi bi-x-circle"></i> Xóa tất cả bộ lọc</a><% } %>
    </div>
  </aside>

  <!-- ===== LƯỚI SẢN PHẨM ===== -->
  <section class="col-lg-9 col-xxl-10 shop-main">
    <h4 class="mb-3 font-serif"><%= title %><% if (q) { %> <small class="text-muted fs-6 fw-normal">— kết quả cho "<%= q %>"</small><% } %></h4>
    <!-- Tìm kiếm + Sắp xếp cùng 1 hàng -->
    <div class="shop-toolbar mb-3">
      <form method="GET" action="/products" class="shop-search">
        <% hidden(['q']).forEach(([k, v]) => { %><input type="hidden" name="<%= k %>" value="<%= v %>"><% }) %>
        <div class="input-group">
          <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
          <input type="search" name="q" value="<%= q %>" class="form-control" placeholder="Tìm áo dài, váy tiệc, phụ kiện... (gõ không dấu cũng được)">
          <button class="btn btn-primary px-4">Tìm kiếm</button>
        </div>
      </form>
      <div class="d-flex align-items-center gap-2 shop-sort">
        <label for="sortSel" class="text-muted text-nowrap mb-0">Sắp xếp:</label>
        <select id="sortSel" class="form-select" onchange="location.href=this.value">
          <% SORTS.forEach(s => { %><option value="<%= u({ sort: s.key }) %>" <%= sort === s.key ? 'selected' : '' %>><%= s.label %></option><% }) %>
        </select>
      </div>
    </div>

    <!-- Bộ lọc đang chọn -->
    <% const chips = [];
       if (q) chips.push(['Từ khóa: ' + q, { q: '' }]);
       if (size) chips.push(['Size ' + size, { size: '' }]);
       if (color) chips.push(['Màu ' + color, { color: '' }]);
       if (price) chips.push([PRICE_RANGES.find(r => r.key === price).label, { price: '' }]);
       if (onlyFree) chips.push(['Chỉ mẫu còn trống', { free: '' }]);
       if (onSale) chips.push(['Đang giảm giá', { sale: '' }]); %>
    <% if (chips.length) { %>
      <div class="d-flex flex-wrap gap-2 mb-3">
        <% chips.forEach(([label, over]) => { %><a href="<%= u(over) %>" class="active-chip"><%= label %> <i class="bi bi-x"></i></a><% }) %>
      </div>
    <% } %>

    <div class="row g-3 prod-grid">
      <% if (products.length === 0) { %>
        <div class="col-12 text-center text-muted py-5">
          <i class="bi bi-search" style="font-size:2.5rem"></i>
          <p class="mt-2">Không tìm thấy trang phục phù hợp.</p>
          <a href="/products?clear=1" class="btn btn-outline-primary">Xem tất cả</a>
        </div>
      <% } %>

      <% products.forEach(p => { %>
        <div class="col-6 col-md-4 col-xl-3 col-xxl-20">
          <%- include('../partials/product-card', { p, tag: tags[p.ProductID], rt: ratings[p.ProductID], fav: favSet.has(p.ProductID), hot: hot.has(p.ProductID), back: reqUrl }) %>
        </div>
      <% }) %>
    </div>

    <!-- Phân trang -->
    <% if (totalPages > 1) { %>
    <nav class="d-flex justify-content-center mt-4">
      <ul class="pagination mb-0">
        <li class="page-item <%= page <= 1 ? 'disabled' : '' %>"><a class="page-link" href="<%= u({ page: page - 1 }) %>">«</a></li>
        <% for (let i = 1; i <= totalPages; i++) { %>
          <li class="page-item <%= i === page ? 'active' : '' %>"><a class="page-link" href="<%= u({ page: i }) %>"><%= i %></a></li>
        <% } %>
        <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>"><a class="page-link" href="<%= u({ page: page + 1 }) %>">»</a></li>
      </ul>
    </nav>
    <% } %>
  </section>
</div>

<script>
  // Ngày trả luôn sau ngày nhận, tối đa <%= MAX_RENT_DAYS %> ngày
  (function () {
    const s = document.getElementById('fStart'), e = document.getElementById('fEnd');
    const add = (v, n) => { const d = new Date(v); d.setDate(d.getDate() + n); return d.toISOString().slice(0, 10); };
    s.addEventListener('change', () => {
      if (!s.value) return;
      e.min = add(s.value, 1); e.max = add(s.value, <%= MAX_RENT_DAYS %>);
      if (!e.value || e.value <= s.value || e.value > e.max) e.value = add(s.value, 1);
    });
  })();
</script>


