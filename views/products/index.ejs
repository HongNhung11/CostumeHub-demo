<!-- Banner nhỏ -->
<div class="rounded-4 p-4 p-md-5 mb-4 text-white position-relative overflow-hidden shop-banner"
     style="background:linear-gradient(90deg,rgba(44,36,32,.85),rgba(138,46,59,.45)),url('/img/vaytiec/v5.jpg') center 25%/cover">
  <div class="section-eyebrow mb-1" style="color:var(--gold)">Bộ sưu tập</div>
  <h1 class="font-serif mb-2">Trang phục nữ &amp; Phụ kiện</h1>
  <p class="mb-3" style="max-width:520px;color:#efe6d9">Áo dài · Váy tiệc – đầm dạ hội · Phụ kiện. Chọn theo danh mục bên dưới, hoặc tìm nhanh mẫu bạn cần.</p>
  <form method="GET" action="/products" class="d-flex" style="max-width:460px">
    <% if (type) { %><input type="hidden" name="type" value="<%= type %>"><% } %>
    <input type="search" name="q" value="<%= q %>" class="form-control form-control-lg" placeholder="Tìm áo dài, váy tiệc, phụ kiện... (gõ không dấu cũng được)">
    <button class="btn btn-gold btn-lg ms-2"><i class="bi bi-search"></i></button>
  </form>
</div>

<!-- Menu danh mục -->
<div class="d-flex flex-wrap gap-2 align-items-center mb-4">
  <a href="/products" class="btn btn-sm <%= !type ? 'btn-primary' : 'btn-light' %>">
    Tất cả <span class="badge badge-soft ms-1"><%= totalAll %></span>
  </a>

  <span class="text-muted small ms-2 me-1 d-none d-md-inline">Trang phục:</span>
  <% COSTUME_TYPES.forEach(t => { %>
    <a href="/products?type=<%= encodeURIComponent(t) %>" class="btn btn-sm <%= type===t ? 'btn-primary' : 'btn-light' %>">
      <%= t %> <span class="badge badge-soft ms-1"><%= counts[t] || 0 %></span>
    </a>
  <% }) %>

  <span class="text-muted small ms-2 me-1 d-none d-md-inline">· Phụ kiện:</span>
  <% ACCESSORY_TYPES.forEach(t => { %>
    <a href="/products?type=<%= encodeURIComponent(t) %>" class="btn btn-sm <%= type===t ? 'btn-gold' : 'btn-light' %>">
      <i class="bi bi-gem"></i> <%= t %> <span class="badge badge-soft ms-1"><%= counts[t] || 0 %></span>
    </a>
  <% }) %>
</div>

<!-- Chọn ngày thuê: chỉ khi khách chọn ngày mới hiện còn trống / đã kín -->
<%
  const pad2 = n => String(n).padStart(2, '0');
  const ymd = d => `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}`;
  const todayYmd = ymd(new Date()), tmrYmd = ymd(new Date(Date.now() + 864e5));
%>
<form method="GET" action="/products" class="card p-3 mb-4 date-filter">
  <% if (type) { %><input type="hidden" name="type" value="<%= type %>"><% } %>
  <% if (q) { %><input type="hidden" name="q" value="<%= q %>"><% } %>
  <div class="d-flex flex-wrap align-items-end gap-2">
    <div class="me-2">
      <div class="fw-semibold small"><i class="bi bi-calendar-range" style="color:var(--gold)"></i> Bạn muốn thuê ngày nào?</div>
      <div class="small text-muted">Chọn ngày để xem mẫu nào còn trống</div>
    </div>
    <div>
      <label class="form-label small text-muted mb-0" for="fStart">Ngày nhận</label>
      <input type="date" name="start" id="fStart" class="form-control form-control-sm" min="<%= todayYmd %>" value="<%= dates ? dates.start : '' %>" required>
    </div>
    <div>
      <label class="form-label small text-muted mb-0" for="fEnd">Ngày trả</label>
      <input type="date" name="end" id="fEnd" class="form-control form-control-sm" min="<%= tmrYmd %>" value="<%= dates ? dates.end : '' %>" required>
    </div>
    <div class="form-check mb-1 ms-1">
      <input class="form-check-input" type="checkbox" name="free" value="1" id="fFree" <%= onlyFree ? 'checked' : '' %>>
      <label class="form-check-label small" for="fFree">Chỉ hiện mẫu còn trống</label>
    </div>
    <button class="btn btn-primary btn-sm"><i class="bi bi-search"></i> Xem lịch trống</button>
    <% if (dates) { %>
      <a href="/products?clear=1<%= type ? '&type=' + encodeURIComponent(type) : '' %><%= q ? '&q=' + encodeURIComponent(q) : '' %>" class="btn btn-light btn-sm"><i class="bi bi-x-lg"></i> Bỏ chọn ngày</a>
    <% } %>
  </div>
  <% if (dates) { %>
    <div class="small mt-2 text-success-emphasis">
      <i class="bi bi-check-circle-fill text-success"></i>
      Đang xem lịch trống từ <strong><%= viDate(dates.start) %></strong> đến <strong><%= viDate(dates.end) %></strong> (<%= rentDays %> ngày).
      Ngày này sẽ tự điền khi bạn đặt thuê.
    </div>
  <% } %>
</form>
<script>
  // Ngày trả luôn sau ngày nhận, tối đa <%= MAX_RENT_DAYS %> ngày
  (function () {
    const s = document.getElementById('fStart'), e = document.getElementById('fEnd');
    const add = (v, n) => { const d = new Date(v); d.setDate(d.getDate() + n); return d.toISOString().slice(0, 10); };
    s.addEventListener('change', () => {
      if (!s.value) return;
      e.min = add(s.value, 1); e.max = add(s.value, <%= MAX_RENT_DAYS %>);
      if (!e.value || e.value <= s.value || e.value > e.max) e.value = add(s.value, 1);
    });
  })();
</script>

<!-- Tiêu đề kết quả -->
<div class="d-flex justify-content-between align-items-center mb-3">
  <h5 class="mb-0 font-serif"><%= type ? type : 'Tất cả sản phẩm' %>
    <small class="text-muted">(<%= count %> mẫu<%= q ? ' cho "'+q+'"' : '' %>)</small>
  </h5>
  <% if (q) { %>
    <a href="/products<%= type ? '?type=' + encodeURIComponent(type) : '' %>" class="btn btn-outline-primary btn-sm">
      <i class="bi bi-arrow-left"></i> Quay lại danh sách
    </a>
  <% } %>
</div>

<!-- Lưới thẻ sản phẩm -->
<div class="row g-3 g-md-4">
  <% if (products.length === 0) { %>
    <div class="col-12 text-center text-muted py-5">
      <i class="bi bi-search" style="font-size:2.5rem"></i>
      <p class="mt-2">Không tìm thấy trang phục phù hợp.</p>
      <a href="/products" class="btn btn-outline-primary">Xem tất cả</a>
    </div>
  <% } %>

  <% products.forEach(p => { const free = avail ? avail[p.ProductID] : null; %>
    <div class="col-6 col-md-4 col-lg-3">
      <div class="card prod-card h-100 reveal <%= free === 0 ? 'is-booked' : '' %>">
        <a href="/products/<%= p.ProductID %>" class="prod-thumb d-block">
          <% if (p.PathImage) { %>
            <img src="<%= p.PathImage %>" alt="<%= p.ProductName %>" onerror="this.style.display='none'">
          <% } %>
          <span class="prod-badge chip"><%= p.ProductType %></span>
          <% if (free === 0) { %>
            <span class="position-absolute top-0 end-0 m-2 badge bg-dark"><i class="bi bi-calendar-x"></i> Đã kín lịch</span>
          <% } else if (free !== null) { %>
            <span class="position-absolute top-0 end-0 m-2 badge bg-success"><i class="bi bi-calendar-check"></i> Còn <%= free %> <%= p.Unit %></span>
          <% } %>
        </a>
        <div class="card-body p-3 d-flex flex-column">
          <h6 class="mb-1" style="min-height:2.6em;font-size:.95rem;line-height:1.3">
            <a href="/products/<%= p.ProductID %>" class="text-dark"><%= p.ProductName %></a>
          </h6>
          <div class="price-tag mb-2"><%= Number(p.Price).toLocaleString('vi-VN') %> đ<small class="text-muted fw-normal">/ngày</small></div>
          <div class="mt-auto d-flex gap-1">
            <a href="/products/<%= p.ProductID %>" class="btn btn-sm btn-outline-primary flex-grow-1">Chi tiết</a>
            <a href="/products/<%= p.ProductID %>" class="btn btn-sm btn-primary" title="Đặt thuê"><i class="bi bi-calendar-check"></i></a>
          </div>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<!-- Phân trang -->
<% if (totalPages > 1) { %>
<nav class="d-flex justify-content-center mt-4">
  <ul class="pagination mb-0">
    <li class="page-item <%= page<=1?'disabled':'' %>"><a class="page-link" href="?page=<%= page-1 %>&type=<%= encodeURIComponent(type) %>&q=<%= encodeURIComponent(q) %><%= onlyFree ? '&free=1' : '' %>">«</a></li>
    <% for (let i=1;i<=totalPages;i++){ %>
      <li class="page-item <%= i===page?'active':'' %>"><a class="page-link" href="?page=<%= i %>&type=<%= encodeURIComponent(type) %>&q=<%= encodeURIComponent(q) %><%= onlyFree ? '&free=1' : '' %>"><%= i %></a></li>
    <% } %>
    <li class="page-item <%= page>=totalPages?'disabled':'' %>"><a class="page-link" href="?page=<%= page+1 %>&type=<%= encodeURIComponent(type) %>&q=<%= encodeURIComponent(q) %><%= onlyFree ? '&free=1' : '' %>">»</a></li>
  </ul>
</nav>
<% } %>
