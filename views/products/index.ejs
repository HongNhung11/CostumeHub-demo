<!-- Banner nhỏ -->
<div class="rounded-4 p-4 p-md-5 mb-4 text-white position-relative overflow-hidden shop-banner"
     style="background:linear-gradient(90deg,rgba(44,36,32,.85),rgba(138,46,59,.45)),url('/img/vaytiec/v5.jpg') center 25%/cover">
  <div class="section-eyebrow mb-1" style="color:var(--gold)">Bộ sưu tập</div>
  <h1 class="font-serif mb-2">Trang phục nữ &amp; Phụ kiện</h1>
  <p class="mb-3" style="max-width:520px;color:#efe6d9">Áo dài · Váy tiệc – đầm dạ hội · Phụ kiện. Chọn theo danh mục bên dưới, hoặc tìm nhanh mẫu bạn cần.</p>
  <form method="GET" action="/products" class="d-flex" style="max-width:460px">
    <input type="search" name="q" value="<%= q %>" class="form-control form-control-lg" placeholder="Tìm áo dài, váy tiệc, phụ kiện...">
    <button class="btn btn-gold btn-lg ms-2"><i class="bi bi-search"></i></button>
  </form>
</div>

<!-- Menu danh mục -->
<div class="d-flex flex-wrap gap-2 align-items-center mb-4">
  <a href="/products" class="btn btn-sm <%= !type ? 'btn-primary' : 'btn-light' %>">
    Tất cả <span class="badge badge-soft ms-1"><%= totalAll %></span>
  </a>

  <span class="text-muted small ms-2 me-1 d-none d-md-inline">Trang phục:</span>
  <% COSTUME_TYPES.forEach(t => { %>
    <a href="/products?type=<%= encodeURIComponent(t) %>" class="btn btn-sm <%= type===t ? 'btn-primary' : 'btn-light' %>">
      <%= t %> <span class="badge badge-soft ms-1"><%= counts[t] || 0 %></span>
    </a>
  <% }) %>

  <span class="text-muted small ms-2 me-1 d-none d-md-inline">· Phụ kiện:</span>
  <% ACCESSORY_TYPES.forEach(t => { %>
    <a href="/products?type=<%= encodeURIComponent(t) %>" class="btn btn-sm <%= type===t ? 'btn-gold' : 'btn-light' %>">
      <i class="bi bi-gem"></i> <%= t %> <span class="badge badge-soft ms-1"><%= counts[t] || 0 %></span>
    </a>
  <% }) %>
</div>

<!-- Tiêu đề kết quả -->
<div class="d-flex justify-content-between align-items-center mb-3">
  <h5 class="mb-0 font-serif"><%= type ? type : 'Tất cả sản phẩm' %>
    <small class="text-muted">(<%= count %> mẫu<%= q ? ' cho "'+q+'"' : '' %>)</small>
  </h5>
</div>

<!-- Lưới thẻ sản phẩm -->
<div class="row g-3 g-md-4">
  <% if (products.length === 0) { %>
    <div class="col-12 text-center text-muted py-5">
      <i class="bi bi-search" style="font-size:2.5rem"></i>
      <p class="mt-2">Không tìm thấy trang phục phù hợp.</p>
      <a href="/products" class="btn btn-outline-primary">Xem tất cả</a>
    </div>
  <% } %>

  <% products.forEach(p => { %>
    <div class="col-6 col-md-4 col-lg-3">
      <div class="card prod-card h-100 reveal">
        <a href="/products/<%= p.ProductID %>" class="prod-thumb d-block">
          <% if (p.PathImage) { %>
            <img src="<%= p.PathImage %>" alt="<%= p.ProductName %>" onerror="this.style.display='none'">
          <% } %>
          <span class="prod-badge chip"><%= p.ProductType %></span>
          <% if (p.Status !== 'Còn trống') { %>
            <span class="position-absolute top-0 end-0 m-2 badge bg-dark opacity-75"><%= p.Status %></span>
          <% } %>
        </a>
        <div class="card-body p-3 d-flex flex-column">
          <h6 class="mb-1" style="min-height:2.6em;font-size:.95rem;line-height:1.3">
            <a href="/products/<%= p.ProductID %>" class="text-dark"><%= p.ProductName %></a>
          </h6>
          <div class="price-tag mb-2"><%= Number(p.Price).toLocaleString('vi-VN') %> đ<small class="text-muted fw-normal">/ngày</small></div>
          <div class="mt-auto d-flex gap-1">
            <a href="/products/<%= p.ProductID %>" class="btn btn-sm btn-outline-primary flex-grow-1">Chi tiết</a>
            <a href="/products/<%= p.ProductID %>" class="btn btn-sm btn-primary" title="Đặt thuê"><i class="bi bi-calendar-check"></i></a>
          </div>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<!-- Phân trang -->
<% if (totalPages > 1) { %>
<nav class="d-flex justify-content-center mt-4">
  <ul class="pagination mb-0">
    <li class="page-item <%= page<=1?'disabled':'' %>"><a class="page-link" href="?page=<%= page-1 %>&type=<%= encodeURIComponent(type) %>&q=<%= q %>">«</a></li>
    <% for (let i=1;i<=totalPages;i++){ %>
      <li class="page-item <%= i===page?'active':'' %>"><a class="page-link" href="?page=<%= i %>&type=<%= encodeURIComponent(type) %>&q=<%= q %>"><%= i %></a></li>
    <% } %>
    <li class="page-item <%= page>=totalPages?'disabled':'' %>"><a class="page-link" href="?page=<%= page+1 %>&type=<%= encodeURIComponent(type) %>&q=<%= q %>">»</a></li>
  </ul>
</nav>
<% } %>
