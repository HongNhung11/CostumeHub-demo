<%
  const v = (k, d = '') => (product[k] !== undefined && product[k] !== null ? product[k] : d);
  const isEdit = !!product.ProductID;
%>
<div class="row justify-content-center">
  <div class="col-lg-8">
    <h3 class="mb-3"><i class="bi bi-pencil-square text-primary"></i> <%= title %></h3>

    <% if (errors && errors.length) { %>
      <div class="alert alert-danger">
        <strong><i class="bi bi-exclamation-triangle"></i> Chưa lưu được, vui lòng kiểm tra:</strong>
        <ul class="mb-0 mt-1"><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul>
      </div>
    <% } %>

    <div class="card">
      <div class="card-body">
        <p class="small text-muted mb-3">Các trường có dấu <span class="text-danger">*</span> là bắt buộc. Giá tính bằng đồng, từ <strong>1.000 đ</strong> trở lên và tròn nghìn.</p>
        <form method="<%= method %>" action="<%= action %>" enctype="multipart/form-data" id="productForm" novalidate>
          <input type="hidden" name="back" value="<%= typeof back !== 'undefined' ? back : '/products/manage' %>">
          <div class="row g-3">
            <div class="col-md-8">
              <label class="form-label">Tên trang phục <span class="text-danger">*</span></label>
              <input name="ProductName" class="form-control" required minlength="3" maxlength="150" value="<%= v('ProductName') %>">
              <div class="invalid-feedback">Nhập tên trang phục (ít nhất 3 ký tự).</div>
            </div>
            <div class="col-md-4">
              <label class="form-label">Loại <span class="text-danger">*</span></label>
              <select name="ProductType" class="form-select" required>
                <option value="">-- Chọn loại --</option>
                <% TYPES.forEach(t => { %>
                  <option <%= v('ProductType')===t?'selected':'' %>><%= t %></option>
                <% }) %>
              </select>
              <div class="invalid-feedback">Chọn loại trang phục.</div>
            </div>
            <div class="col-md-6">
              <label class="form-label">Size / kích thước <span class="text-danger">*</span></label>
              <input name="Size" id="sizeList" class="form-control" required maxlength="200" placeholder="VD: S, M, L — hoặc chỉ M — hoặc Ni 6, Ni 7 — Free size" value="<%= v('Size') %>">
              <div class="form-text">Chỉ ghi những size mẫu này có, cách nhau bằng dấu phẩy. Phụ kiện ghi kích thước (40cm, Ni 7...).</div>
              <div class="invalid-feedback">Nhập size / kích thước.</div>
            </div>
            <div class="col-md-6">
              <label class="form-label">Màu sắc <span class="text-danger">*</span></label>
              <input name="Color" id="colorList" class="form-control" required maxlength="200" placeholder="VD: Đỏ — hoặc Đỏ, Trắng" value="<%= v('Color') %>">
              <div class="form-text">Nhiều màu thì cách nhau bằng dấu phẩy.</div>
              <div class="invalid-feedback">Nhập màu sắc.</div>
            </div>
            <!-- Số bộ theo SIZE × MÀU: bảng tự tạo theo danh sách size / màu ở trên -->
            <div class="col-12">
              <label class="form-label">Số bộ theo size × màu <span class="text-danger">*</span>
                <span class="small text-muted fw-normal">— tổng: <strong id="gridTotal">0</strong></span></label>
              <div id="variantGrid" class="table-responsive variant-grid"></div>
              <div class="form-text">Ô nào shop không có thì để 0. Khách chỉ chọn được size × màu còn bộ.</div>
            </div>
            <div class="col-md-3">
              <label class="form-label">Đơn vị <span class="text-danger">*</span></label>
              <input name="Unit" class="form-control" required maxlength="20" value="<%= v('Unit', 'bộ') %>">
              <div class="invalid-feedback">Nhập đơn vị.</div>
            </div>
            <div class="col-md-3">
              <label class="form-label">Giá thuê / ngày <span class="text-danger">*</span></label>
              <input type="number" name="Price" class="form-control" required min="1000" step="1000" value="<%= v('Price') %>" placeholder="≥ 1.000">
              <div class="invalid-feedback">Từ 1.000 đ trở lên, tròn nghìn.</div>
            </div>
            <div class="col-md-3">
              <label class="form-label">Tiền cọc <span class="text-danger">*</span></label>
              <input type="number" name="DepositValue" class="form-control" required min="0" step="1000" value="<%= v('DepositValue') %>">
              <div class="invalid-feedback">Số ≥ 0, tròn nghìn.</div>
            </div>
            <div class="col-md-3">
              <label class="form-label">Phí phạt trễ / ngày <span class="text-danger">*</span></label>
              <input type="number" name="LateFeePerDay" class="form-control" required min="0" step="1000" value="<%= v('LateFeePerDay') %>">
              <div class="invalid-feedback">Số ≥ 0, tròn nghìn.</div>
            </div>
            <div class="col-md-3">
              <label class="form-label">Giá trị sản phẩm</label>
              <input type="number" name="ProductValue" class="form-control" min="1000" step="1000" value="<%= v('ProductValue') %>" placeholder="Không bắt buộc">
              <div class="form-text">Khách đền khi mất / hư nặng. Trống = mất cọc. <a href="/noi-quy" target="_blank">Nội quy</a></div>
              <div class="invalid-feedback">Từ 1.000 đ, tròn nghìn (hoặc để trống).</div>
            </div>
            <!-- Sale của cửa hàng (khác voucher): giảm thẳng giá thuê của mẫu này -->
            <div class="col-md-3">
              <label class="form-label">Giá khuyến mãi / ngày</label>
              <input type="number" name="SalePrice" class="form-control" min="1000" step="1000" value="<%= v('SalePrice') %>" placeholder="Không sale thì để trống">
              <div class="form-text">Thấp hơn giá thuê gốc. Khách thấy giá gốc gạch ngang + nhãn giảm %.</div>
            </div>
            <div class="col-md-3">
              <label class="form-label">Khuyến mãi đến ngày</label>
              <input type="date" name="SaleEnd" class="form-control" value="<%= v('SaleEnd') ? String(v('SaleEnd')).slice(0, 10) : '' %>">
              <div class="form-text">Trống = không hạn. Hết hạn tự về giá gốc.</div>
            </div>
            <div class="col-md-6">
              <label class="form-label">Tình trạng <span class="text-danger">*</span></label>
              <select name="Status" class="form-select" required>
                <% STATUSES.forEach(s => { %>
                  <option <%= v('Status', 'Còn trống')===s?'selected':'' %>><%= s %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label">Ảnh trang phục <% if (!isEdit || !product.PathImage) { %><span class="text-danger">*</span><% } %></label>
              <input type="file" name="image" accept="image/*" class="form-control" <%= (!isEdit || !product.PathImage) ? 'required' : '' %>>
              <div class="invalid-feedback">Chọn ảnh trang phục.</div>
              <% if (product.PathImage) { %><img src="<%= product.PathImage %>" class="mt-2 rounded" style="height:60px"><% } %>
            </div>
            <!-- Ảnh phụ: nhiều góc chụp (mặt sau, chi tiết, khi mặc...) -->
            <div class="col-12">
              <label class="form-label">Ảnh phụ <span class="small text-muted fw-normal">— không bắt buộc, tối đa <%= MAX_GALLERY %> ảnh (mặt sau, chi tiết vải, ảnh mặc thật...)</span></label>
              <input type="file" name="gallery" accept="image/*" class="form-control" multiple id="galleryInput">
              <div class="form-text" id="galleryHint">Giữ Ctrl để chọn nhiều ảnh cùng lúc.</div>
              <% if (gallery.length) { %>
                <div class="d-flex flex-wrap gap-2 mt-2">
                  <% gallery.forEach(g => { %>
                    <label class="gallery-edit">
                      <img src="<%= g.Path %>" alt="" onerror="this.style.opacity=.3">
                      <span class="small"><input type="checkbox" name="removeImages[]" value="<%= g.ImageID %>" class="form-check-input me-1">Xóa</span>
                    </label>
                  <% }) %>
                </div>
              <% } %>
            </div>
            <!-- Bảng số đo theo size: tự tạo theo danh sách size ở trên -->
            <div class="col-12">
              <label class="form-label">Bảng số đo theo size (cm) <span class="small text-muted fw-normal">— không bắt buộc, phụ kiện có thể bỏ trống</span></label>
              <div id="chartGrid" class="table-responsive"></div>
              <div class="form-text">Ghi 1 số (VD 82) hoặc khoảng (VD 80-84). Khách xem bảng này ở trang chi tiết để chọn size. <a href="#" id="fillStd">Điền số đo tham khảo cho S/M/L/XL</a></div>
            </div>
            <!-- Thông tin chi tiết (không bắt buộc) — hiện thành bảng ở trang chi tiết sản phẩm -->
            <div class="col-12"><div class="fw-semibold mt-2">Thông tin chi tiết <span class="small text-muted fw-normal">— không bắt buộc, hiện ở tab "Mô tả sản phẩm"</span></div></div>
            <% DETAIL_FIELDS.forEach(f => { %>
              <div class="<%= f.key === 'CareGuide' ? 'col-12' : 'col-md-6' %>">
                <label class="form-label"><%= f.label %></label>
                <input name="<%= f.key %>" class="form-control" maxlength="<%= f.key === 'CareGuide' ? 500 : 150 %>" placeholder="<%= f.placeholder %>" value="<%= v(f.key) %>">
              </div>
            <% }) %>
            <div class="col-12">
              <label class="form-label">Mô tả <span class="text-danger">*</span></label>
              <textarea name="Description" rows="3" class="form-control" required maxlength="2000"><%= v('Description') %></textarea>
              <div class="invalid-feedback">Nhập mô tả.</div>
            </div>
          </div>
          <div class="mt-3 d-flex gap-2">
            <button class="btn btn-primary" id="btnSave"><i class="bi bi-save"></i> Lưu <small class="opacity-75">(Alt+S)</small></button>
            <a href="<%= typeof back !== 'undefined' ? back : '/products/manage' %>" class="btn btn-secondary"><i class="bi bi-x-lg"></i> Hủy</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
// Bảng số bộ theo SIZE × MÀU: tự vẽ lại khi sửa danh sách size / màu, giữ số đã nhập
(function () {
  const sizeEl = document.getElementById('sizeList'), colorEl = document.getElementById('colorList');
  const box = document.getElementById('variantGrid'), totalEl = document.getElementById('gridTotal');
  const values = new Map(<%- JSON.stringify((grid || []).map(g => [g.Size + '|' + g.Color, g.Quantity])).replace(/</g, '\\u003c') %>);
  const list = (s) => [...new Set(s.split(/[,;]/).map(x => x.trim()).filter(Boolean))];
  const esc = (s) => s.replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  function total() {
    let t = 0;
    box.querySelectorAll('input[type=number]').forEach(i => { t += Math.max(0, parseInt(i.value) || 0); });
    totalEl.textContent = t;
    return t;
  }
  function render() {
    const sizes = list(sizeEl.value), colors = list(colorEl.value);
    if (!sizes.length || !colors.length) { box.innerHTML = '<div class="small text-muted border rounded p-2">Nhập size và màu ở trên để tạo bảng số lượng.</div>'; total(); return; }
    let h = '<table class="table table-sm table-bordered align-middle mb-0 small"><thead><tr><th>Size \\ Màu</th>' +
      colors.map(c => `<th>${esc(c)}</th>`).join('') + '</tr></thead><tbody>';
    for (const s of sizes) {
      h += `<tr><th>${esc(s)}</th>`;
      for (const c of colors) {
        const k = s + '|' + c, val = values.has(k) ? values.get(k) : (sizes.length * colors.length === 1 ? 1 : 0);
        h += `<td><input type="hidden" name="vSize[]" value="${esc(s)}"><input type="hidden" name="vColor[]" value="${esc(c)}">` +
             `<input type="number" name="vQty[]" class="form-control form-control-sm" min="0" max="999" step="1" value="${val}" data-k="${esc(k)}"></td>`;
      }
      h += '</tr>';
    }
    box.innerHTML = h + '</tbody></table>';
    total();
  }
  box.addEventListener('input', (e) => { if (e.target.dataset.k) { values.set(e.target.dataset.k, parseInt(e.target.value) || 0); total(); } });
  sizeEl.addEventListener('input', render);
  colorEl.addEventListener('input', render);
  render();
  window.__variantTotal = total;
})();

// Bảng số đo theo size: 1 dòng / size, giữ số đã nhập khi sửa danh sách size
(function () {
  const sizeEl = document.getElementById('sizeList'), box = document.getElementById('chartGrid');
  const FIELDS = <%- JSON.stringify(CHART_FIELDS).replace(/</g, '\\u003c') %>;
  const NAMES = { bust: 'scBust[]', waist: 'scWaist[]', hip: 'scHip[]', height: 'scHeight[]' };
  const STD = { XS: ['76-80','58-62','82-86','145-152'], S: ['80-84','62-66','86-90','150-158'], M: ['84-88','66-70','90-94','155-162'],
                L: ['88-92','70-74','94-98','158-165'], XL: ['92-96','74-78','98-102','160-168'], XXL: ['96-100','78-82','102-106','160-170'] };
  const data = <%- JSON.stringify(chart || {}).replace(/</g, '\\u003c') %>;
  const list = (s) => [...new Set(s.split(/[,;]/).map(x => x.trim()).filter(Boolean))];
  const esc = (s) => String(s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  function render() {
    const sizes = list(sizeEl.value);
    if (!sizes.length) { box.innerHTML = '<div class="small text-muted border rounded p-2">Nhập size ở trên để tạo bảng số đo.</div>'; return; }
    let h = '<table class="table table-sm table-bordered align-middle mb-0 small"><thead><tr><th>Size</th>' +
      FIELDS.map(f => `<th>${f.label}</th>`).join('') + '</tr></thead><tbody>';
    for (const s of sizes) {
      const row = data[s] || {};
      h += `<tr><th>${esc(s)}<input type="hidden" name="scSize[]" value="${esc(s)}"></th>` +
        FIELDS.map(f => `<td><input name="${NAMES[f.key]}" class="form-control form-control-sm" maxlength="9" placeholder="VD 80-84" value="${esc(row[f.key] || '')}" data-s="${esc(s)}" data-f="${f.key}"></td>`).join('') + '</tr>';
    }
    box.innerHTML = h + '</tbody></table>';
  }
  box.addEventListener('input', (e) => { const t = e.target; if (t.dataset.s) (data[t.dataset.s] ||= {})[t.dataset.f] = t.value; });
  document.getElementById('fillStd').addEventListener('click', (e) => {
    e.preventDefault();
    let n = 0;
    for (const s of list(sizeEl.value)) {
      const std = STD[s.toUpperCase()];
      if (!std) continue;
      data[s] = data[s] || {};
      FIELDS.forEach((f, i) => { if (!data[s][f.key]) data[s][f.key] = std[i]; });
      n++;
    }
    render();
    if (!n) alert('Chỉ điền tự động được cho size chữ (XS, S, M, L, XL, XXL).');
  });
  sizeEl.addEventListener('input', render);
  render();

  // Báo trước nếu chọn quá số ảnh phụ
  const gi = document.getElementById('galleryInput'), hint = document.getElementById('galleryHint');
  gi.addEventListener('change', () => {
    const n = gi.files.length, max = <%= MAX_GALLERY %>;
    hint.className = 'form-text' + (n > max ? ' text-danger' : '');
    hint.textContent = n > max ? `Bạn chọn ${n} ảnh — tối đa ${max} ảnh phụ.` : n ? `Đã chọn ${n} ảnh phụ.` : 'Giữ Ctrl để chọn nhiều ảnh cùng lúc.';
  });
})();

// Kiểm tra phía trình duyệt trước khi gửi (máy chủ vẫn kiểm tra lại)
(function () {
  const form = document.getElementById('productForm');
  form.addEventListener('submit', function (e) {
    form.querySelectorAll('input:not([type=file]):not([type=hidden]), textarea').forEach(el => {
      el.value = el.value.trim();
    });
    if (window.__variantTotal && window.__variantTotal() <= 0) {
      e.preventDefault();
      alert('Vui lòng nhập số bộ cho ít nhất một size × màu.');
      return;
    }
    if (!form.checkValidity()) {
      e.preventDefault();
      e.stopPropagation();
      const first = form.querySelector(':invalid');
      if (first) first.focus();
    }
    form.classList.add('was-validated');
  });
})();
</script>
