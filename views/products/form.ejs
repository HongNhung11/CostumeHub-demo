<%
  const v = (k, d = '') => (product[k] !== undefined && product[k] !== null ? product[k] : d);
  const isEdit = !!product.ProductID;
%>
<div class="row justify-content-center">
  <div class="col-lg-8">
    <h3 class="mb-3"><i class="bi bi-pencil-square text-primary"></i> <%= title %></h3>

    <% if (errors && errors.length) { %>
      <div class="alert alert-danger">
        <strong><i class="bi bi-exclamation-triangle"></i> Chưa lưu được, vui lòng kiểm tra:</strong>
        <ul class="mb-0 mt-1"><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul>
      </div>
    <% } %>

    <div class="card">
      <div class="card-body">
        <p class="small text-muted mb-3">Các trường có dấu <span class="text-danger">*</span> là bắt buộc. Giá tính bằng đồng, từ <strong>1.000 đ</strong> trở lên và tròn nghìn.</p>
        <form method="<%= method %>" action="<%= action %>" enctype="multipart/form-data" id="productForm" novalidate>
          <input type="hidden" name="back" value="<%= typeof back !== 'undefined' ? back : '/products/manage' %>">
          <div class="row g-3">
            <div class="col-md-8">
              <label class="form-label">Tên trang phục <span class="text-danger">*</span></label>
              <input name="ProductName" class="form-control" required minlength="3" maxlength="150" value="<%= v('ProductName') %>">
              <div class="invalid-feedback">Nhập tên trang phục (ít nhất 3 ký tự).</div>
            </div>
            <div class="col-md-4">
              <label class="form-label">Loại <span class="text-danger">*</span></label>
              <select name="ProductType" class="form-select" required>
                <option value="">-- Chọn loại --</option>
                <% TYPES.forEach(t => { %>
                  <option <%= v('ProductType')===t?'selected':'' %>><%= t %></option>
                <% }) %>
              </select>
              <div class="invalid-feedback">Chọn loại trang phục.</div>
            </div>
            <div class="col-md-6">
              <label class="form-label">Màu sắc <span class="text-danger">*</span></label>
              <input name="Color" class="form-control" required maxlength="100" placeholder="VD: Đỏ, Trắng" value="<%= v('Color') %>">
              <div class="form-text">Nhiều màu thì cách nhau bằng dấu phẩy.</div>
              <div class="invalid-feedback">Nhập màu sắc.</div>
            </div>
            <div class="col-md-6">
              <label class="form-label">Size <span class="text-danger">*</span></label>
              <input name="Size" class="form-control" required maxlength="100" placeholder="VD: S, M, L hoặc Free size" value="<%= v('Size') %>">
              <div class="form-text">Nhiều size thì cách nhau bằng dấu phẩy.</div>
              <div class="invalid-feedback">Nhập size.</div>
            </div>
            <div class="col-md-3">
              <label class="form-label">Số lượng <span class="text-danger">*</span></label>
              <input type="number" name="Quantity" class="form-control" required min="0" step="1" value="<%= v('Quantity', 1) %>">
              <div class="invalid-feedback">Số nguyên ≥ 0.</div>
            </div>
            <div class="col-md-3">
              <label class="form-label">Đơn vị <span class="text-danger">*</span></label>
              <input name="Unit" class="form-control" required maxlength="20" value="<%= v('Unit', 'bộ') %>">
              <div class="invalid-feedback">Nhập đơn vị.</div>
            </div>
            <div class="col-md-3">
              <label class="form-label">Giá thuê / ngày <span class="text-danger">*</span></label>
              <input type="number" name="Price" class="form-control" required min="1000" step="1000" value="<%= v('Price') %>" placeholder="≥ 1.000">
              <div class="invalid-feedback">Từ 1.000 đ trở lên, tròn nghìn.</div>
            </div>
            <div class="col-md-3">
              <label class="form-label">Tiền cọc <span class="text-danger">*</span></label>
              <input type="number" name="DepositValue" class="form-control" required min="0" step="1000" value="<%= v('DepositValue') %>">
              <div class="invalid-feedback">Số ≥ 0, tròn nghìn.</div>
            </div>
            <div class="col-md-3">
              <label class="form-label">Phí phạt trễ / ngày <span class="text-danger">*</span></label>
              <input type="number" name="LateFeePerDay" class="form-control" required min="0" step="1000" value="<%= v('LateFeePerDay') %>">
              <div class="invalid-feedback">Số ≥ 0, tròn nghìn.</div>
            </div>
            <div class="col-md-5">
              <label class="form-label">Tình trạng <span class="text-danger">*</span></label>
              <select name="Status" class="form-select" required>
                <% STATUSES.forEach(s => { %>
                  <option <%= v('Status', 'Còn trống')===s?'selected':'' %>><%= s %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label">Ảnh trang phục <% if (!isEdit || !product.PathImage) { %><span class="text-danger">*</span><% } %></label>
              <input type="file" name="image" accept="image/*" class="form-control" <%= (!isEdit || !product.PathImage) ? 'required' : '' %>>
              <div class="invalid-feedback">Chọn ảnh trang phục.</div>
              <% if (product.PathImage) { %><img src="<%= product.PathImage %>" class="mt-2 rounded" style="height:60px"><% } %>
            </div>
            <div class="col-12">
              <label class="form-label">Mô tả <span class="text-danger">*</span></label>
              <textarea name="Description" rows="3" class="form-control" required maxlength="2000"><%= v('Description') %></textarea>
              <div class="invalid-feedback">Nhập mô tả.</div>
            </div>
          </div>
          <div class="mt-3 d-flex gap-2">
            <button class="btn btn-primary" id="btnSave"><i class="bi bi-save"></i> Lưu <small class="opacity-75">(Alt+S)</small></button>
            <a href="<%= typeof back !== 'undefined' ? back : '/products/manage' %>" class="btn btn-secondary"><i class="bi bi-x-lg"></i> Hủy</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
// Kiểm tra phía trình duyệt trước khi gửi (máy chủ vẫn kiểm tra lại)
(function () {
  const form = document.getElementById('productForm');
  form.addEventListener('submit', function (e) {
    form.querySelectorAll('input:not([type=file]):not([type=hidden]), textarea').forEach(el => {
      el.value = el.value.trim();
    });
    if (!form.checkValidity()) {
      e.preventDefault();
      e.stopPropagation();
      const first = form.querySelector(':invalid');
      if (first) first.focus();
    }
    form.classList.add('was-validated');
  });
})();
</script>
