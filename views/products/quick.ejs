<%# Nội dung khung XEM NHANH (không kèm layout, chèn vào modal ở trang cửa hàng) — bố cục giống Hizu %>
<%
  const vnd = n => Number(n || 0).toLocaleString('vi-VN') + '₫';
  const canRent = product.Status === 'Còn trống' && combos.length > 0;
  const hasSize = s => combos.some(c => c[0] === s), hasColor = c => combos.some(x => x[1] === c);
  const onlySize = sizes.length === 1 ? sizes[0] : null, onlyColor = colors.length === 1 ? colors[0] : null;
%>
<div class="row g-4 qv">
  <div class="col-md-6">
    <div class="qv-main-wrap">
      <% if (images.length) { %><img src="<%= images[0] %>" alt="<%= product.ProductName %>" class="qv-main" onerror="this.style.opacity=.2"><% } %>
    </div>
    <% if (images.length > 1) { %>
      <div class="d-flex gap-2 mt-2 flex-wrap">
        <% images.forEach((src, i) => { %><button type="button" class="qv-thumb <%= i ? '' : 'active' %>" data-src="<%= src %>"><img src="<%= src %>" alt=""></button><% }) %>
      </div>
    <% } %>
  </div>
  <div class="col-md-6">
    <h2 class="qv-title"><%= product.ProductName %></h2>
    <div class="qv-meta">
      Mã sản phẩm: <strong>#<%= product.ProductID %></strong><span class="sep">|</span>Tình trạng: <strong><%= canRent ? 'Còn hàng' : product.Status %></strong><span class="sep">|</span>Loại: <strong><%= product.ProductType %></strong>
    </div>
    <% if (summary.count) { %><div class="mt-1"><%- include('../partials/stars', { value: summary.avg }) %> <span class="text-muted">(<%= summary.count %> đánh giá)</span></div><% } %>

    <form method="POST" action="/cart/add" id="qvForm" class="mt-3">
      <input type="hidden" name="ProductID" value="<%= product.ProductID %>">
      <div class="qv-row"><div class="qv-lbl">Giá thuê:</div><div class="qv-price"><%= vnd(product.Price) %> <small>/ ngày</small></div></div>
      <div class="qv-row"><div class="qv-lbl">Giá cọc:</div><div class="qv-val"><%= vnd(product.DepositValue) %></div></div>

      <div class="qv-row">
        <div class="qv-lbl">Kích thước:</div>
        <div class="d-flex flex-wrap gap-2">
          <% sizes.forEach((s, i) => { const off = !hasSize(s); %>
            <input type="radio" class="btn-check" name="Size" id="qs<%= i %>" value="<%= s %>" <%= off ? 'disabled' : '' %> <%= onlySize && !off ? 'checked' : '' %> required>
            <label class="qv-opt <%= off ? 'opt-off' : '' %>" for="qs<%= i %>"><%= s %></label>
          <% }) %>
        </div>
      </div>
      <div class="qv-row">
        <div class="qv-lbl">Màu sắc:<div class="qv-color-name" id="qvColorName"><%= onlyColor || '' %></div></div>
        <div class="d-flex flex-wrap gap-2">
          <% colors.forEach((c, i) => { const off = !hasColor(c); %>
            <input type="radio" class="btn-check" name="Color" id="qc<%= i %>" value="<%= c %>" <%= off ? 'disabled' : '' %> <%= onlyColor && !off ? 'checked' : '' %> required>
            <label class="qv-opt color-pill <%= off ? 'opt-off' : '' %>" for="qc<%= i %>"><span class="color-dot" style="background:<%= colorHex(c) %>"></span><%= c %></label>
          <% }) %>
        </div>
      </div>
      <div class="qv-row">
        <div class="qv-lbl">Số lượng:</div>
        <div class="qty-box">
          <button type="button" data-d="-1" aria-label="Giảm">−</button>
          <input type="number" name="Quantity" value="1" min="1" step="1">
          <button type="button" data-d="1" aria-label="Tăng">+</button>
        </div>
      </div>
      <div class="qv-msg text-danger small mb-2" hidden>Vui lòng chọn kích thước và màu sắc.</div>
      <% if (canRent) { %>
        <button class="btn qv-add w-100">THÊM VÀO GIỎ</button>
      <% } else { %>
        <div class="alert alert-warning py-2 mb-0">Sản phẩm hiện <strong><%= product.Status %></strong>, chưa thể đặt thuê.</div>
      <% } %>
    </form>

    <div class="qv-row mt-3">
      <div class="qv-lbl">Chia sẻ:</div>
      <div class="d-flex gap-2">
        <a class="qv-share fb" target="_blank" rel="noopener" href="#" title="Facebook"><i class="bi bi-facebook"></i></a>
        <button type="button" class="qv-share link qv-copy" data-url="/products/<%= product.ProductID %>" title="Sao chép đường dẫn"><i class="bi bi-link-45deg"></i></button>
        <form method="POST" action="/favorites/<%= product.ProductID %>" class="d-inline">
          <input type="hidden" name="back" value="<%= back %>">
          <button class="qv-share heart <%= isFav ? 'on' : '' %>" title="<%= isFav ? 'Bỏ yêu thích' : 'Yêu thích' %>"><i class="bi <%= isFav ? 'bi-heart-fill' : 'bi-heart' %>"></i></button>
        </form>
      </div>
    </div>
    <a href="/products/<%= product.ProductID %>" class="qv-detail">Xem chi tiết sản phẩm <i class="bi bi-chevron-double-right"></i></a>
  </div>
</div>
<script type="application/json" id="qvCombos"><%- JSON.stringify(combos).replace(/</g, '\\u003c') %></script>
