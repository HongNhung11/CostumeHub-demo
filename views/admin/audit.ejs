<% const link = (p) => '/admin/audit?' + new URLSearchParams(Object.entries({ action, rental: rental || '', page: p }).filter(([, v]) => v)).toString(); %>
<h3 class="font-serif mb-3"><i class="bi bi-clock-history" style="color:var(--gold)"></i> Nhật ký tiền <span class="badge badge-soft"><%= count %></span></h3>
<form method="GET" action="/admin/audit" class="card p-3 mb-3">
  <div class="d-flex gap-2 flex-wrap">
    <select name="action" class="form-select form-select-sm" style="max-width:290px" aria-label="Thao tác">
      <option value="">Mọi thao tác</option>
      <% Object.entries(ACTIONS).forEach(([k, v]) => { %><option value="<%= k %>" <%= k === action ? 'selected' : '' %>><%= v %></option><% }) %>
    </select>
    <input name="rental" class="form-control form-control-sm" style="max-width:130px" inputmode="numeric" placeholder="Mã đơn" aria-label="Mã đơn" value="<%= rental || '' %>">
    <button class="btn btn-primary btn-sm">Lọc</button>
  </div>
</form>
<div class="card table-responsive">
  <table class="table align-middle mb-0">
    <thead><tr><th>Lúc</th><th>Người làm</th><th>Thao tác</th><th>Đơn</th><th class="text-end">Số tiền</th><th>Chi tiết</th></tr></thead>
    <tbody>
      <% if (!rows.length) { %><tr><td colspan="6" class="text-center text-muted py-4">Chưa có dòng nào.</td></tr><% } %>
      <% rows.forEach(l => { %>
        <tr>
          <td class="small text-nowrap"><%= new Date(l.createdAt).toLocaleString('vi-VN') %></td>
          <td><%= l.ActorName %></td>
          <td class="small"><%= ACTIONS[l.Action] || l.Action %></td>
          <td><% if (l.RentalID) { %><a href="/rentals/<%= l.RentalID %>">#<%= l.RentalID %></a><% } %></td>
          <td class="text-end text-nowrap"><%= l.Amount === null ? '' : Number(l.Amount).toLocaleString('vi-VN') + ' đ' %></td>
          <td class="small text-muted text-break" style="min-width:200px"><%= l.Detail %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% if (totalPages > 1) { %>
  <div class="d-flex gap-2 align-items-center mt-3">
    <% if (page > 1) { %><a class="btn btn-light btn-sm" href="<%= link(page - 1) %>">Trước</a><% } %>
    <span class="small text-muted">Trang <%= page %>/<%= totalPages %></span>
    <% if (page < totalPages) { %><a class="btn btn-light btn-sm" href="<%= link(page + 1) %>">Sau</a><% } %>
  </div>
<% } %>
