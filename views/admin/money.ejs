<%
  const vnd = n => Number(n || 0).toLocaleString('vi-VN') + ' đ';
  const when = d => d ? new Date(d).toLocaleString('vi-VN') : '—';
  const payments = tab === 'issues' || tab === 'all';
  const STATE = { confirmed: ['Đã khớp', 'success'], refund: ['Cần hoàn', 'warning text-dark'], review: ['Cần xem', 'danger'], unmatched: ['Không rõ đơn', 'secondary'], resolved: ['Đã xử lý', 'light text-dark'] };
  const TABS = { pending: 'Chờ hoàn / thu', done: 'Đã xong', issues: 'Giao dịch cần xử lý', all: 'Mọi tiền vào' };
%>
<h3 class="font-serif mb-3"><i class="bi bi-journal-text" style="color:var(--gold)"></i> Sổ hoàn cọc</h3>

<div class="row g-3 mb-3">
  <div class="col-md-4"><div class="card p-3 h-100"><div class="small text-muted">Shop cần hoàn khách</div><div class="fs-4 fw-bold text-danger"><%= vnd(totals.out) %></div></div></div>
  <div class="col-md-4"><div class="card p-3 h-100"><div class="small text-muted">Khách cần đền thêm</div><div class="fs-4 fw-bold text-success"><%= vnd(totals.in) %></div></div></div>
  <div class="col-md-4"><div class="card p-3 h-100"><div class="small text-muted">Giao dịch cần xử lý</div><div class="fs-4 fw-bold"><%= totals.issues %></div></div></div>
</div>

<div class="card p-3 mb-3 small">
  <% if (SEPAY.enabled) { %>
    <div><span class="badge bg-<%= SEPAY.mode === 'live' ? 'success' : 'info' %>"><%= SEPAY.mode === 'live' ? 'Tiền thật' : 'Test mode' %></span>
      Nhận vào <strong><%= SEPAY.bank.name %> · <%= SEPAY.receiveAccount %> · <%= SEPAY.owner %></strong></div>
    <div class="text-muted text-break mt-1">Webhook: <%= SEPAY.secret ? webhookUrl : 'chưa khai khóa' %></div>
    <div class="text-muted">Đối soát: <%= !SEPAY.token ? 'chưa khai API token' : status.lastError ? 'lỗi: ' + status.lastError : status.lastOkAt ? 'chạy tốt, lần cuối ' + when(status.lastOkAt) : 'đang chờ lượt đầu' %></div>
  <% } else { %>
    <div><span class="badge bg-secondary">Đang tắt</span> Khách chưa chọn được chuyển khoản: <%= SEPAY.problems.join('; ') %>. Điền trong file .env rồi chạy lại Docker.</div>
  <% } %>
</div>

<div class="d-flex flex-wrap gap-2 mb-3">
  <% Object.entries(TABS).forEach(([k, label]) => { %><a class="btn btn-sm <%= tab === k ? 'btn-primary' : 'btn-light' %>" href="/admin/money?tab=<%= k %>"><%= label %></a><% }) %>
</div>

<div class="card table-responsive">
  <table class="table align-middle mb-0">
    <thead><tr><th>Đơn / khách</th><th class="text-end">Số tiền</th><th><%= payments ? 'Giao dịch' : 'Lý do' %></th><th>Xử lý</th></tr></thead>
    <tbody>
      <% if (!rows.length) { %><tr><td colspan="4" class="text-center text-muted py-4">Không có khoản nào.</td></tr><% } %>
      <% rows.forEach(r => { const c = customer[r.RentalID]; %>
        <tr>
          <td>
            <% if (r.RentalID) { %><a href="/rentals/<%= r.RentalID %>">#<%= r.RentalID %></a><% } else { %>—<% } %>
            <% if (c) { %><div class="small"><%= c.CustomerName %><br><%= c.CustomerPhone %></div><% } %>
          </td>
          <% if (payments) { %>
            <td class="text-end text-nowrap fw-semibold"><%= vnd(r.Amount) %></td>
            <td class="small text-break" style="min-width:220px">
              <span class="badge bg-<%= STATE[r.State][1] %>"><%= STATE[r.State][0] %></span> <%= r.Reason %>
              <div class="text-muted"><%= when(r.PaidAt) %> · <%= r.Reference %><br><%= r.Content %></div>
            </td>
            <td>
              <% if (['review', 'unmatched'].includes(r.State)) { %>
                <form method="POST" action="/admin/money/payments/<%= r.PaymentID %>" class="d-flex gap-1 flex-wrap" style="min-width:200px">
                  <button class="btn btn-sm btn-outline-danger" name="Action" value="refund">Cần hoàn</button>
                  <button class="btn btn-sm btn-light" name="Action" value="keep" onclick="return confirm('Đã xử lý xong, không cần hoàn?')">Đã xử lý</button>
                </form>
              <% } else if (r.HandledBy) { %><span class="small text-muted"><%= r.HandledBy %></span><% } %>
            </td>
          <% } else { %>
            <td class="text-end text-nowrap fw-semibold text-<%= r.Direction === 'out' ? 'danger' : 'success' %>"><%= r.Direction === 'out' ? 'Hoàn' : 'Thu' %> <%= vnd(r.Amount) %></td>
            <td class="small" style="min-width:180px"><%= r.Reason %><div class="text-muted"><%= when(r.createdAt) %></div></td>
            <td>
              <% if (r.Status === 'pending') { %>
                <form method="POST" action="/admin/money/ledger/<%= r.EntryID %>" class="d-flex gap-1 flex-wrap" style="min-width:230px">
                  <select name="Method" class="form-select form-select-sm" style="width:auto" aria-label="Cách thanh toán"><% METHODS.forEach(m => { %><option><%= m %></option><% }) %></select>
                  <input name="Reference" class="form-control form-control-sm" style="width:130px" maxlength="100" placeholder="Mã giao dịch" aria-label="Mã giao dịch">
                  <button class="btn btn-sm btn-success" onclick="return confirm('Đã <%= r.Direction === 'out' ? 'hoàn' : 'thu' %> <%= vnd(r.Amount) %>?')">Xong</button>
                </form>
              <% } else { %>
                <span class="small"><%= r.Method %> <%= r.Reference %><br><span class="text-muted"><%= r.DoneBy %> · <%= when(r.DoneAt) %></span></span>
              <% } %>
            </td>
          <% } %>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% if (totalPages > 1) { %>
  <ul class="pagination pagination-sm mt-3"><% for (let i = 1; i <= totalPages; i++) { %><li class="page-item <%= i === page ? 'active' : '' %>"><a class="page-link" href="/admin/money?tab=<%= tab %>&page=<%= i %>"><%= i %></a></li><% } %></ul>
<% } %>
