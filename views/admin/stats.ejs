<%
  const vnd = n => Number(n||0).toLocaleString('vi-VN') + ' đ';
  const short = n => n >= 1e9 ? (n/1e9).toFixed(1).replace('.0','') + ' tỷ' : n >= 1e6 ? (n/1e6).toFixed(1).replace('.0','') + ' tr' : n >= 1e3 ? Math.round(n/1e3) + 'k' : String(n);
  const maxM = Math.max(0, ...months.map(m => m.total));
  // Mốc trục: làm tròn lên để có 4 vạch đẹp
  const step = (() => { if (!maxM) return 1; const raw = maxM / 4; const p = Math.pow(10, Math.floor(Math.log10(raw))); return [1,2,2.5,5,10].map(k => k*p).find(v => v >= raw); })();
  const axisMax = step * 4;
  const peak = months.reduce((a, m) => m.total > a.total ? m : a, months[0]);
  const maxTop = Math.max(1, ...topProducts.map(p => p.qty));
  const stCls = { 'Đã cọc': 'info', 'Đang thuê': 'warning', 'Hoàn tất': 'success', 'Đã hủy': 'danger' };
  const stIcon = { 'Đã cọc': 'bi-wallet2', 'Đang thuê': 'bi-bag-check', 'Hoàn tất': 'bi-check-circle', 'Đã hủy': 'bi-x-circle' };
%>
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <h3 class="font-serif mb-0"><i class="bi bi-bar-chart-line" style="color:var(--gold)"></i> Thống kê</h3>
  <form method="GET" action="/admin/stats" class="d-flex gap-2 align-items-center">
    <label class="small text-muted" for="year">Năm</label>
    <select name="year" id="year" class="form-select form-select-sm" style="width:auto" onchange="this.form.submit()">
      <% yearList.forEach(y => { %><option <%= y === year ? 'selected' : '' %>><%= y %></option><% }) %>
    </select>
  </form>
</div>

<!-- Số liệu chính -->
<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3"><div class="card p-3 h-100 stat-tile">
    <div class="small text-muted">Doanh thu năm <%= year %></div>
    <div class="stat-num"><%= vnd(yearTotal) %></div>
    <div class="small text-muted"><%= yearOrders %> đơn hoàn tất</div>
  </div></div>
  <div class="col-6 col-lg-3"><div class="card p-3 h-100 stat-tile">
    <div class="small text-muted"><%= curMonth ? 'Doanh thu tháng này' : 'Trung bình / đơn hoàn tất' %></div>
    <div class="stat-num"><%= curMonth ? vnd(curMonth.total) : vnd(yearOrders ? Math.round(yearTotal / yearOrders) : 0) %></div>
    <div class="small text-muted"><%= curMonth ? curMonth.orders + ' đơn hoàn tất' : 'năm ' + year %></div>
  </div></div>
  <div class="col-6 col-lg-3"><div class="card p-3 h-100 stat-tile">
    <div class="small text-muted">Đơn đang hoạt động</div>
    <div class="stat-num"><%= activeCount %></div>
    <div class="small text-muted">Đang giữ cọc <%= vnd(depositHeld) %></div>
  </div></div>
  <div class="col-6 col-lg-3"><div class="card p-3 h-100 stat-tile">
    <div class="small text-muted">Khách hàng</div>
    <div class="stat-num"><%= customers %></div>
    <div class="small text-muted"><%= totalOrders %> đơn thuê từ trước tới nay</div>
  </div></div>
</div>

<!-- Doanh thu theo tháng -->
<div class="card p-3 p-md-4 mb-4">
  <div class="d-flex justify-content-between align-items-baseline flex-wrap gap-2 mb-1">
    <h6 class="font-serif mb-0">Doanh thu theo tháng — <%= year %></h6>
    <span class="small text-muted">Tiền thuê (đã trừ mã giảm giá) + phí trễ + phí hư hỏng + phí hủy (không tính tiền cọc)</span>
  </div>
  <% if (!maxM) { %>
    <p class="text-muted text-center py-5 mb-0"><i class="bi bi-bar-chart"></i> Chưa có doanh thu trong năm <%= year %>.</p>
  <% } else { %>
  <div class="rev-chart" role="img" aria-label="Biểu đồ cột doanh thu 12 tháng năm <%= year %>, cao nhất tháng <%= peak.month %>: <%= vnd(peak.total) %>">
    <div class="rev-grid">
      <% for (let i = 4; i >= 0; i--) { %>
        <div class="rev-gridline" style="bottom:<%= i * 25 %>%"><span><%= short(step * i) %></span></div>
      <% } %>
    </div>
    <div class="rev-bars">
      <% months.forEach(m => { const h = m.total ? Math.max(1.5, m.total / axisMax * 100) : 0; %>
        <div class="rev-col" tabindex="0"
             data-tip="<%= `Tháng ${m.month}/${year}|Tổng: ${vnd(m.total)}|Tiền thuê: ${vnd(m.rent)}${m.discount ? ` (đã giảm ${vnd(m.discount)})` : ``}|Phí trễ: ${vnd(m.late)}|Phí hư hỏng: ${vnd(m.damage)}|Phí hủy: ${vnd(m.cancel)}|${m.orders} đơn hoàn tất` %>">
          <% if (m === peak) { %><div class="rev-peak"><%= short(m.total) %></div><% } %>
          <div class="rev-bar" style="height:<%= h %>%"></div>
          <div class="rev-label">T<%= m.month %></div>
        </div>
      <% }) %>
    </div>
    <div class="rev-tip" id="revTip" hidden></div>
  </div>
  <details class="mt-3">
    <summary class="small text-muted">Xem bảng số liệu</summary>
    <div class="table-responsive mt-2">
      <table class="table table-sm small mb-0">
        <thead><tr><th>Tháng</th><th class="text-end">Tiền thuê</th><th class="text-end">Phí trễ</th><th class="text-end">Phí hư hỏng</th><th class="text-end">Phí hủy</th><th class="text-end">Tổng</th><th class="text-end">Đơn hoàn tất</th></tr></thead>
        <tbody>
          <% months.forEach(m => { %>
            <tr><td><%= m.month %>/<%= year %></td><td class="text-end"><%= vnd(m.rent) %></td><td class="text-end"><%= vnd(m.late) %></td><td class="text-end"><%= vnd(m.damage) %></td><td class="text-end"><%= vnd(m.cancel) %></td><td class="text-end fw-semibold"><%= vnd(m.total) %></td><td class="text-end"><%= m.orders %></td></tr>
          <% }) %>
          <tr class="fw-bold"><td>Cả năm</td><td class="text-end"><%= vnd(months.reduce((s,m)=>s+m.rent,0)) %></td><td class="text-end"><%= vnd(months.reduce((s,m)=>s+m.late,0)) %></td><td class="text-end"><%= vnd(months.reduce((s,m)=>s+m.damage,0)) %></td><td class="text-end"><%= vnd(months.reduce((s,m)=>s+m.cancel,0)) %></td><td class="text-end"><%= vnd(yearTotal) %></td><td class="text-end"><%= yearOrders %></td></tr>
        </tbody>
      </table>
    </div>
  </details>
  <% } %>
</div>

<div class="row g-4">
  <!-- Số đơn theo trạng thái -->
  <div class="col-lg-5">
    <div class="card p-3 p-md-4 h-100">
      <h6 class="font-serif mb-3">Đơn thuê theo trạng thái <span class="small text-muted fw-normal">(tất cả)</span></h6>
      <div class="row g-2">
        <% STATUSES.forEach(s => { %>
          <div class="col-6">
            <a href="/rentals?status=<%= encodeURIComponent(s) %>" class="d-block p-3 rounded-3 border text-dark status-tile">
              <div class="small text-<%= stCls[s] === 'warning' ? 'warning-emphasis' : stCls[s] %>"><i class="bi <%= stIcon[s] %>"></i> <%= s %></div>
              <div class="fs-4 fw-bold"><%= statusCounts[s] %></div>
            </a>
          </div>
        <% }) %>
      </div>
      <% if (overdue) { %>
        <a href="/rentals?status=quahan" class="alert alert-danger py-2 small mt-3 mb-0 d-block"><i class="bi bi-exclamation-triangle-fill"></i> <strong><%= overdue %> đơn quá hạn</strong> — bấm để xem</a>
      <% } %>
    </div>
  </div>

  <!-- Mẫu được thuê nhiều nhất -->
  <div class="col-lg-7">
    <div class="card p-3 p-md-4 h-100">
      <h6 class="font-serif mb-3">Top 10 mẫu được thuê nhiều nhất <span class="small text-muted fw-normal">(theo số bộ, không tính đơn hủy)</span></h6>
      <% if (!topProducts.length) { %>
        <p class="text-muted mb-0">Chưa có lượt thuê nào.</p>
      <% } else { %>
      <table class="table table-sm align-middle mb-0 small">
        <thead><tr><th style="width:28px">#</th><th>Trang phục</th><th style="width:40%">Số bộ đã thuê</th><th class="text-end">Tiền thuê</th></tr></thead>
        <tbody>
          <% topProducts.forEach((p, i) => { %>
            <tr>
              <td class="text-muted"><%= i + 1 %></td>
              <td><% if (p.id) { %><a href="/products/<%= p.id %>" class="text-dark"><%= p.name %></a><% } else { %><%= p.name %> <span class="text-muted">(đã xóa)</span><% } %>
                <div class="text-muted"><%= p.orders %> đơn</div></td>
              <td>
                <div class="d-flex align-items-center gap-2">
                  <div class="flex-grow-1 top-track"><div class="top-bar" style="width:<%= p.qty / maxTop * 100 %>%"></div></div>
                  <span class="fw-semibold" style="min-width:2ch"><%= p.qty %></span>
                </div>
              </td>
              <td class="text-end text-nowrap"><%= vnd(p.rent) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <% } %>
    </div>
  </div>
</div>

<script>
// Tooltip khi rê chuột / focus bàn phím vào từng cột
(function () {
  const tip = document.getElementById('revTip');
  if (!tip) return;
  const chart = tip.parentElement;
  function show(col) {
    const [head, ...rows] = col.dataset.tip.split('|');
    tip.innerHTML = '<strong>' + head + '</strong>' + rows.map(r => '<div>' + r + '</div>').join('');
    tip.hidden = false;
    const c = chart.getBoundingClientRect(), b = col.getBoundingClientRect();
    let left = b.left - c.left + b.width / 2 - tip.offsetWidth / 2;
    left = Math.max(0, Math.min(left, c.width - tip.offsetWidth));
    tip.style.left = left + 'px';
  }
  chart.querySelectorAll('.rev-col').forEach(col => {
    col.addEventListener('mouseenter', () => show(col));
    col.addEventListener('focus', () => show(col));
    col.addEventListener('mouseleave', () => { tip.hidden = true; });
    col.addEventListener('blur', () => { tip.hidden = true; });
  });
})();
</script>
