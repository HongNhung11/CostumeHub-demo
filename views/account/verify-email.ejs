<div class="row justify-content-center my-md-4">
  <div class="col-md-8 col-lg-5">
    <div class="card p-4">
      <h3 class="font-serif mb-2" style="color:var(--primary)">Xác minh email</h3>
      <p class="text-muted text-break">Dùng <strong><%= email %></strong> để nhận thông báo và đặt lại mật khẩu cho tài khoản <strong><%= currentUser.username %></strong>?</p>
      <form method="POST" action="/xac-minh-email/<%= token %>">
        <button class="btn btn-primary w-100"><i class="bi bi-check2-circle"></i> Xác minh</button>
      </form>
      <a href="/account" class="small mt-3">Để sau</a>
    </div>
  </div>
</div>
