<% const roleCls = { admin: 'danger', nhanvien: 'primary', khach: 'success' }; %>
<div class="row justify-content-center">
  <div class="col-lg-8">
    <h3 class="font-serif mb-3"><i class="bi bi-person-circle" style="color:var(--gold)"></i> Tài khoản của tôi</h3>

    <div class="card p-3 p-md-4 mb-3">
      <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
          <div class="fs-5 fw-semibold"><%= user.fullName || user.username %></div>
          <div class="small text-muted">Tên đăng nhập: <code><%= user.username %></code> · Tham gia <%= new Date(user.createdAt).toLocaleDateString('vi-VN') %></div>
        </div>
        <span class="badge bg-<%= roleCls[user.role] || 'secondary' %>"><%= ROLES[user.role] || user.role %></span>
      </div>
      <div class="row g-2 mt-2 text-center">
        <div class="col-4"><div class="p-2 rounded-3" style="background:var(--cream-2)"><div class="fs-5 fw-bold"><%= stats.total %></div><div class="small text-muted">Đơn đã đặt</div></div></div>
        <div class="col-4"><div class="p-2 rounded-3" style="background:var(--cream-2)"><div class="fs-5 fw-bold"><%= stats.active %></div><div class="small text-muted">Đang hoạt động</div></div></div>
        <div class="col-4"><div class="p-2 rounded-3" style="background:var(--cream-2)"><div class="fs-5 fw-bold"><%= stats.done %></div><div class="small text-muted">Đã hoàn tất</div></div></div>
      </div>
      <a href="/rentals" class="small mt-2 d-inline-block"><i class="bi bi-receipt"></i> Xem đơn thuê của tôi</a>
    </div>

    <!-- Thông báo gần đây -->
    <div class="card mb-3" id="thong-bao">
      <div class="d-flex justify-content-between align-items-center p-3 pb-2">
        <h6 class="font-serif mb-0"><i class="bi bi-bell"></i> Thông báo gần đây <% if (unreadCount) { %><span class="badge bg-danger"><%= unreadCount %> mới</span><% } %></h6>
        <a href="/notifications" class="small">Xem tất cả</a>
      </div>
      <% if (!notifications.length) { %>
        <p class="small text-muted px-3 pb-3 mb-0">Chưa có thông báo. Bạn sẽ được nhắc khi đơn đổi trạng thái, trước ngày nhận và ngày trả đồ.</p>
      <% } else { %>
        <div class="noti-list border-top"><% notifications.forEach(n => { %><%- include('../partials/notification-item', { n }) %><% }) %></div>
      <% } %>
    </div>

    <div class="row g-3">
      <!-- Thông tin cá nhân: SĐT, email, CCCD, địa chỉ -> tự điền vào form đặt thuê -->
      <div class="col-12">
        <div class="card p-3 p-md-4" id="thong-tin">
          <h6 class="font-serif mb-3"><i class="bi bi-pencil"></i> Thông tin cá nhân</h6>
          <form method="POST" action="/account/profile" id="profileForm" novalidate>
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label small text-muted" for="pfName">Họ và tên <span class="text-danger">*</span></label>
                <input name="fullName" id="pfName" class="form-control" required minlength="2" maxlength="100" value="<%= user.fullName || '' %>">
                <div class="invalid-feedback">Họ tên 2–100 ký tự.</div>
              </div>
              <div class="col-md-6">
                <label class="form-label small text-muted" for="pfPhone">Số điện thoại <span class="text-danger">*</span></label>
                <input name="phone" id="pfPhone" type="tel" class="form-control" required inputmode="tel" placeholder="VD 0912345678" value="<%= user.phone || '' %>">
                <div class="invalid-feedback">10 số, bắt đầu bằng 03, 05, 07, 08 hoặc 09.</div>
              </div>
              <div class="col-md-6">
                <label class="form-label small text-muted" for="pfEmail">Email <span class="text-danger">*</span></label>
                <input name="email" id="pfEmail" type="email" class="form-control" required maxlength="150" value="<%= user.email || user.PendingEmail || '' %>" data-current="<%= user.email || user.PendingEmail || '' %>">
                <div class="invalid-feedback">Email không hợp lệ.</div>
                <% if (user.PendingEmail) { %><div class="small text-warning-emphasis text-break">Đang chờ xác minh: <%= user.PendingEmail %></div>
                <% } else if (user.email && user.EmailVerifiedAt) { %><div class="small text-success">Đã xác minh</div>
                <% } else if (user.email) { %><div class="small text-warning-emphasis">Chưa xác minh: chưa nhận được thư và chưa dùng được Quên mật khẩu.</div><% } %>
                <% if (mailOn && (user.PendingEmail || (user.email && !user.EmailVerifiedAt))) { %>
                  <button class="btn btn-link btn-sm p-0" formaction="/account/resend-verify" formnovalidate id="resendVerify">Gửi lại thư xác minh</button>
                <% } %>
              </div>
              <div class="col-md-6" id="pfPassBox" hidden>
                <label class="form-label small text-muted" for="pfPass">Mật khẩu hiện tại (bắt buộc khi đổi email) <span class="text-danger">*</span></label>
                <input name="currentPassword" id="pfPass" type="password" class="form-control" autocomplete="current-password" maxlength="100">
                <div class="invalid-feedback">Nhập mật khẩu hiện tại.</div>
              </div>
              <div class="col-md-6">
                <label class="form-label small text-muted" for="pfCCCD">Số CCCD</label>
                <input name="idCardNumber" id="pfCCCD" class="form-control" inputmode="numeric" maxlength="12" placeholder="12 chữ số" value="<%= user.idCardNumber || '' %>">
                <div class="invalid-feedback">CCCD gồm đúng 12 chữ số.</div>
              </div>
              <div class="col-12">
                <label class="form-label small text-muted" for="pfAddr">Địa chỉ</label>
                <input name="address" id="pfAddr" class="form-control" maxlength="255" placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành phố" value="<%= user.address || '' %>">
                <div class="invalid-feedback">Địa chỉ ít nhất 10 ký tự.</div>
              </div>
            </div>
            <div class="d-flex align-items-center gap-3 mt-3 flex-wrap">
              <button class="btn btn-primary"><i class="bi bi-save"></i> Lưu thông tin</button>
              <span class="small text-muted">Thông tin này được điền sẵn khi bạn đặt thuê. Tên đăng nhập <code><%= user.username %></code> không đổi được.</span>
            </div>
          </form>
          <script>
          (function () {
            const email = document.getElementById('pfEmail'), box = document.getElementById('pfPassBox'), pass = document.getElementById('pfPass');
            const sync = () => {
              const changed = email.value.trim().toLowerCase() !== email.dataset.current;
              box.hidden = !changed;
              pass.required = changed;
            };
            email.addEventListener('input', sync);
            sync();
            // nút gửi lại thư không cần qua bước kiểm tra của form thông tin
            document.getElementById('resendVerify')?.addEventListener('click', (e) => {
              e.preventDefault();
              const f = document.createElement('form');
              f.method = 'POST'; f.action = '/account/resend-verify';
              document.body.append(f); f.submit();
            });
          })();
          </script>
        </div>
      </div>
      <div class="col-md-6">
        <div class="card p-3 h-100" id="doi-mat-khau">
          <h6 class="font-serif mb-3"><i class="bi bi-key"></i> Đổi mật khẩu</h6>
          <form method="POST" action="/account/password" id="pwForm">
            <label class="form-label small text-muted">Mật khẩu hiện tại</label>
            <input type="password" name="currentPassword" class="form-control mb-2" required autocomplete="current-password">
            <label class="form-label small text-muted">Mật khẩu mới</label>
            <input type="password" name="newPassword" id="newPw" class="form-control mb-2" required minlength="6" maxlength="100" autocomplete="new-password">
            <label class="form-label small text-muted">Nhập lại mật khẩu mới</label>
            <input type="password" name="confirmPassword" id="confirmPw" class="form-control mb-3" required autocomplete="new-password">
            <button class="btn btn-outline-primary"><i class="bi bi-shield-lock"></i> Đổi mật khẩu</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
  // Báo ngay nếu nhập lại mật khẩu không khớp (máy chủ vẫn kiểm tra lại)
  (function () {
    const a = document.getElementById('newPw'), b = document.getElementById('confirmPw');
    const check = () => b.setCustomValidity(b.value && a.value !== b.value ? 'Nhập lại mật khẩu mới không khớp.' : '');
    a.addEventListener('input', check); b.addEventListener('input', check);
  })();
</script>

<script>
(function () {
  const f = document.getElementById('profileForm');
  if (!f) return;
  const phone = document.getElementById('pfPhone'), cccd = document.getElementById('pfCCCD'), addr = document.getElementById('pfAddr');
  const norm = v => { v = v.replace(/[\s.\-()]/g, ''); if (v.startsWith('+84')) v = '0' + v.slice(3); else if (/^84\d{9}$/.test(v)) v = '0' + v.slice(2); return v; };
  const check = () => {
    phone.setCustomValidity(/^0(3|5|7|8|9)\d{8}$/.test(norm(phone.value)) ? '' : 'x');
    const c = cccd.value, p = parseInt(c.slice(0, 3), 10);
    cccd.setCustomValidity(!c || (/^\d{12}$/.test(c) && p >= 1 && p <= 96) ? '' : 'x');
    addr.setCustomValidity(!addr.value.trim() || addr.value.trim().length >= 10 ? '' : 'x');
  };
  cccd.addEventListener('input', () => { cccd.value = cccd.value.replace(/\D/g, '').slice(0, 12); });
  f.addEventListener('submit', ev => { check(); if (!f.checkValidity()) { ev.preventDefault(); f.classList.add('was-validated'); } });
})();
</script>
