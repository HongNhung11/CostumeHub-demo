<!-- HERO (chia đôi + ảnh collage) -->
<section class="hero-split mb-4" id="home">
  <div class="hs-grid">
    <div class="reveal">
      <div class="eyebrow" style="letter-spacing:4px;text-transform:uppercase;font-size:.78rem;color:var(--gold);font-weight:700">Thuê trang phục nữ cao cấp</div>
      <h1>Tỏa sáng trong<br><span class="accent">từng khoảnh khắc</span></h1>
      <p class="lead">Áo dài, váy tiệc – đầm dạ hội và phụ kiện nữ. Mẫu đẹp, giá thuê hợp lý, xem lịch trống và đặt thuê chỉ trong vài phút.</p>
      <div class="d-flex gap-2 flex-wrap">
        <a href="/products" class="btn btn-gold btn-lg"><i class="bi bi-grid-3x3-gap-fill"></i> Khám phá bộ sưu tập</a>
        <a href="/contact" class="btn btn-light btn-lg"><i class="bi bi-chat-heart"></i> Tư vấn ngay</a>
      </div>
      <div class="hs-mini">
        <div><div class="n"><i class="bi bi-stars"></i></div><small class="text-muted">Giặt hấp sau mỗi lượt</small></div>
        <div><div class="n"><i class="bi bi-arrow-left-right"></i></div><small class="text-muted">Đổi size miễn phí</small></div>
        <div><div class="n"><i class="bi bi-bell"></i></div><small class="text-muted">Nhắc lịch nhận – trả</small></div>
      </div>
    </div>
    <div class="collage reveal">
      <img class="ph p-main" src="/img/vaytiec/v3.jpg" alt="Đầm dạ hội" onerror="this.style.display='none'">
      <img class="ph p-sec" src="/img/aodai/p1.jpg" alt="Áo dài" onerror="this.style.display='none'">
      <div class="chip-float c-price"><i class="bi bi-tag-fill"></i> Chỉ từ 45.000đ/ngày</div>
      <div class="chip-float c-rate"><i class="bi bi-arrow-left-right"></i> Đổi size miễn phí</div>
    </div>
  </div>
</section>

<!-- WHY US / Tin cậy — ngay dưới banner -->
<div class="row g-3 mb-4 trust-strip reveal">
  <div class="col-6 col-md-3"><div class="trust-item"><i class="bi bi-gem"></i><div><h6 class="font-serif mb-0">Trang phục cao cấp</h6><p class="small text-muted mb-0">Chất liệu đẹp, giặt sạch sau mỗi lượt thuê.</p></div></div></div>
  <div class="col-6 col-md-3"><div class="trust-item"><i class="bi bi-calendar2-check"></i><div><h6 class="font-serif mb-0">Đặt lịch dễ dàng</h6><p class="small text-muted mb-0">Chọn ngày thuê – trả, hệ thống tự kiểm tra lịch.</p></div></div></div>
  <div class="col-6 col-md-3"><div class="trust-item"><i class="bi bi-shield-check"></i><div><h6 class="font-serif mb-0">An toàn, minh bạch</h6><p class="small text-muted mb-0">Cọc rõ ràng, xác minh CCCD bằng AI (OCR).</p></div></div></div>
  <div class="col-6 col-md-3"><div class="trust-item"><i class="bi bi-robot"></i><div><h6 class="font-serif mb-0">Trợ lý AI</h6><p class="small text-muted mb-0">Gợi ý trang phục theo dịp &amp; tìm kiếm thông minh.</p></div></div></div>
</div>

<!-- CATEGORIES -->
<div class="text-center mb-4">
  <div class="section-eyebrow mb-1">Bộ sưu tập</div>
  <h2 class="section-title">Chọn theo phong cách</h2>
  <hr class="divider-gold mx-auto mt-3">
</div>
<div class="row g-3 g-md-4 mb-5 justify-content-center reveal">
  <% const cats = [
    {name:'Áo dài',   img:'/img/aodai/p10.jpg'},
    {name:'Váy tiệc', img:'/img/vaytiec/v5.jpg'},
    {name:'Phụ kiện', img:'/img/phukien/k4.jpg'}
  ]; %>
  <% cats.forEach(c => { %>
    <div class="col-6 col-md-4">
      <a href="/products?type=<%= encodeURIComponent(c.name) %>" class="d-block cat-card">
        <img src="<%= c.img %>" alt="<%= c.name %>" onerror="this.style.display='none'">
        <div class="label d-flex justify-content-between align-items-center">
          <span><%= c.name %></span><i class="bi bi-arrow-right-circle"></i>
        </div>
      </a>
    </div>
  <% }) %>
</div>

<!-- MỚI VỀ: sản phẩm tạo gần nhất (dữ liệu động từ CSDL) -->
<div class="d-flex justify-content-between align-items-end mb-4">
  <div>
    <div class="section-eyebrow mb-1">Mới về</div>
    <h2 class="section-title mb-0">Trang phục mới nhất</h2>
  </div>
  <a href="/products" class="btn btn-outline-primary">Xem tất cả <i class="bi bi-arrow-right"></i></a>
</div>
<div class="row g-3 g-md-4 mb-5">
  <% featured.forEach(p => { %><%- include('../partials/home-card', { p, rt: ratings[p.ProductID], isNew: true }) %><% }) %>
</div>

<!-- ĐƯỢC ĐÁNH GIÁ CAO: điểm trung bình từ đánh giá của khách đã thuê -->
<% if (topRated.length) { %>
<div class="d-flex justify-content-between align-items-end mb-4">
  <div>
    <div class="section-eyebrow mb-1">Khách khen nhiều</div>
    <h2 class="section-title mb-0">Được đánh giá cao</h2>
  </div>
</div>
<div class="row g-3 g-md-4 mb-5">
  <% topRated.forEach(p => { %><%- include('../partials/home-card', { p, rt: ratings[p.ProductID], isNew: false }) %><% }) %>
</div>
<% } %>

<!-- LƯU Ý & QUY ĐỊNH (phần "Quy định" — khớp tab điều hướng) -->
<div id="quy-dinh" class="card rules-card p-4 mb-5 reveal">
  <div class="text-center mb-4">
    <div class="section-eyebrow mb-1">Đọc trước khi thuê</div>
    <h2 class="section-title mb-0">Lưu ý &amp; Quy định khi thuê / thử đồ</h2>
    <hr class="divider-gold mx-auto mt-3">
  </div>
  <div class="row g-4">
    <div class="col-md-6">
      <h6 class="font-serif"><i class="bi bi-clock-history" style="color:var(--gold)"></i> Thời gian nhận &amp; trả</h6>
      <ul class="small text-muted">
        <li>Nhận đồ đúng ngày đã đặt tại cửa hàng (8:00–21:00) hoặc giao tận nơi.</li>
        <li>Trả đồ đúng hạn trong ngày trả. Trả trễ tính phí phạt theo ngày của từng sản phẩm.</li>
        <li>Nên thử đồ và kiểm tra tình trạng ngay khi nhận.</li>
      </ul>
      <h6 class="font-serif mt-3"><i class="bi bi-cash-coin" style="color:var(--gold)"></i> Cọc &amp; thanh toán</h6>
      <ul class="small text-muted">
        <li>Đặt thuê xong, đơn được giữ chỗ 24 giờ để bạn cọc (tiền mặt / chuyển khoản / ví); cửa hàng xác nhận đã nhận cọc là xong.</li>
        <li>Cọc được hoàn lại đầy đủ khi trả đồ đúng hạn, nguyên vẹn.</li>
        <li>Cần cung cấp CCCD (số + ảnh chụp) để xác minh khi thuê.</li>
      </ul>
    </div>
    <div class="col-md-6">
      <h6 class="font-serif"><i class="bi bi-exclamation-triangle" style="color:var(--gold)"></i> Sử dụng &amp; bảo quản</h6>
      <ul class="small text-muted">
        <li>Giữ gìn sản phẩm sạch sẽ, không tự ý giặt, cắt, sửa hay làm biến dạng.</li>
        <li>Tránh để dính mỹ phẩm, nước hoa, thức ăn, đồ uống lên trang phục.</li>
        <li>Không cho người khác thuê lại hoặc mang ra khỏi phạm vi đã thỏa thuận.</li>
      </ul>
    </div>
  </div>
  <h6 class="font-serif mt-2 mb-2"><i class="bi bi-shield-exclamation" style="color:var(--gold)"></i> Bảng trừ phí vào tiền cọc</h6>
  <div class="small"><%- include('../partials/fee-table') %></div>
  <div class="text-center mt-3"><a href="/noi-quy" class="btn btn-outline-primary btn-sm"><i class="bi bi-journal-text"></i> Xem đầy đủ nội quy thuê đồ</a></div>
</div>

<!-- CTA BAND -->
<div class="cta-band reveal mb-2">
  <img src="/img/vaytiec/v7.jpg" alt="" onerror="this.style.display='none'">
  <div class="ov"></div>
  <div class="in">
    <div class="section-eyebrow mb-1" style="color:var(--gold)">Sẵn sàng tỏa sáng?</div>
    <h2 class="font-serif">Đặt lịch thuê chỉ trong vài phút</h2>
    <p class="mb-3" style="color:#f0e4d4">Chọn mẫu yêu thích, chọn ngày, và để CostumeHub lo phần còn lại.</p>
    <a href="/products" class="btn btn-gold btn-lg"><i class="bi bi-calendar-check"></i> Bắt đầu đặt thuê</a>
  </div>
</div>
