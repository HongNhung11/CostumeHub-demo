<div class="row justify-content-center">
  <div class="col-md-7">
    <h3 class="mb-3"><i class="bi bi-envelope text-primary"></i> Liên hệ</h3>
    <div class="card"><div class="card-body">
      <form method="POST" action="/contact">
        <div class="mb-3"><label class="form-label">Họ tên</label><input name="name" class="form-control" required></div>
        <div class="mb-3"><label class="form-label">Email / SĐT</label><input name="contact" class="form-control" required></div>
        <div class="mb-3"><label class="form-label">Nội dung</label><textarea name="message" rows="4" class="form-control" required></textarea></div>
        <button class="btn btn-primary"><i class="bi bi-send"></i> Gửi</button>
      </form>
    </div></div>
    <div class="mt-3 text-muted">
      <p class="mb-1"><i class="bi bi-geo-alt"></i> Địa chỉ: Cửa hàng CostumeHub</p>
      <p class="mb-1"><i class="bi bi-telephone"></i> Hotline: 0123 456 789</p>
    </div>
  </div>
</div>
