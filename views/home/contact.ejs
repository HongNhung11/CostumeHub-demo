<% const v = (k) => (old && old[k]) || ''; %>
<nav class="small text-muted mb-3"><a href="/" class="text-muted">Trang chủ</a> / <span>Liên hệ</span></nav>

<div class="row g-4 justify-content-center">
  <!-- Form: để lại thông tin, nhân viên gọi lại tư vấn -->
  <div class="col-lg-7">
    <div class="card p-4">
      <h3 class="font-serif mb-1">Để lại thông tin, chúng tôi gọi lại tư vấn</h3>
      <p class="text-muted mb-4">Nhân viên CostumeHub sẽ liên hệ bạn trong giờ làm việc (8:00 – 21:00).</p>
      <form method="POST" action="/contact" id="contactForm" novalidate>
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label" for="cName">Họ tên <span class="text-danger">*</span></label>
            <input name="name" id="cName" class="form-control" required minlength="2" maxlength="100" value="<%= v('name') %>">
            <div class="invalid-feedback">Vui lòng nhập họ tên.</div>
          </div>
          <div class="col-md-6">
            <label class="form-label" for="cPhone">Số điện thoại <span class="text-danger">*</span></label>
            <input name="phone" id="cPhone" type="tel" class="form-control" required inputmode="tel" placeholder="VD 0912345678" value="<%= v('phone') %>">
            <div class="invalid-feedback">10 số, bắt đầu bằng 03, 05, 07, 08 hoặc 09.</div>
          </div>
          <div class="col-md-6">
            <label class="form-label" for="cEmail">Email <span class="text-muted small">(không bắt buộc)</span></label>
            <input name="email" id="cEmail" type="email" class="form-control" maxlength="150" value="<%= v('email') %>">
            <div class="invalid-feedback">Email không hợp lệ.</div>
          </div>
          <div class="col-md-6">
            <label class="form-label" for="cTopic">Bạn cần tư vấn về</label>
            <select name="topic" id="cTopic" class="form-select">
              <% TOPICS.forEach(t => { %><option <%= v('topic') === t ? 'selected' : '' %>><%= t %></option><% }) %>
            </select>
          </div>
          <div class="col-12">
            <label class="form-label" for="cMsg">Nội dung <span class="text-danger">*</span></label>
            <textarea name="message" id="cMsg" rows="4" class="form-control" required minlength="5" maxlength="2000" placeholder="VD: Mình cần thuê áo dài cho lễ cưới ngày 20/12, cao 1m60, nặng 48kg..."><%= v('message') %></textarea>
            <div class="invalid-feedback">Nội dung ít nhất 5 ký tự.</div>
          </div>
        </div>
        <button class="btn btn-primary mt-4 px-4"><i class="bi bi-send"></i> Gửi yêu cầu tư vấn</button>
      </form>
    </div>
  </div>

  <!-- Thông tin cửa hàng -->
  <div class="col-lg-4">
    <div class="card p-4 contact-info">
      <h5 class="font-serif mb-3">CostumeHub</h5>
      <div class="ci-row"><i class="bi bi-geo-alt"></i><div><b>Địa chỉ</b><span>Cửa hàng CostumeHub</span></div></div>
      <div class="ci-row"><i class="bi bi-telephone"></i><div><b>Hotline</b><span><a href="tel:0123456789">0123 456 789</a></span></div></div>
      <div class="ci-row"><i class="bi bi-clock"></i><div><b>Giờ mở cửa</b><span>8:00 – 21:00 hằng ngày</span></div></div>
      <hr>
      <div class="small text-muted">Câu hỏi thường gặp về đặt thuê, tiền cọc, đổi size: <a href="/hoi-dap">xem tại đây</a>.</div>
    </div>
  </div>
</div>

<script>
(function () {
  const f = document.getElementById('contactForm'), phone = document.getElementById('cPhone');
  const norm = v => { v = v.replace(/[\s.\-()]/g, ''); if (v.startsWith('+84')) v = '0' + v.slice(3); else if (/^84\d{9}$/.test(v)) v = '0' + v.slice(2); return v; };
  const check = () => phone.setCustomValidity(/^0(3|5|7|8|9)\d{8}$/.test(norm(phone.value)) ? '' : 'invalid');
  phone.addEventListener('input', check);
  f.addEventListener('submit', ev => {
    check();
    if (!f.checkValidity()) { ev.preventDefault(); f.classList.add('was-validated'); const x = f.querySelector(':invalid'); if (x) x.focus(); }
  });
})();
</script>
