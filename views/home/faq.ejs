<%
  const vnd = n => Number(n).toLocaleString('vi-VN') + ' đ';
  // Câu trả lời lấy đúng theo quy định đang chạy trong hệ thống (nội quy, chính sách hủy, đổi size)
  const groups = [
    { title: 'Đặt thuê', icon: 'bi-bag-check', items: [
      ['Tôi có cần tạo tài khoản để thuê không?', 'Bạn xem đồ và cho vào giỏ thuê mà không cần đăng nhập. Khi bấm đặt thuê thì cần đăng nhập (đăng ký miễn phí) để theo dõi đơn, hủy đơn và đánh giá sau khi thuê.'],
      ['Thuê tối đa bao nhiêu ngày?', 'Mỗi đơn thuê từ 1 đến 30 ngày. Bộ đồ được giữ cho bạn từ ngày nhận đến hết ngày trả.'],
      ['Làm sao biết mẫu còn trống ngày tôi cần?', 'Ở trang Sản phẩm hoặc trang chi tiết, chọn ngày nhận – ngày trả: hệ thống báo "Còn N bộ" hoặc "Đã kín lịch" theo đúng size bạn chọn.'],
      ['Vì sao ngày ngay sau lượt thuê trước lại kín lịch?', 'Sau mỗi lượt thuê, cửa hàng cần 1 ngày để giặt sấy, kiểm tra đồ. Vì vậy giữa 2 lượt thuê cùng một bộ luôn cách nhau ít nhất 1 ngày.'],
      ['Giao tận nơi diễn ra thế nào?', 'Nội thành Hà Nội: shop gửi đồ trước 1 ngày, đồ đến tay bạn đúng ngày nhận. Ngoại tỉnh: shop gửi trước 3 ngày, thuê tối thiểu 3 ngày. Bạn nhận được mã vận đơn để theo dõi. Ngày trả, bạn gửi đồ lại (shipper tới lấy / gửi bưu cục) rồi nhập mã vận đơn trên trang đơn — tính trễ theo ngày bạn gửi.'],
      ['Một đơn thuê được nhiều món không?', 'Được. Thêm nhiều mẫu, nhiều size vào giỏ thuê rồi đặt một lần — tất cả dùng chung ngày nhận và ngày trả.'],
      ['Vì sao phải cung cấp CCCD?', 'Để xác minh danh tính khi giao đồ giá trị cao. Ảnh CCCD được lưu riêng tư — chỉ bạn và nhân viên cửa hàng xem được.'],
    ]},
    { title: 'Thanh toán & tiền cọc', icon: 'bi-cash-coin', items: [
      ['Tiền cọc là bao nhiêu?', 'Mỗi mẫu có mức cọc riêng, ghi ở trang chi tiết (thường khoảng 2 lần giá thuê/ngày). Tổng cọc hiện trong phần tóm tắt ở giỏ thuê trước khi đặt.'],
      ['Khi nào tôi nhận lại tiền cọc?', 'Khi trả đồ, nhân viên kiểm tra và hoàn cọc ngay sau khi trừ các khoản phí (trễ hạn, vệ sinh, hư hỏng) theo bảng nội quy. Hóa đơn ghi rõ từng khoản trừ.'],
      ['Thanh toán bằng cách nào?', 'Bạn trả 1 lần gồm tiền thuê (đã trừ giảm giá) + tiền cọc, chọn 1 trong 2 cách: thanh toán khi nhận đồ (COD — trả tại cửa hàng hoặc cho shipper), hoặc chuyển khoản trước. Tiền cọc được hoàn lại khi trả đồ.'],
      ['Đặt xong đơn có được giữ chỗ luôn không?', 'Có. Chọn COD thì đơn được giữ chỗ ngay. Chọn chuyển khoản thì đơn giữ chỗ 5 phút: bạn quét mã QR trên trang đơn, tiền về là đơn tự xác nhận và bạn nhận được thông báo. Quá 5 phút chưa nhận được tiền, đơn tự hủy (không mất phí); tiền chuyển muộn sẽ được hoàn lại.'],
      ['Tôi xem thông báo ở đâu?', 'Biểu tượng chuông trên thanh menu hoặc trang Tài khoản. Hệ thống báo khi đơn đổi trạng thái và nhắc trước ngày nhận, ngày trả đồ.'],
      ['Mã giảm giá dùng thế nào?', 'Nhập mã ở ô "Mã giảm giá" trong giỏ thuê rồi bấm Áp dụng. Mã chỉ giảm tiền thuê (không giảm cọc), mỗi khách dùng mỗi mã 1 lần. Hủy đơn thì mã được trả lại lượt.'],
    ]},
    { title: 'Size & đổi size', icon: 'bi-rulers', items: [
      ['Làm sao chọn đúng size?', 'Xem "Bảng số đo" ở trang chi tiết (vòng ngực, eo, mông, chiều cao) và đối chiếu với số đo của bạn. Nhận xét "vừa / hơi chật / hơi rộng" của khách đã thuê cũng giúp bạn chọn chính xác hơn.'],
      ['Mặc không vừa thì sao?', 'Trước khi nhận đồ, bạn tự đổi size trong trang đơn thuê, miễn phí. Sau khi nhận đồ, mang đến cửa hàng trong ngày nhận hoặc ngày hôm sau để nhân viên đổi giúp — miễn là size mới còn trống.'],
      ['Phụ kiện có size không?', 'Có, tùy món: nhẫn ghi theo ni (Ni 6, Ni 7...), vòng cổ ghi độ dài (40cm, 45cm), túi ghi Nhỏ / Lớn, còn lại là Free size.'],
    ]},
    { title: 'Hủy đơn, trả đồ & phí', icon: 'bi-arrow-repeat', items: [
      ['Hủy đơn có mất phí không?', 'Hủy từ 3 ngày trở lên trước ngày nhận: hoàn 100% cọc. Hủy trước 1–2 ngày: giữ 50% cọc. Hủy trong ngày nhận: mất cọc.'],
      ['Trả trễ thì tính thế nào?', 'Mỗi ngày trễ tính phí trễ của từng món (ghi ở trang chi tiết) × số bộ, trừ vào tiền cọc.'],
      ['Đồ bị bẩn, rách hoặc mất thì sao?', 'Tính theo bảng nội quy: bẩn nhẹ ' + vnd(FEES.DAMAGE_RULES[0].amount) + '/bộ, bẩn nặng ' + vnd(FEES.DAMAGE_RULES[1].amount) + '/bộ, sửa nhỏ ' + vnd(FEES.DAMAGE_RULES[2].amount) + '/bộ, rách cần vá ' + vnd(FEES.DAMAGE_RULES[3].amount) + '/bộ. Mất hoặc hư nặng: đền theo giá trị sản phẩm.'],
      ['Tôi có phải tự giặt đồ trước khi trả không?', 'Không. Vui lòng KHÔNG tự giặt hay ủi — cửa hàng vệ sinh chuyên dụng sau mỗi lần thuê. Chỉ tính phí khi đồ bẩn nặng như ở bảng nội quy.'],
    ]},
    { title: 'Tài khoản & đánh giá', icon: 'bi-person-heart', items: [
      ['Danh sách yêu thích dùng để làm gì?', 'Bấm hình trái tim trên ảnh trang phục để lưu mẫu, xem lại ở mục Yêu thích (biểu tượng trái tim trên thanh menu).'],
      ['Ai được viết đánh giá?', 'Chỉ khách đã thuê và trả mẫu đó (đơn hoàn tất), mỗi khách 1 đánh giá cho mỗi mẫu, kèm tối đa 3 ảnh. Bạn sửa hoặc xóa đánh giá của mình được.'],
    ]},
  ];
%>
<div class="row justify-content-center">
  <div class="col-lg-9">
    <nav class="small text-muted mb-3"><a href="/" class="text-muted">Trang chủ</a> / <span>Câu hỏi thường gặp</span></nav>
    <h2 class="font-serif mb-1">Câu hỏi thường gặp</h2>
    <p class="text-muted">Chưa thấy câu trả lời? <a href="/contact">Gửi câu hỏi cho cửa hàng</a> hoặc gọi hotline 0123 456 789.</p>

    <input type="search" id="faqSearch" class="form-control mb-4" placeholder="Tìm câu hỏi... (VD: cọc, đổi size, hủy đơn)">
    <p class="text-muted small d-none" id="faqEmpty">Không tìm thấy câu hỏi phù hợp.</p>

    <% groups.forEach((g, gi) => { %>
      <div class="faq-group mb-4">
        <h5 class="font-serif mb-2"><i class="bi <%= g.icon %>" style="color:var(--gold)"></i> <%= g.title %></h5>
        <div class="accordion" id="faq<%= gi %>">
          <% g.items.forEach(([q, a], i) => { const id = `f${gi}_${i}`; %>
            <div class="accordion-item faq-item">
              <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#<%= id %>"><%= q %></button>
              </h2>
              <div id="<%= id %>" class="accordion-collapse collapse" data-bs-parent="#faq<%= gi %>">
                <div class="accordion-body small text-muted"><%= a %></div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    <% }) %>

    <div class="d-flex gap-2 flex-wrap">
      <a href="/cach-thue" class="btn btn-outline-primary"><i class="bi bi-signpost-split"></i> Cách thức thuê</a>
      <a href="/doi-size" class="btn btn-outline-primary"><i class="bi bi-arrow-left-right"></i> Chính sách đổi size</a>
      <a href="/noi-quy" class="btn btn-outline-primary"><i class="bi bi-journal-text"></i> Nội quy &amp; bảng phí</a>
    </div>
  </div>
</div>
<script>
// Tìm câu hỏi không phân biệt dấu
(function () {
  const norm = s => s.normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/đ/g, 'd').replace(/Đ/g, 'D').toLowerCase();
  const box = document.getElementById('faqSearch'), empty = document.getElementById('faqEmpty');
  box.addEventListener('input', () => {
    const q = norm(box.value.trim());
    let shown = 0;
    document.querySelectorAll('.faq-group').forEach(g => {
      let n = 0;
      g.querySelectorAll('.faq-item').forEach(it => {
        const ok = !q || norm(it.textContent).includes(q);
        it.classList.toggle('d-none', !ok);
        it.querySelector('.accordion-collapse').classList.toggle('show', !!q && ok);
        it.querySelector('.accordion-button').classList.toggle('collapsed', !(q && ok));
        if (ok) n++;
      });
      g.classList.toggle('d-none', !n);
      shown += n;
    });
    empty.classList.toggle('d-none', shown > 0);
  });
})();
</script>
