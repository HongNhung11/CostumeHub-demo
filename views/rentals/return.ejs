<%
  const vnd = n => Number(n||0).toLocaleString('vi-VN') + ' đ';
  const vi = s => s.split('-').reverse().join('/');
%>
<div class="row justify-content-center">
  <div class="col-lg-7">
    <h3 class="font-serif mb-3"><i class="bi bi-box-arrow-in-down" style="color:var(--gold)"></i> Nhận đồ trả — Đơn #<%= rental.RentalID %></h3>

    <% if (alert) { %>
      <div class="alert alert-<%= alert.level %> py-2 small"><i class="bi bi-exclamation-triangle-fill"></i> <strong><%= alert.text %></strong></div>
    <% } %>
    <div class="card p-3 mb-3">
      <% const latePerDay = rental.items.reduce((s, it) => s + Number(it.LateFeePerDay) * it.Quantity, 0); %>
      <div class="row small">
        <div class="col-6"><span class="text-muted">Khách:</span> <strong><%= rental.CustomerName %></strong></div>
        <div class="col-6"><span class="text-muted">Nhận → hạn trả:</span> <strong><%= vi(rental.StartDate) %> → <%= vi(rental.EndDate) %></strong></div>
        <div class="col-6 mt-1"><span class="text-muted">Tiền cọc:</span> <strong><%= vnd(rental.Deposit) %></strong></div>
        <div class="col-6 mt-1"><span class="text-muted">Phí trễ/ngày (cả đơn):</span> <strong><%= vnd(latePerDay) %></strong></div>
      </div>
      <div class="table-responsive">
        <table class="table table-sm small mt-2 mb-0">
          <thead><tr><th>Món cần nhận lại</th><th class="text-center">SL</th><th class="text-end">Phí trễ/ngày/bộ</th></tr></thead>
          <tbody>
            <% rental.items.forEach(it => { %>
              <tr><td><%= it.ProductName %><% if (it.Size || it.Color) { %> <span class="text-muted">(<%= [it.Size, it.Color].filter(Boolean).join(' · ') %>)</span><% } %></td>
                <td class="text-center"><%= it.Quantity %></td><td class="text-end"><%= vnd(it.LateFeePerDay) %></td></tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <% const codDue = rental.PaymentMethod === FLOW.PAY.COD && !FLOW.isPaid(rental) ? FLOW.amountDue(rental) : 0; %>
    <% if (codDue) { %>
      <div class="alert alert-warning small">
        <div class="mb-2"><strong>Chưa xác nhận thu COD <%= vnd(codDue) %>.</strong> Đã nhận tiền thì xác nhận trước. Nếu chưa thu, hệ thống không hoàn cọc và ghi khoản khách còn nợ.</div>
        <form method="POST" action="/rentals/<%= rental.RentalID %>/cod-collected" onsubmit="return confirm('Đã thật sự nhận <%= vnd(codDue) %>?')">
          <button class="btn btn-sm btn-success">Đã thu COD</button>
        </form>
      </div>
    <% } %>
    <form method="POST" action="/rentals/<%= rental.RentalID %>/return" id="returnForm" data-unpaid="<%= codDue %>" data-sent="<%= rental.ReturnSentDate || '' %>" data-due="<%= rental.EndDate %>"
          data-deposit="<%= Number(rental.Deposit) %>" data-late="<%= latePerDay %>" data-end="<%= graceEnd %>">
      <div class="card p-3 mb-3">
        <label class="form-label">Ngày trả thực tế</label>
        <input type="date" name="ReturnDate" id="ReturnDate" class="form-control" style="max-width:220px" value="<%= today %>"
               min="<%= rental.ShippedAt && rental.ShippedAt < rental.StartDate ? rental.ShippedAt : rental.StartDate %>" max="<%= today %>" required>
        <small class="text-muted">Từ ngày nhận (<%= vi(rental.StartDate) %>) đến hôm nay. Shop nhận sau ngày <%= vi(graceEnd) %> sẽ tự tính phí phạt.<% if (rental.ShipDays) { %> (Đơn giao xa: khách gửi trả ngày <%= vi(rental.EndDate) %>, cộng <%= rental.ShipDays %> ngày vận chuyển.)<% } %></small>
      </div>

      <% if (FLOW.sentPending(rental)) { %>
        <div class="card p-3 mb-3 border-warning">
          <label class="form-label" for="SentDate">Ngày khách gửi, theo vận đơn <span class="text-danger">*</span></label>
          <input type="date" name="SentDate" id="SentDate" class="form-control" style="max-width:220px" max="<%= today %>" required>
          <small class="text-muted">Khách báo gửi ngày <%= vi(rental.ReturnClaimedDate) %>, mã <%= rental.ReturnTrackingCode %>. Phí trễ tính theo ngày bạn nhập, hãy tra vận đơn.</small>
        </div>
      <% } %>
      <!-- Kiểm tra từng món theo BẢNG NỘI QUY: nhập số bộ bị ảnh hưởng (0 = không có) -->
      <div class="card p-3 mb-3">
        <div class="d-flex justify-content-between align-items-baseline flex-wrap gap-2 mb-2">
          <h6 class="font-serif mb-0"><i class="bi bi-clipboard-check"></i> Kiểm tra đồ trả — phí theo nội quy</h6>
          <a href="/noi-quy" target="_blank" class="small">Xem bảng nội quy</a>
        </div>
        <p class="small text-muted">Đồ nguyên vẹn thì để tất cả bằng 0. Nhập số bộ bị ảnh hưởng, hệ thống tự tính tiền theo mức phí của cửa hàng.</p>
        <% rental.items.forEach(it => { %>
          <div class="border rounded-3 p-2 mb-2">
            <div class="fw-semibold small mb-1"><%= it.ProductName %>
              <span class="text-muted fw-normal">(<%= [it.Size, it.Color].filter(Boolean).join(' · ') || '—' %>) × <%= it.Quantity %> bộ</span></div>
            <div class="table-responsive">
              <table class="table table-sm small align-middle mb-0">
                <tbody>
                  <% FEES.DAMAGE_RULES.forEach(r => { const unit = r.amount ?? FEES.lossAmount(it, it.Product); %>
                    <tr>
                      <td><%= r.label %></td>
                      <td class="text-end text-nowrap text-muted"><%= vnd(unit) %>/bộ<% if (!r.amount) { %><div style="font-size:.7rem"><%= Number(it.Product && it.Product.ProductValue) > 0 ? 'giá trị SP' : 'chưa có giá trị SP → mất cọc/bộ' %></div><% } %></td>
                      <td style="width:90px">
                        <input type="number" class="form-control form-control-sm fee-n" name="fee_<%= it.ItemID %>_<%= r.code %>"
                               value="0" min="0" max="<%= it.Quantity %>" step="1" data-unit="<%= unit %>">
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        <% }) %>
        <div class="row g-2 mt-1">
          <div class="col-md-4">
            <label class="form-label small text-muted">Phí khác (đ)</label>
            <input type="number" name="OtherFee" id="OtherFee" class="form-control form-control-sm" value="0" min="0" step="1000">
          </div>
          <div class="col-md-8">
            <label class="form-label small text-muted">Lý do phí khác</label>
            <input name="OtherNote" id="OtherNote" class="form-control form-control-sm" maxlength="200" placeholder="VD: mất nón lá đi kèm áo dài">
          </div>
        </div>
      </div>

      <div class="card p-3 mb-3">
        <div class="d-flex justify-content-between small py-1"><span>Tiền cọc</span><span><%= vnd(rental.Deposit) %></span></div>
        <div class="d-flex justify-content-between small py-1 text-danger"><span>Phí trễ <span id="lateDays" class="text-muted"></span></span><span id="sumLate">0 đ</span></div>
        <div class="d-flex justify-content-between small py-1 text-danger"><span>Phí vệ sinh / hư hỏng</span><span id="sumDamage">0 đ</span></div>
        <% if (codDue) { %><div class="d-flex justify-content-between small py-1 text-danger"><span>COD chưa thu (thuê + cọc)</span><span>− <%= vnd(codDue) %></span></div><% } %>
        <hr class="my-1">
        <div class="d-flex justify-content-between fw-bold py-1"><span id="refundLabel">Hoàn cọc cho khách</span><span id="sumRefund"></span></div>
      </div>

      <button class="btn btn-success"><i class="bi bi-check2-circle"></i> Xác nhận nhận trả<%= codDue ? '' : ' & hoàn cọc' %></button>
      <a href="/rentals" class="btn btn-light">Hủy</a>
    </form>

    <script>
    // Tính tạm ngay trên trang (máy chủ tính lại khi lưu)
    (function () {
      const f = document.getElementById('returnForm');
      const dep = +f.dataset.deposit, latePer = +f.dataset.late, end = f.dataset.end;
      const vnd = n => n.toLocaleString('vi-VN') + ' đ';
      const rd = document.getElementById('ReturnDate'), other = document.getElementById('OtherFee'), note = document.getElementById('OtherNote');
      function calc() {
        const sentInput = document.getElementById('SentDate'), sent = sentInput ? sentInput.value : f.dataset.sent;   // có ngày gửi -> so với hạn trả
        const days = Math.max(0, Math.round((new Date(sent || rd.value) - new Date(sent ? f.dataset.due : end)) / 86400000)) || 0;
        const late = days * latePer;
        let dmg = Math.max(0, +other.value || 0);
        f.querySelectorAll('.fee-n').forEach(i => { dmg += Math.max(0, +i.value || 0) * +i.dataset.unit; });
        const refund = dep - late - dmg - (+f.dataset.unpaid || 0);
        document.getElementById('lateDays').textContent = days ? `(${days} ngày)` : '';
        document.getElementById('sumLate').textContent = '− ' + vnd(late);
        document.getElementById('sumDamage').textContent = '− ' + vnd(dmg);
        document.getElementById('refundLabel').textContent = refund >= 0 ? 'Hoàn cọc cho khách' : 'Khách cần trả thêm';
        const s = document.getElementById('sumRefund');
        s.textContent = vnd(Math.abs(refund));
        s.className = refund >= 0 ? 'text-success' : 'text-danger';
        note.required = (+other.value || 0) > 0;
      }
      f.addEventListener('input', calc);
      calc();
    })();
    </script>
  </div>
</div>
