<%
  const vnd = n => Number(n||0).toLocaleString('vi-VN') + ' đ';
  const stCls = s => FLOW.cls(s);
  const vi = s => s ? s.split('-').reverse().join('/') : '';
  const link = (o) => {
    const p = new URLSearchParams();
    const st = o.status !== undefined ? o.status : status;
    const qq = o.q !== undefined ? o.q : q;
    if (st) p.set('status', st);
    if (qq) p.set('q', qq);
    if (o.page && o.page > 1) p.set('page', o.page);
    const s = p.toString();
    return '/rentals' + (s ? '?' + s : '');
  };
  const tabs = [['', 'Tất cả', counts.all], ...STATUS_TABS.map(s => [s, FLOW.label(s), counts[s]]), ['quahan', 'Quá hạn', counts.overdue]];
%>
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <h3 class="font-serif mb-0"><i class="bi bi-receipt" style="color:var(--gold)"></i> <%= isStaff ? 'Quản lý đơn thuê' : 'Đơn thuê của tôi' %>
    <span class="badge badge-soft"><%= counts.all %></span>
  </h3>
  <div class="d-flex gap-2">
    <% if (isStaff) { %><a href="/rentals/today" class="btn btn-primary btn-sm"><i class="bi bi-list-check"></i> Việc hôm nay</a><% } %>
    <a href="/products" class="btn btn-outline-primary btn-sm"><i class="bi bi-plus"></i> Thuê thêm</a>
  </div>
</div>

<% if (counts.overdue) { %>
  <div class="alert alert-danger d-flex justify-content-between align-items-center flex-wrap gap-2 py-2">
    <span><i class="bi bi-exclamation-triangle-fill"></i>
      <strong><%= counts.overdue %> đơn quá hạn</strong> — <%= isStaff ? 'khách chưa trả đồ hoặc chưa đến nhận đồ đúng hẹn.' : 'vui lòng trả đồ / đến nhận đồ sớm để tránh phát sinh phí.' %></span>
    <% if (status !== 'quahan') { %><a href="<%= link({ status: 'quahan', page: 1 }) %>" class="btn btn-sm btn-light">Xem các đơn quá hạn</a><% } %>
  </div>
<% } %>

<!-- Tìm kiếm + lọc trạng thái -->
<div class="card p-3 mb-3">
  <form method="GET" action="/rentals" class="d-flex gap-2 mb-2 flex-wrap">
    <% if (status) { %><input type="hidden" name="status" value="<%= status %>"><% } %>
    <input type="search" name="q" value="<%= q %>" class="form-control" style="max-width:420px"
           placeholder="<%= isStaff ? 'Tìm theo mã đơn, tên khách, SĐT, tên trang phục...' : 'Tìm theo mã đơn, tên trang phục...' %>">
    <button class="btn btn-primary"><i class="bi bi-search"></i> Tìm</button>
    <% if (q || status) { %><a href="/rentals" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i> Bỏ lọc</a><% } %>
  </form>
  <div class="d-flex flex-wrap gap-1">
    <% tabs.forEach(([val, label, n]) => { %>
      <a href="<%= link({ status: val, page: 1 }) %>"
         class="btn btn-sm <%= status === val ? (val === 'quahan' ? 'btn-danger' : 'btn-primary') : 'btn-light' %>">
        <%= label %> <span class="badge <%= status === val ? 'bg-light text-dark' : 'badge-soft' %>"><%= n %></span>
      </a>
    <% }) %>
  </div>
</div>

<div class="card table-responsive">
  <table class="table table-hover align-middle mb-0">
    <thead>
      <tr>
        <th>Mã</th><th>Trang phục</th><th>Khách</th><th>Thuê → Trả</th>
        <th class="text-end">Tiền thuê</th><th class="text-end">Cọc</th><th>Trạng thái</th><th style="width:190px">Thao tác</th>
      </tr>
    </thead>
    <tbody>
      <% if (rentals.length===0) { %>
        <tr><td colspan="8" class="text-center text-muted py-4"><%= (q || status) ? 'Không có đơn nào phù hợp.' : 'Chưa có đơn thuê nào.' %></td></tr>
      <% } %>
      <% rentals.forEach(r => { %>
        <tr class="<%= r.alert && r.alert.overdue ? (r.alert.level === 'danger' ? 'table-danger' : 'table-warning') : '' %>">
          <td><a href="/rentals/<%= r.RentalID %>">#<%= r.RentalID %></a></td>
          <td>
            <% r.items.forEach(it => { %>
              <div><strong><%= it.ProductName %></strong>
                <span class="small text-muted">× <%= it.Quantity %><% if (it.Size) { %> · <%= it.Size %><% } %><% if (it.Color) { %> · <%= it.Color %><% } %></span></div>
            <% }) %>
          </td>
          <td><%= r.CustomerName %><div class="small text-muted"><%= r.CustomerPhone %></div></td>
          <td class="small text-nowrap"><%= vi(r.StartDate) %><br><%= vi(r.EndDate) %> (<%= r.RentDays %> ngày)</td>
          <td class="text-end"><%= vnd(Number(r.RentFee) - (Number(r.Discount) || 0)) %><% if (Number(r.Discount)) { %><div class="small text-success" title="Đã giảm <%= vnd(r.Discount) %>"><i class="bi bi-ticket-perforated"></i> <%= r.CouponCode %></div><% } %></td>
          <td class="text-end"><%= vnd(r.Deposit) %></td>
          <td>
            <span class="badge bg-<%= stCls(r.Status) %>"><%= FLOW.label(r.Status) %></span>
            <div class="small text-muted"><i class="bi <%= FLOW.isDelivery(r) ? 'bi-truck' : 'bi-shop' %>"></i> <%= r.PaymentMethod === FLOW.PAY.COD && !FLOW.isPaid(r) ? 'COD' : (FLOW.isPaid(r) ? 'Đã thanh toán' : 'Chưa thanh toán') %></div>
            <% if (r.alert) { %>
              <div class="small mt-1 fw-semibold text-<%= r.alert.level === 'info' ? 'primary' : r.alert.level %>">
                <i class="bi <%= r.alert.overdue ? 'bi-exclamation-triangle-fill' : 'bi-bell' %>"></i> <%= r.alert.text %>
              </div>
            <% } %>
          </td>
          <td>
            <a href="/rentals/<%= r.RentalID %>" class="btn btn-sm btn-outline-info" title="Xem"><i class="bi bi-eye"></i></a>
            <% if (isStaff && r.Status==='Chờ cọc') { %>
              <form method="POST" action="/rentals/<%= r.RentalID %>/deposit" class="d-inline" onsubmit="return confirm('Xác nhận đã nhận <%= vnd(FLOW.amountDue(r)) %> của đơn #<%= r.RentalID %>?')">
                <input type="hidden" name="back" value="<%= reqUrl %>">
                <button class="btn btn-sm btn-outline-success" title="Xác nhận đã nhận tiền"><i class="bi bi-cash-coin"></i> Nhận tiền</button>
              </form>
            <% } %>
            <% if (isStaff && r.Status==='Đã cọc' && !FLOW.isDelivery(r) && r.StartDate <= today) { %>
              <form method="POST" action="/rentals/<%= r.RentalID %>/handover" class="d-inline">
                <input type="hidden" name="back" value="<%= reqUrl %>">
                <button class="btn btn-sm btn-outline-primary" title="Khách đã lấy đồ"><i class="bi bi-box-arrow-up"></i> Giao</button>
              </form>
            <% } %>
            <% if (isStaff && r.Status==='Đã cọc' && FLOW.isDelivery(r) && FLOW.shipDay(r) <= today) { %>
              <a href="/rentals/<%= r.RentalID %>#giao-shipper" class="btn btn-sm btn-outline-primary" title="Đóng đơn, giao shipper"><i class="bi bi-truck"></i> Gửi đi</a>
            <% } %>
            <% if (isStaff && r.Status==='Đang giao') { %>
              <form method="POST" action="/rentals/<%= r.RentalID %>/delivered" class="d-inline">
                <input type="hidden" name="back" value="<%= reqUrl %>">
                <button class="btn btn-sm btn-outline-primary" title="Khách đã nhận đồ"><i class="bi bi-check2"></i> Đã nhận</button>
              </form>
            <% } %>
            <% if (isStaff && (r.Status==='Đang thuê' || r.Status==='Đang gửi trả')) { %>
              <a href="/rentals/<%= r.RentalID %>/return" class="btn btn-sm btn-outline-success" title="Nhận lại đồ"><i class="bi bi-box-arrow-in-down"></i> Nhận trả</a>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<!-- Phân trang -->
<div class="d-flex justify-content-between align-items-center flex-wrap mt-3 gap-2">
  <small class="text-muted"><%= total %> đơn<%= (q || status) ? ' phù hợp' : '' %> · Trang <%= page %>/<%= totalPages %></small>
  <% if (totalPages > 1) { %>
  <ul class="pagination pagination-sm mb-0">
    <li class="page-item <%= page<=1?'disabled':'' %>"><a class="page-link" href="<%= link({ page: page-1 }) %>">«</a></li>
    <% for (let i=1;i<=totalPages;i++){ %>
      <li class="page-item <%= i===page?'active':'' %>"><a class="page-link" href="<%= link({ page: i }) %>"><%= i %></a></li>
    <% } %>
    <li class="page-item <%= page>=totalPages?'disabled':'' %>"><a class="page-link" href="<%= link({ page: page+1 }) %>">»</a></li>
  </ul>
  <% } %>
</div>

<div class="alert alert-light border mt-3 small">
  <strong>Tự đến lấy:</strong> <span class="badge bg-secondary">Chờ thanh toán</span> → <span class="badge bg-info text-dark">Chờ giao đồ</span> → <span class="badge bg-warning text-dark">Đang thuê</span> → <span class="badge bg-success">Hoàn tất</span><br>
  <strong>Giao tận nơi:</strong> <span class="badge bg-secondary">Chờ thanh toán</span> → <span class="badge bg-info text-dark">Chờ giao đồ</span> → <span class="badge bg-primary">Đang giao</span> → <span class="badge bg-warning text-dark">Đang thuê</span> → <span class="badge bg-dark">Đang gửi trả</span> → <span class="badge bg-success">Hoàn tất</span><br>
  Thanh toán COD: bỏ qua bước "Chờ thanh toán", thu tiền khi giao đồ. Chuyển khoản: giữ chỗ 5 phút — khách bấm "Tôi đã chuyển khoản" thì chờ nhân viên xác nhận, không bấm thì tự hủy.
</div>
