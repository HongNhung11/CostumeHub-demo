<nav class="small text-muted mb-3"><a href="/" class="text-muted">Trang chủ</a> / <span>Yêu thích</span></nav>
<h3 class="font-serif mb-3"><i class="bi bi-heart-fill text-danger"></i> Danh sách yêu thích <small class="text-muted fs-6">(<%= favs.length %> mẫu)</small></h3>

<% if (!favs.length) { %>
  <div class="card p-5 text-center text-muted">
    <i class="bi bi-heart" style="font-size:2.5rem"></i>
    <p class="mt-2 mb-3">Bạn chưa thả tim mẫu nào. Bấm <i class="bi bi-heart"></i> trên ảnh trang phục để lưu lại xem sau.</p>
    <div><a href="/products" class="btn btn-primary"><i class="bi bi-bag"></i> Xem trang phục</a></div>
  </div>
<% } else { %>
  <div class="row g-2 g-md-3 prod-grid">
    <% favs.forEach(f => { const p = f.Product, rt = ratings[p.ProductID], off = p.Status !== 'Còn trống'; %>
      <div class="col-6 col-sm-4 col-lg-3 col-xl-2">
        <div class="card prod-card h-100 <%= off ? 'is-booked' : '' %>">
          <a href="/products/<%= p.ProductID %>" class="prod-thumb d-block">
            <% if (p.PathImage) { %><img src="<%= p.PathImage %>" alt="<%= p.ProductName %>" onerror="this.style.display='none'"><% } %>
            <span class="prod-badge chip"><%= p.ProductType %></span>
            <% if (off) { %><span class="position-absolute bottom-0 start-0 m-2 badge bg-secondary"><%= p.Status %></span><% } %>
          </a>
          <form method="POST" action="/favorites/<%= p.ProductID %>" class="fav-form">
            <input type="hidden" name="back" value="/favorites">
            <button class="fav-btn on" title="Bỏ yêu thích" aria-label="Bỏ yêu thích"><i class="bi bi-heart-fill"></i></button>
          </form>
          <div class="card-body p-3 d-flex flex-column">
            <h6 class="mb-1" style="min-height:2.6em;font-size:.95rem;line-height:1.3"><a href="/products/<%= p.ProductID %>" class="text-dark"><%= p.ProductName %></a></h6>
            <div class="price-tag mb-1"><%= priceOf(p).toLocaleString('vi-VN') %>₫<small class="text-muted fw-normal">/ngày</small><% if (saleOf(p) !== null) { %> <s class="old-price"><%= Number(p.Price).toLocaleString('vi-VN') %>₫</s><% } %></div>
            <div class="small mb-2" style="min-height:1.3em"><% if (rt) { %><i class="bi bi-star-fill text-warning"></i> <%= rt.avg %> <span class="text-muted">(<%= rt.count %>)</span><% } %></div>
            <div class="small text-muted mb-2">Đã lưu <%= new Date(f.createdAt).toLocaleDateString('vi-VN') %></div>
            <a href="/products/<%= p.ProductID %>" class="btn btn-sm btn-primary mt-auto"><i class="bi bi-calendar-check"></i> Chọn size &amp; thuê</a>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>
