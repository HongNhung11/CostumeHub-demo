<!-- Cột ảnh bên trái trang đăng nhập / đăng ký -->
<div class="col-md-5 d-none d-md-block">
  <div class="auth-side h-100" style="--auth-img:url('<%= img %>')">
    <div class="section-eyebrow mb-2" style="color:var(--gold)">CostumeHub</div>
    <h2 class="font-serif mb-3"><%= heading %></h2>
    <ul class="list-unstyled small mb-0" style="color:#efe6d9">
      <li><i class="bi bi-calendar2-check me-2" style="color:var(--gold)"></i>Xem lịch trống theo ngày, đặt nhiều món một lần</li>
      <li><i class="bi bi-ticket-perforated me-2" style="color:var(--gold)"></i>Mã giảm giá cho đơn đầu tiên</li>
      <li><i class="bi bi-arrow-left-right me-2" style="color:var(--gold)"></i>Đổi size miễn phí khi không vừa</li>
      <li><i class="bi bi-bell me-2" style="color:var(--gold)"></i>Nhắc ngày nhận, ngày trả đồ</li>
    </ul>
  </div>
</div>
