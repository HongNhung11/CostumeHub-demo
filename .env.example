# ====== CẤU HÌNH COSTUMEHUB ======
# Tạo file .env:  node scripts/setup-env.js
# Sửa .env xong:  docker compose up -d
# KHÔNG commit / gửi file .env cho người khác.

APP_PORT=3001
# 127.0.0.1 = chỉ máy này. 0.0.0.0 = máy khác trong mạng truy cập được
APP_BIND=127.0.0.1
# Địa chỉ web, dùng cho liên kết trong email
APP_URL=http://localhost:3001
# Sau Cloudflare Tunnel / Nginx thì đặt 1
TRUST_PROXY=0

SESSION_SECRET=
DB_PASSWORD=
# Chạy không Docker: DB_DIALECT=sqlite
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=costumehub
DB_USER=postgres
SQLITE_STORAGE=./data/costumehub.sqlite

# Hiện các tài khoản mẫu ở trang đăng nhập (chỉ khi demo, TẮT khi nhận tiền thật)
SHOW_DEMO_ACCOUNTS=false

# ====== CHUYỂN KHOẢN TỰ ĐỘNG (SePay) ======
# off = tắt | sandbox = Test mode, không có tiền thật | live = tiền thật
SEPAY_MODE=off
# Ngân hàng: mã trong config/banks.json (MB, VCB, ACB, BIDV, TPB...)
SEPAY_BANK=
SEPAY_ACCOUNT=
# Chỉ điền nếu ngân hàng bắt buộc nhận qua tài khoản ảo (VA)
SEPAY_VA=
SEPAY_ACCOUNT_NAME=
# my.sepay.vn -> API Access. Có token là chạy được ở localhost, không cần tên miền
SEPAY_API_TOKEN=
# my.sepay.vn -> Webhooks, xác thực HMAC-SHA256. Cần địa chỉ HTTPS công khai: <APP_URL>/webhooks/sepay
SEPAY_WEBHOOK_SECRET=

# ====== EMAIL (Gmail: dùng Mật khẩu ứng dụng) ======
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ====== LƯU TRỮ ======
IDCARD_KEEP_DAYS=30
BACKUP_KEEP_DAYS=14
