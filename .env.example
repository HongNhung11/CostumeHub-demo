# ====== CẤU HÌNH ỨNG DỤNG ======
PORT=3000
SESSION_SECRET=costumehub_secret_key_doi_thanh_chuoi_bi_mat

# ====== CẤU HÌNH CƠ SỞ DỮ LIỆU ======
# DB_DIALECT = postgres  -> dùng PostgreSQL (khi chạy thật / Docker)
# DB_DIALECT = sqlite    -> dùng file SQLite (chạy nhanh để xem thử, không cần cài DB)
DB_DIALECT=postgres

# --- Thông số cho PostgreSQL (khớp với docker-compose.yml) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=costumehub
DB_USER=postgres
DB_PASSWORD=postgres

# --- Dùng cho SQLite ---
SQLITE_STORAGE=./data/costumehub.sqlite
